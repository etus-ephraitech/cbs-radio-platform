#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.appTimezone = 'Africa/Kampala'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = cbs_radio_platform
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# API STARTER KIT - AUTH
#--------------------------------------------------------------------
# Token lifetime in minutes
auth.accessTokenTTL = 1440
auth.refreshTokenTTL = 20160

#--------------------------------------------------------------------
# MOBILE MONEY (single provider, Phase 1 — confirm MTN or Airtel with CBS)
#--------------------------------------------------------------------
momo.provider =
momo.baseUrl =
momo.apiKey =
momo.apiSecret =
momo.callbackUrl = 'http://localhost:8080/payments/callback'
# Shared-secret placeholder for verifying the callback request until the
# confirmed provider's real signature-verification method is implemented
# in PaymentController::callback() — see that method's docblock.
momo.callbackToken =

#--------------------------------------------------------------------
# SMS GATEWAY (confirmations on submission / on-air status)
#--------------------------------------------------------------------
sms.provider =
sms.apiKey =
sms.username =
sms.senderId = 'CBSRADIO'

#--------------------------------------------------------------------
# EMAIL (confirmations on submission / on-air status, if enabled —
# see notifications.emailEnabled below)
#--------------------------------------------------------------------
email.fromEmail = 'no-reply@cbsradio.ug'
email.fromName = 'CBS Radio'
email.protocol = 'smtp'
email.SMTPHost =
email.SMTPUser =
email.SMTPPass =
email.SMTPPort = 587
email.SMTPCrypto = 'tls'
email.mailType = 'html'

#--------------------------------------------------------------------
# NOTIFICATION CHANNELS
# Read by Config\Notifications. SMS is on by default; email starts off
# until CBS confirms they want it alongside SMS.
#--------------------------------------------------------------------
notifications.smsEnabled = true
notifications.emailEnabled = false

#--------------------------------------------------------------------
# THIRD-PARTY GIFT VENDORS
# Each vendor is registered in the database (Admin > Gift Vendors), but
# its API key always lives here, never in the database. The key name is
# built from the vendor's slug (auto-generated from its name):
#   vendor.{slug}.apiKey = ...
# Example, for a vendor named "Fresh Blooms Uganda" (slug: fresh-blooms-uganda):
# vendor.fresh-blooms-uganda.apiKey =
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ERROR LOGGER / ALERTS (ephraitech/ci4-error-logger)
#--------------------------------------------------------------------
errorlogger.webhookUrl =

#--------------------------------------------------------------------
# VOICE NOTE UPLOADS
# Read by Config\CbsRadio — change limits here, not in code.
#--------------------------------------------------------------------
uploads.voiceNoteMinSeconds = 5
uploads.voiceNoteMaxSeconds = 30
uploads.voiceNoteMaxSizeKB = 2048
# When ffprobe (part of ffmpeg) is installed on the server, the TRUE length of every voice note is measured from
# the file and anything that isn't a playable audio recording (or is really a video) is refused. Without it,
# the length the browser reports is used. Recommended on production: `sudo apt install ffmpeg`.
uploads.verifyWithFfprobe = true
uploads.ffprobePath = ffprobe

#--------------------------------------------------------------------
# CONTENT LIMITS
# Read by Config\CbsRadio.
#--------------------------------------------------------------------
content.messageMaxLength = 500
content.recipientNameMaxLength = 150
# Words per minute, only for the "about N seconds on air" hint under the message box.
content.readingWordsPerMinute = 150

#--------------------------------------------------------------------
# SCHEDULING
# Read by Config\CbsRadio.
#--------------------------------------------------------------------
scheduling.defaultSlotCapacity = 20

#--------------------------------------------------------------------
# MODERATION (optional, comma-separated)
# Read by Config\CbsRadio — terms that auto-flag a booking for priority
# review. Owned by CBS's editorial team, not hardcoded in the codebase.
# Example: moderation.flagTerms = "word1,word2,phrase three"
#--------------------------------------------------------------------
moderation.flagTerms =

#--------------------------------------------------------------------
# CURRENCY
#--------------------------------------------------------------------
cbsradio.defaultCurrency = UGX

#--------------------------------------------------------------------
# ADMIN SCREENS
# Read by Config\CbsRadio — rows per page on paginated admin lists.
#--------------------------------------------------------------------
admin.pageSize = 25

#--------------------------------------------------------------------
# ADMIN-EDITABLE SETTINGS  (Admin > Settings)
#
# Most operational values — payment mode, notification channels and
# wording, upload and message limits, contact details, the SMS sender
# name — can be changed by staff in the admin area without touching this
# file. Precedence, highest first:
#
#     a value saved under Admin > Settings
#     the value in this file
#     the default in the code
#
# So the keys above and below are *starting values*; once an admin saves
# a different one, that wins. "Reset to default" in the admin removes it.
#
# Secrets are the opposite: they are never editable in the admin and must
# stay here — momo.apiKey, momo.apiSecret, momo.callbackToken, sms.apiKey,
# email.SMTPPass and every vendor.{slug}.apiKey.
#--------------------------------------------------------------------

# 'manual' (staff confirm each payment) or 'mobile_money' (online).
# Manual is the safe starting point until the provider is confirmed.
payments.mode = manual
payments.merchantCode =

general.contactPhone =
general.contactEmail =

# Leave empty to use email.fromEmail / email.fromName above.
notifications.emailFromAddress =
notifications.emailFromName =

# --------------------------------------------------------------------
# Automated tests (composer test)
# --------------------------------------------------------------------
# A database used for NOTHING ELSE: the test suite empties this project's tables before every test.
# Create it once:   CREATE DATABASE cbs_radio_platform_test CHARACTER SET utf8mb4;
# The driver (MySQLi) and the empty table prefix are set in phpunit.xml.dist, so only these are needed.
# The tests also need ffmpeg installed (it provides ffprobe) to measure real audio.
database.tests.hostname = 127.0.0.1
database.tests.database = cbs_radio_platform_test
database.tests.username = root
database.tests.password =
database.tests.port = 3306

#--------------------------------------------------------------------
# UI VERSION
# Names a folder under app/Views holding a themed version of some screens
# (v1 = the admin dashboard theme). Screens the folder doesn't have, and
# every screen when this is empty, use the original views in app/Views.
#--------------------------------------------------------------------
ui_version = v1

#--------------------------------------------------------------------
# ENVIRONMENT LABEL
# Set on any copy that is not the live site (e.g. Staging): every page then
# shows a striped "STAGING" bar and the public pages ask search engines not to
# index them. Leave empty on the live site.
#--------------------------------------------------------------------
app.environmentLabel =
