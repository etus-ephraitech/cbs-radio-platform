#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.appTimezone = 'Africa/Kampala'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = cbs_radio_platform
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# API STARTER KIT - AUTH
#--------------------------------------------------------------------
# Token lifetime in minutes
auth.accessTokenTTL = 1440
auth.refreshTokenTTL = 20160

#--------------------------------------------------------------------
# MOBILE MONEY (single provider, Phase 1 — confirm MTN or Airtel with CBS)
#--------------------------------------------------------------------
momo.provider =
momo.baseUrl =
momo.apiKey =
momo.apiSecret =
momo.callbackUrl = 'http://localhost:8080/payments/callback'

#--------------------------------------------------------------------
# SMS GATEWAY (confirmations on submission / on-air status)
#--------------------------------------------------------------------
sms.provider =
sms.apiKey =
sms.senderId = 'CBSRADIO'

#--------------------------------------------------------------------
# ERROR LOGGER / ALERTS (ephraitech/ci4-error-logger)
#--------------------------------------------------------------------
errorlogger.webhookUrl =

#--------------------------------------------------------------------
# VOICE NOTE UPLOADS
#--------------------------------------------------------------------
uploads.voiceNoteMaxSeconds = 30
uploads.voiceNoteMaxSizeKB = 2048
uploads.voiceNotePath = writable/voice-notes
