# Environment
.env

# Dependencies
/vendor/
/node_modules/

# CodeIgniter 4 writable directory
/writable/cache/*
!/writable/cache/index.html
/writable/logs/*
!/writable/logs/index.html
/writable/session/*
!/writable/session/index.html
/writable/uploads/*
!/writable/uploads/index.html
/writable/debugbar/*
!/writable/debugbar/index.html
/writable/voice-notes/*
!/writable/voice-notes/index.html

# Builds / archives
/build/*

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# PHPUnit
.phpunit.result.cache
/tests/_output/*
!/tests/_output/index.html

# Static analysis caches
.phpstan.cache/

# Never commit real credentials even if accidentally placed here
*.pem
*.key
!resources/**/*.key.example

# PHPUnit output (cache, logs, testdox) — regenerated on every run
/build/

# Stray environment copies and test databases: never commit them
env_old
.env.*
!.env.example
/writable/*.db
/writable/cbs_radio_platform_test

# Repository-import artifacts (see HISTORY.md); kept locally, not in the repo
*.mbox
*.bundle
