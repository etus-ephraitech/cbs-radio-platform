+    public function testAFlashedMessageShowsAsABannerAndWithoutOneThereIsNone(): void
+    {
+        $withMessage = $this->withSession(['toastr_error' => 'Something went wrong.', '__ci_vars' => ['toastr_error' => 'new']])->get('/')->getBody();
+
+        $this->assertStringContainsString('cbs-notice--error', $withMessage);
+        $this->assertStringContainsString('Something went wrong.', $withMessage);
+
+        $this->assertStringNotContainsString('<div class="cbs-notice', $this->withSession([])->get('/')->getBody());
+    }
+}
diff --git a/tests/feature/PaymentCallbackTest.php b/tests/feature/PaymentCallbackTest.php
new file mode 100644
index 0000000..bc9e19f
--- /dev/null
+++ b/tests/feature/PaymentCallbackTest.php
@@ -0,0 +1,174 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\BookingModel;
+use App\Models\PaymentModel;
+use CodeIgniter\Exceptions\PageNotFoundException;
+use Tests\Support\Concerns\SetsEnvironment;
+use Tests\Support\TestCase\AppFeatureTestCase;
+
+/**
+ * The address a Mobile Money provider calls to say a payment succeeded or failed. It is public (the provider has
+ * no login), so the only thing keeping a stranger from marking bookings paid is the secret token in the address.
+ *
+ * @internal
+ */
+final class PaymentCallbackTest extends AppFeatureTestCase
+{
+    use SetsEnvironment;
+
+    private const TOKEN = 'a-long-random-callback-token';
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->silenceNotifications();
+        $this->setEnv('momo.callbackToken', self::TOKEN);
+    }
+
+    /**
+     * @param array<string, mixed> $payload
+     */
+    private function providerCalls(array $payload, ?string $token = self::TOKEN): \CodeIgniter\Test\TestResponse
+    {
+        $uri = 'payments/callback' . ($token !== null ? '?token=' . urlencode($token) : '');
+
+        return $this->withBodyFormat('json')->post($uri, $payload);
+    }
+
+    /**
+     * @return array{booking: array, payment: array}
+     */
+    private function pendingPayment(string $reference = 'REF-1'): array
+    {
+        $booking = $this->makeBooking();
+        $payment = $this->makePayment(['booking_id' => $booking['id'], 'provider' => 'mtn', 'provider_reference' => $reference]);
+
+        return ['booking' => $booking, 'payment' => $payment];
+    }
+
+    private function bookingStatus(array $booking): string
+    {
+        return (new BookingModel())->find($booking['id'])['status'];
+    }
+
+    // ------------------------------------------------------------------ the token
+
+    public function testACallbackWithTheRightTokenIsAcceptedAndSettlesThePayment(): void
+    {
+        $paid = $this->pendingPayment();
+
+        $result = $this->providerCalls(['provider_reference' => 'REF-1', 'status' => 'success']);
+
+        $result->assertOK();
+        $result->assertJSONExact(['received' => true]);
+        $this->assertSame('pending_moderation', $this->bookingStatus($paid['booking']));
+        $this->assertSame('success', (new PaymentModel())->find($paid['payment']['id'])['status']);
+    }
+
+    public function testACallbackWithAWrongOrMissingTokenIsRefusedAndChangesNothing(): void
+    {
+        $paid = $this->pendingPayment();
+
+        foreach (['not-the-token', self::TOKEN . 'x', substr(self::TOKEN, 0, -1), '', null] as $token) {
+            $result = $this->providerCalls(['provider_reference' => 'REF-1', 'status' => 'success'], $token);
+
+            $result->assertStatus(403);
+            $result->assertJSONFragment(['error' => 'Invalid callback token.']);
+        }
+
+        $this->assertSame('pending_payment', $this->bookingStatus($paid['booking']), 'A stranger must not be able to mark a booking paid.');
+        $this->assertSame('pending', (new PaymentModel())->find($paid['payment']['id'])['status']);
+    }
+
+    public function testWithNoTokenConfiguredNothingIsAcceptedNotEvenAnEmptyOne(): void
+    {
+        // If the secret has not been set up, "no token" must not mean "anyone may call".
+        $this->setEnv('momo.callbackToken', '');
+        $paid = $this->pendingPayment();
+
+        $this->providerCalls(['provider_reference' => 'REF-1', 'status' => 'success'], '')->assertStatus(403);
+        $this->providerCalls(['provider_reference' => 'REF-1', 'status' => 'success'], null)->assertStatus(403);
+
+        $this->assertSame('pending_payment', $this->bookingStatus($paid['booking']));
+    }
+
+    public function testTheCallbackIsOnlyReachableByPost(): void
+    {
+        $this->expectException(PageNotFoundException::class);
+
+        $this->get('payments/callback?token=' . self::TOKEN);
+    }
+
+    // ------------------------------------------------------------------ the payload
+
+    /**
+     * @return array<string, array{0: array<string, mixed>}>
+     */
+    public static function malformedPayloads(): array
+    {
+        return [
+            'nothing at all'            => [[]],
+            'no status'                 => [['provider_reference' => 'REF-1']],
+            'no reference'              => [['status' => 'success']],
+            'an empty reference'        => [['provider_reference' => '', 'status' => 'success']],
+            'an empty status'           => [['provider_reference' => 'REF-1', 'status' => '']],
+        ];
+    }
+
+    #[\PHPUnit\Framework\Attributes\DataProvider('malformedPayloads')]
+    public function testAMalformedPayloadIsRefusedAs422(array $payload): void
+    {
+        $paid = $this->pendingPayment();
+
+        $result = $this->providerCalls($payload);
+
+        $result->assertStatus(422);
+        $result->assertJSONFragment(['error' => 'Malformed callback payload.']);
+        $this->assertSame('pending_payment', $this->bookingStatus($paid['booking']));
+    }
+
+    public function testAnUnknownReferenceIsA404(): void
+    {
+        $this->pendingPayment('REF-1');
+
+        $result = $this->providerCalls(['provider_reference' => 'SOMEONE-ELSES', 'status' => 'success']);
+
+        $result->assertStatus(404);
+        $result->assertJSONFragment(['error' => 'Payment record not found.']);
+    }
+
+    public function testAFailedStatusFailsThePaymentAndLeavesTheBookingAwaitingPayment(): void
+    {
+        $paid = $this->pendingPayment();
+
+        $this->providerCalls(['provider_reference' => 'REF-1', 'status' => 'failed'])->assertOK();
+
+        $this->assertSame('failed', (new PaymentModel())->find($paid['payment']['id'])['status']);
+        $this->assertSame('pending_payment', $this->bookingStatus($paid['booking']));
+    }
+
+    public function testAProviderRetryingTheSameCallbackDoesNoHarm(): void
+    {
+        $paid = $this->pendingPayment();
+
+        $this->providerCalls(['provider_reference' => 'REF-1', 'status' => 'success'])->assertOK();
+        (new BookingModel())->update($paid['booking']['id'], ['status' => BookingModel::STATUS_APPROVED]);
+
+        $this->providerCalls(['provider_reference' => 'REF-1', 'status' => 'success'])->assertOK();
+
+        $this->assertSame('approved', $this->bookingStatus($paid['booking']), 'A retry must not pull an approved booking back into the queue.');
+    }
+
+    public function testNoStaffLoginIsNeededBecauseTheProviderHasNone(): void
+    {
+        // The route is outside the staff group; the stand-in staff filter is not what lets this through.
+        $paid = $this->pendingPayment();
+
+        $this->withSession([])->providerCalls(['provider_reference' => 'REF-1', 'status' => 'success'])->assertOK();
+
+        $this->assertSame('pending_moderation', $this->bookingStatus($paid['booking']));
+    }
+}
diff --git a/tests/feature/PresenterQueueTest.php b/tests/feature/PresenterQueueTest.php
new file mode 100644
index 0000000..99fc6ee
--- /dev/null
+++ b/tests/feature/PresenterQueueTest.php
@@ -0,0 +1,241 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\BookingModel;
+use App\Models\ShowSlotModel;
+use CodeIgniter\Exceptions\PageNotFoundException;
+use PHPUnit\Framework\Attributes\DataProvider;
+use Tests\Support\TestCase\AppFeatureTestCase;
+
+/**
+ * What a presenter sees and does: the day's approved greetings per show, marking one as read out, and playing a
+ * listener's voice note. The same voice-note files are served by three screens (the presenter's, the booking list
+ * and moderation), so the file-serving cases run against all three.
+ *
+ * @internal
+ */
+final class PresenterQueueTest extends AppFeatureTestCase
+{
+    private const VOICE_DIR = 'voice-notes-test';
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->silenceNotifications();
+    }
+
+    /**
+     * @return array<string, mixed>
+     */
+    private function approvedToday(array $show, string $recipient, array $overrides = []): array
+    {
+        $slot = (new ShowSlotModel())->findOrCreateForDate($show['id'], date('Y-m-d'));
+
+        return $this->makeBooking($overrides + ['status' => BookingModel::STATUS_APPROVED, 'show_slot_id' => $slot['id'], 'recipient_name' => $recipient]);
+    }
+
+    private function visible(string $html): string
+    {
+        return preg_replace('/\s+/', ' ', html_entity_decode(strip_tags($html), ENT_QUOTES | ENT_HTML5));
+    }
+
+    // ------------------------------------------------------------------ the queue
+
+    public function testTheDashboardListsEachActiveShowWithItsApprovedGreetings(): void
+    {
+        $morning = $this->makeShow(['name' => 'Morning Express', 'start_time' => '06:00:00']);
+        $this->makeShow(['name' => 'Evening Drive', 'start_time' => '16:00:00']);
+        $this->makeShow(['name' => 'Retired show', 'is_active' => 0]);
+        $booking = $this->approvedToday($morning, 'Mama Ruth');
+
+        $visible = $this->visible($this->get('presenter')->getBody());
+
+        foreach (['Morning Express', 'Mama Ruth', cbs_booking_reference((int) $booking['id']), 'Evening Drive', 'Nothing in the queue for this show yet.'] as $text) {
+            $this->assertStringContainsString($text, $visible);
+        }
+        $this->assertStringNotContainsString('Retired show', $visible);
+    }
+
+    public function testWithNoShowsThePageSaysSo(): void
+    {
+        $this->assertStringContainsString('No active shows are configured.', $this->visible($this->get('presenter')->getBody()));
+    }
+
+    public function testOnlyApprovedGreetingsReachThePresenter(): void
+    {
+        $show = $this->makeShow();
+        $this->approvedToday($show, 'Approved one');
+        $this->approvedToday($show, 'Not yet reviewed', ['status' => BookingModel::STATUS_PENDING_MODERATION]);
+        $this->approvedToday($show, 'Never paid', ['status' => BookingModel::STATUS_PENDING_PAYMENT]);
+        $this->approvedToday($show, 'Already read', ['status' => BookingModel::STATUS_AIRED]);
+
+        $visible = $this->visible($this->get('presenter/shows/' . $show['id'])->getBody());
+
+        $this->assertStringContainsString('Approved one', $visible);
+
+        foreach (['Not yet reviewed', 'Never paid', 'Already read'] as $hidden) {
+            $this->assertStringNotContainsString($hidden, $visible);
+        }
+    }
+
+    public function testAShowsQueueCanBeLookedUpForAnotherDay(): void
+    {
+        $show = $this->makeShow();
+        $slot = (new ShowSlotModel())->findOrCreateForDate($show['id'], '2026-12-24');
+        $this->makeBooking(['status' => BookingModel::STATUS_APPROVED, 'show_slot_id' => $slot['id'], 'recipient_name' => 'Christmas Eve']);
+        $this->approvedToday($show, 'Today only');
+
+        $visible = $this->visible($this->get('presenter/shows/' . $show['id'] . '?date=2026-12-24')->getBody());
+
+        $this->assertStringContainsString('Christmas Eve', $visible);
+        $this->assertStringNotContainsString('Today only', $visible);
+    }
+
+    // ------------------------------------------------------------------ reading one out
+
+    public function testMarkingAGreetingAiredRecordsItAndTakesItOffTheQueue(): void
+    {
+        $show    = $this->makeShow();
+        $booking = $this->approvedToday($show, 'Mama Ruth');
+
+        $this->post('presenter/bookings/' . $booking['id'] . '/aired')->assertRedirect();
+
+        $this->assertSame('Marked as aired.', $this->flash('toastr_success'));
+
+        $after = (new BookingModel())->find($booking['id']);
+        $this->assertSame('aired', $after['status']);
+        $this->assertNotNull($after['aired_at']);
+
+        $this->assertStringNotContainsString('Mama Ruth', $this->visible($this->get('presenter/shows/' . $show['id'])->getBody()));
+    }
+
+    public function testOnlyAnApprovedGreetingCanBeMarkedAired(): void
+    {
+        foreach ([BookingModel::STATUS_PENDING_PAYMENT, BookingModel::STATUS_PENDING_MODERATION, BookingModel::STATUS_REJECTED, BookingModel::STATUS_AIRED, BookingModel::STATUS_CANCELLED] as $status) {
+            $booking = $this->makeBooking(['status' => $status]);
+
+            $this->post('presenter/bookings/' . $booking['id'] . '/aired')->assertRedirect();
+
+            $this->assertSame('Could not mark this booking as aired.', $this->flash('toastr_error'), $status);
+            $this->assertSame($status, (new BookingModel())->find($booking['id'])['status']);
+        }
+    }
+
+    public function testAnUnknownGreetingCannotBeMarkedAired(): void
+    {
+        $this->post('presenter/bookings/999999/aired')->assertRedirect();
+
+        $this->assertSame('Could not mark this booking as aired.', $this->flash('toastr_error'));
+    }
+
+    // ------------------------------------------------------------------ playing a voice note
+
+    /**
+     * @return array<string, array{0: string}>
+     */
+    public static function voiceNoteScreens(): array
+    {
+        return [
+            'the presenter'    => ['presenter/bookings/{id}/voice-note'],
+            'the booking list' => ['admin/bookings/{id}/voice-note'],
+            'moderation'       => ['admin/moderation/{id}/voice-note'],
+        ];
+    }
+
+    private function bookingWithVoiceNote(string $relativePath): int|string
+    {
+        return $this->makeBooking(['voice_note_path' => $relativePath, 'voice_note_duration_seconds' => 6])['id'];
+    }
+
+    private function storeVoiceNote(string $fixture = 'chrome-recording.webm'): string
+    {
+        $dir = WRITEPATH . self::VOICE_DIR;
+
+        if (! is_dir($dir)) {
+            mkdir($dir, 0755, true);
+        }
+
+        $name = 'note-' . bin2hex(random_bytes(4)) . '.webm';
+        copy(\Tests\Support\Libraries\AudioFixtures::path($fixture), "{$dir}/{$name}");
+
+        return self::VOICE_DIR . '/' . $name;
+    }
+
+    #[DataProvider('voiceNoteScreens')]
+    public function testAStoredVoiceNoteIsPlayedBackInline(string $route): void
+    {
+        $path = $this->storeVoiceNote();
+        $id   = $this->bookingWithVoiceNote($path);
+
+        $result = $this->get(str_replace('{id}', (string) $id, $route));
+
+        $result->assertOK();
+        $this->assertSame('video/webm', $result->response()->getHeaderLine('Content-Type'));
+        $this->assertStringStartsWith('inline;', $result->response()->getHeaderLine('Content-Disposition'));
+        $this->assertSame(file_get_contents(WRITEPATH . $path), $result->response()->getBody(), 'The exact bytes that were recorded.');
+    }
+
+    #[DataProvider('voiceNoteScreens')]
+    public function testABookingWithoutAVoiceNoteHasNothingToPlay(string $route): void
+    {
+        $id = $this->makeBooking()['id'];
+
+        $this->expectException(PageNotFoundException::class);
+
+        $this->get(str_replace('{id}', (string) $id, $route));
+    }
+
+    #[DataProvider('voiceNoteScreens')]
+    public function testAVoiceNoteWhoseFileHasGoneIsNotFound(string $route): void
+    {
+        $id = $this->bookingWithVoiceNote(self::VOICE_DIR . '/was-deleted.webm');
+
+        $this->expectException(PageNotFoundException::class);
+
+        $this->get(str_replace('{id}', (string) $id, $route));
+    }
+
+    /**
+     * @return array<string, array{0: string}>
+     */
+    public static function hostileStoredPaths(): array
+    {
+        return [
+            'climbing out to the project root' => ['../.env'],
+            'climbing out to the app'          => ['voice-notes-test/../../app/Config/App.php'],
+            'the system password file'         => ['../../../../../../../../etc/passwd'],
+            'the session folder'               => ['session/cbs-test-secret.txt'],
+            'the log folder'                   => ['logs/cbs-test-secret.txt'],
+        ];
+    }
+
+    #[DataProvider('hostileStoredPaths')]
+    public function testAHostilePathInTheDatabaseCanNeverServeAnotherFile(string $storedPath): void
+    {
+        // Paths are written only by our own uploader, so this should never happen. But a path read from the database
+        // is not trusted, and the voice-note screens must not become a way to read the server's other files.
+        foreach (['session', 'logs'] as $folder) {
+            @mkdir(WRITEPATH . $folder, 0755, true);
+        }
+        file_put_contents(WRITEPATH . 'session/cbs-test-secret.txt', 'a session id');
+        file_put_contents(WRITEPATH . 'logs/cbs-test-secret.txt', 'a stack trace');
+
+        try {
+            $id = $this->bookingWithVoiceNote($storedPath);
+
+            foreach (['presenter/bookings/{id}/voice-note', 'admin/bookings/{id}/voice-note', 'admin/moderation/{id}/voice-note'] as $route) {
+                try {
+                    $body = $this->get(str_replace('{id}', (string) $id, $route))->response()->getBody();
+                    $this->fail("{$route} served something for the stored path '{$storedPath}': " . substr((string) $body, 0, 40));
+                } catch (PageNotFoundException) {
+                    $this->addToAssertionCount(1);
+                }
+            }
+        } finally {
+            @unlink(WRITEPATH . 'session/cbs-test-secret.txt');
+            @unlink(WRITEPATH . 'logs/cbs-test-secret.txt');
+        }
+    }
+}
diff --git a/tests/feature/RoutesSmokeTest.php b/tests/feature/RoutesSmokeTest.php
new file mode 100644
index 0000000..944e955
--- /dev/null
+++ b/tests/feature/RoutesSmokeTest.php
@@ -0,0 +1,147 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\BookingModel;
+use App\Models\ShowSlotModel;
+use CodeIgniter\Exceptions\PageNotFoundException;
+use PHPUnit\Framework\Attributes\DataProvider;
+use Tests\Support\TestCase\AppFeatureTestCase;
+
+/**
+ * Every page the application serves, visited once with realistic data behind it. The cheapest test there is, and the
+ * one that catches a broken view, a mistyped route or a method that no longer exists.
+ *
+ * @internal
+ */
+final class RoutesSmokeTest extends AppFeatureTestCase
+{
+    /** @var array<string, int|string> filled in by setUp: the ids and slugs the paths below refer to */
+    private array $ids = [];
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $category = $this->makeCategory(['slug' => 'birthdays']);
+        $tier     = $this->makeTier($category['id']);
+        $show     = $this->makeShow();
+        $slot     = (new ShowSlotModel())->findOrCreateForDate($show['id'], date('Y-m-d'));
+        $booking  = $this->makeBooking(['category_id' => $category['id'], 'rate_tier_id' => $tier['id'], 'show_slot_id' => $slot['id'], 'status' => BookingModel::STATUS_PENDING_PAYMENT]);
+        $gift     = $this->makeGift();
+        $order    = $this->makeGiftOrder(['gift_id' => $gift['id']]);
+
+        $this->makePayment(['booking_id' => $booking['id']]);
+
+        $this->ids = [
+            'category' => $category['id'], 'slug' => 'birthdays', 'tier' => $tier['id'], 'show' => $show['id'], 'booking' => $booking['id'],
+            'gift' => $gift['id'], 'order' => $order['id'], 'vendor' => $this->makeVendor()['id'],
+            'template' => (int) (new \App\Models\MessageTemplateModel())->insert(['language' => 'English', 'title' => 'T', 'body' => 'B {recipient}']),
+        ];
+    }
+
+    private function resolve(string $path): string
+    {
+        return preg_replace_callback('/\{(\w+)\}/', fn (array $m) => (string) $this->ids[$m[1]], $path);
+    }
+
+    /**
+     * @return array<string, array{0: string}>
+     */
+    public static function pages(): array
+    {
+        $paths = [
+            // public
+            '/', 'booking', 'booking/{slug}', 'booking/{booking}/pay', 'booking/{booking}/confirmation',
+            'gifts', 'gifts/{order}/pay', 'gifts/{order}/confirmation',
+            // presenter
+            'presenter', 'presenter/shows/{show}',
+            // admin
+            'admin', 'admin/settings/general', 'admin/settings/site', 'admin/settings/payments', 'admin/settings/notifications',
+            'admin/settings/templates', 'admin/settings/bookings',
+            'admin/bookings', 'admin/bookings/{booking}', 'admin/moderation', 'admin/payments', 'admin/gift-orders', 'admin/notifications',
+            'admin/categories', 'admin/categories/create', 'admin/categories/{category}/edit',
+            'admin/shows', 'admin/shows/create', 'admin/shows/{show}/edit',
+            'admin/rate-tiers', 'admin/rate-tiers/create', 'admin/rate-tiers/{tier}/edit',
+            'admin/message-templates', 'admin/message-templates/create', 'admin/message-templates/{template}/edit',
+            'admin/gifts', 'admin/gifts/create', 'admin/gifts/{gift}/edit',
+            'admin/gift-vendors', 'admin/gift-vendors/create', 'admin/gift-vendors/{vendor}/edit',
+        ];
+
+        return array_combine($paths, array_map(static fn (string $p) => [$p], $paths));
+    }
+
+    #[DataProvider('pages')]
+    public function testThePageIsServed(string $path): void
+    {
+        $result = $this->get($this->resolve($path));
+
+        $result->assertOK();
+        $this->assertNotSame('', trim($result->getBody()), 'The page came back empty.');
+    }
+
+    public function testEveryPageEmitsNoPhpErrorsOrWarnings(): void
+    {
+        foreach (array_keys(self::pages()) as $path) {
+            $body = $this->get($this->resolve($path))->getBody();
+
+            foreach (['Fatal error', 'Warning:', 'Notice:', 'Deprecated:', 'Undefined variable', 'Undefined array key', 'Stack trace'] as $symptom) {
+                $this->assertStringNotContainsString($symptom, $body, "{$path} shows '{$symptom}'.");
+            }
+        }
+    }
+
+    /**
+     * @return array<string, array{0: string, 1: string}>
+     */
+    public static function missingThings(): array
+    {
+        return [
+            'an unknown category'             => ['booking/no-such-category', 'booking'],
+            'an unknown booking to pay'       => ['booking/999999/pay', 'booking'],
+            'an unknown booking confirmation' => ['booking/999999/confirmation', 'booking'],
+            'an unknown gift order to pay'    => ['gifts/999999/pay', 'gifts'],
+            'an unknown admin booking'        => ['admin/bookings/999999', 'admin/bookings'],
+            'an unknown category to edit'     => ['admin/categories/999999/edit', 'admin/categories'],
+            'an unknown template to edit'     => ['admin/message-templates/999999/edit', 'admin/message-templates'],
+            'an unknown settings tab'         => ['admin/settings/no-such-tab', 'admin/settings'],
+        ];
+    }
+
+    #[DataProvider('missingThings')]
+    public function testAMissingThingSendsThePersonBackToTheListWithAMessage(string $path, string $backTo): void
+    {
+        $result = $this->get($path);
+
+        $result->assertRedirect();
+        $this->assertStringEndsWith('/' . $backTo, rtrim($result->getRedirectUrl(), '/'));
+        $this->assertNotEmpty($this->flash('toastr_error'));
+    }
+
+    public function testASettingsLandingGoesToTheFirstTab(): void
+    {
+        $this->get('admin/settings')->assertRedirectTo(site_url('admin/settings/general'));
+    }
+
+    /**
+     * @return array<string, array{0: string}>
+     */
+    public static function voiceNotePaths(): array
+    {
+        return [
+            'in the booking list'  => ['admin/bookings/{booking}/voice-note'],
+            'in moderation'        => ['admin/moderation/{booking}/voice-note'],
+            'in the presenter app' => ['presenter/bookings/{booking}/voice-note'],
+        ];
+    }
+
+    #[DataProvider('voiceNotePaths')]
+    public function testAVoiceNoteThatDoesNotExistIsNotFound(string $path): void
+    {
