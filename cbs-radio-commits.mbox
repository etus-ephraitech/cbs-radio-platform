diff --git a/tests/unit/Libraries/FileManagerTest.php b/tests/unit/Libraries/FileManagerTest.php
new file mode 100644
index 0000000..9eee046
--- /dev/null
+++ b/tests/unit/Libraries/FileManagerTest.php
@@ -0,0 +1,255 @@
+<?php
+
+namespace Tests\Unit\Libraries;
+
+use App\Libraries\FileManager;
+use CodeIgniter\Exceptions\PageNotFoundException;
+use CodeIgniter\HTTP\Response;
+use Config\App;
+use PHPUnit\Framework\Attributes\DataProvider;
+use Tests\Support\Libraries\AudioFixtures;
+use Tests\Support\TestCase\UnitTestCase;
+
+/**
+ * The one place that reads, serves and deletes files under writable/. Stored paths come from the database, so they
+ * are treated as untrusted: nothing may climb out of writable/, and CodeIgniter's own folders there are off limits.
+ *
+ * @internal
+ */
+final class FileManagerTest extends UnitTestCase
+{
+    private const AREA = 'file-manager-test';
+
+    private FileManager $files;
+
+    /** @var string[] files this test wrote outside its own folder, removed afterwards */
+    private array $strays = [];
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->files = new FileManager();
+    }
+
+    protected function tearDown(): void
+    {
+        $this->removeDirectory(WRITEPATH . self::AREA);
+
+        foreach ($this->strays as $file) {
+            if (is_file($file)) {
+                unlink($file);
+            }
+        }
+
+        AudioFixtures::cleanUp();
+
+        parent::tearDown();
+    }
+
+    private function removeDirectory(string $path): void
+    {
+        if (! is_dir($path)) {
+            return;
+        }
+
+        foreach (scandir($path) ?: [] as $entry) {
+            if ($entry !== '.' && $entry !== '..') {
+                is_dir("{$path}/{$entry}") ? $this->removeDirectory("{$path}/{$entry}") : unlink("{$path}/{$entry}");
+            }
+        }
+
+        rmdir($path);
+    }
+
+    /**
+     * A file placed directly under writable/, returned as the relative path the database would hold.
+     */
+    private function place(string $relative, string $contents = 'hello'): string
+    {
+        $full = WRITEPATH . $relative;
+
+        if (! is_dir(dirname($full))) {
+            mkdir(dirname($full), 0755, true);
+        }
+
+        file_put_contents($full, $contents);
+        $this->strays[] = $full;
+
+        return $relative;
+    }
+
+    // ------------------------------------------------------------------ storing
+
+    public function testAnUploadIsMovedIntoTheGivenFolderUnderAGeneratedName(): void
+    {
+        $path = $this->files->store(AudioFixtures::upload('chrome-recording.webm', 'voice-note.webm'), self::AREA);
+
+        $this->assertMatchesRegularExpression('#^' . self::AREA . '/\d+_[a-f0-9]+\.webm$#', $path);
+        $this->assertFileExists(WRITEPATH . $path);
+    }
+
+    public function testTheFolderIsCreatedIfItDoesNotExistYet(): void
+    {
+        $this->assertDirectoryDoesNotExist(WRITEPATH . self::AREA . '/nested');
+
+        $path = $this->files->store(AudioFixtures::upload('recording.mp3', 'a.mp3'), self::AREA . '/nested');
+
+        $this->assertFileExists(WRITEPATH . $path);
+    }
+
+    public function testTwoUploadsNeverShareAName(): void
+    {
+        $a = $this->files->store(AudioFixtures::upload('recording.mp3', 'same.mp3'), self::AREA);
+        $b = $this->files->store(AudioFixtures::upload('recording.mp3', 'same.mp3'), self::AREA);
+
+        $this->assertNotSame($a, $b);
+    }
+
+    public function testSlashesAroundTheFolderNameAreTidied(): void
+    {
+        $path = $this->files->store(AudioFixtures::upload('recording.mp3', 'a.mp3'), '/' . self::AREA . '/');
+
+        $this->assertStringStartsWith(self::AREA . '/', $path);
+    }
+
+    // ------------------------------------------------------------------ asking about a file
+
+    public function testAStoredFileIsReportedAsPresentWithItsSize(): void
+    {
+        $path = $this->place(self::AREA . '/a.txt', str_repeat('x', 2048));
+
+        $this->assertTrue($this->files->exists($path));
+        $this->assertSame(2.0, $this->files->sizeKB($path));
+    }
+
+    public function testAMissingFileIsAbsentAndHasNoSize(): void
+    {
+        $this->assertFalse($this->files->exists(self::AREA . '/never-there.txt'));
+        $this->assertSame(0.0, $this->files->sizeKB(self::AREA . '/never-there.txt'));
+    }
+
+    public function testADirectoryIsNotAFile(): void
+    {
+        $this->place(self::AREA . '/folder/a.txt');
+
+        $this->assertFalse($this->files->exists(self::AREA . '/folder'));
+    }
+
+    public function testThePathIsRelativeToWritableWhateverTheLeadingSlashes(): void
+    {
+        $this->assertSame(rtrim(WRITEPATH, '/') . '/voice-notes/x.webm', $this->files->fullPath('voice-notes/x.webm'));
+        $this->assertSame($this->files->fullPath('voice-notes/x.webm'), $this->files->fullPath('///voice-notes/x.webm'), 'A leading slash is not an escape to the filesystem root.');
+    }
+
+    // ------------------------------------------------------------------ deleting
+
+    public function testAFileCanBeDeletedOnce(): void
+    {
+        $path = $this->place(self::AREA . '/a.txt');
+
+        $this->assertTrue($this->files->delete($path));
+        $this->assertFileDoesNotExist(WRITEPATH . $path);
+        $this->assertFalse($this->files->delete($path), 'Deleting something already gone is a quiet false.');
+    }
+
+    // ------------------------------------------------------------------ serving
+
+    public function testAFileIsServedInlineWithItsRealTypeAndContents(): void
+    {
+        $path = $this->files->store(AudioFixtures::upload('chrome-recording.webm', 'voice-note.webm'), self::AREA);
+
+        $response = $this->files->streamInline(new Response(config(App::class)), $path);
+
+        $this->assertSame('video/webm', $response->getHeaderLine('Content-Type'));
+        $this->assertSame('inline; filename="' . basename($path) . '"', $response->getHeaderLine('Content-Disposition'));
+        // The framework adds its own default Cache-Control to every response and ours is merged with it; what
+        // matters is that a private recording is never marked as publicly cacheable.
+        $this->assertStringContainsString('private', $response->getHeaderLine('Cache-Control'));
+        $this->assertStringContainsString('must-revalidate', $response->getHeaderLine('Cache-Control'));
+        $this->assertStringNotContainsString('public', $response->getHeaderLine('Cache-Control'));
+        $this->assertSame(file_get_contents(AudioFixtures::path('chrome-recording.webm')), $response->getBody());
+    }
+
+    public function testAMissingFileIsNotFound(): void
+    {
+        $this->expectException(PageNotFoundException::class);
+
+        $this->files->streamInline(new Response(config(App::class)), self::AREA . '/never-there.webm');
+    }
+
+    // ------------------------------------------------------------------ untrusted paths
+
+    /**
+     * @return array<string, array{0: string}>
+     */
+    public static function pathsThatEscape(): array
+    {
+        return [
+            'one level up'                  => ['../.env'],
+            'up and into the app'           => [self::AREA . '/../../app/Config/App.php'],
+            'up and out through a folder'   => [self::AREA . '/../../../etc/passwd'],
+            'deep traversal'                => ['../../../../../../../../etc/passwd'],
+            'an absolute path'              => ['/etc/passwd'],
+        ];
+    }
+
+    #[DataProvider('pathsThatEscape')]
+    public function testAPathThatClimbsOutOfWritableIsRefusedEverywhere(string $path): void
+    {
+        $this->place(self::AREA . '/decoy.txt');   // makes sure the folder exists, so ".." has something to climb from
+
+        $this->assertFalse($this->files->exists($path));
+        $this->assertSame(0.0, $this->files->sizeKB($path));
+        $this->assertFalse($this->files->delete($path), 'Nothing outside writable/ may be deleted.');
+
+        $this->expectException(PageNotFoundException::class);
+        $this->files->streamInline(new Response(config(App::class)), $path);
+    }
+
+    public function testAFileOutsideWritableSurvivesAnAttemptToDeleteIt(): void
+    {
+        $outside = sys_get_temp_dir() . '/cbs-outside-' . bin2hex(random_bytes(4)) . '.txt';
+        file_put_contents($outside, 'precious');
+        $this->strays[] = $outside;
+
+        $relative = str_repeat('../', 12) . ltrim($outside, '/');
+
+        $this->assertFalse($this->files->delete($relative));
+        $this->assertFileExists($outside);
+    }
+
+    /**
+     * @return array<string, array{0: string}>
+     */
+    public static function codeIgnitersOwnFolders(): array
+    {
+        return [
+            'sessions' => ['session'],
+            'logs'     => ['logs'],
+            'cache'    => ['cache'],
+            'debugbar' => ['debugbar'],
+        ];
+    }
+
+    #[DataProvider('codeIgnitersOwnFolders')]
+    public function testCodeIgnitersPrivateFoldersAreNeverServedOrDeleted(string $folder): void
+    {
+        $path = $this->place($folder . '/cbs-test-secret.txt', 'a session id or a stack trace');
+
+        $this->assertFalse($this->files->exists($path));
+        $this->assertFalse($this->files->delete($path));
+        $this->assertFileExists(WRITEPATH . $path, 'The refused delete must really have left it alone.');
+
+        $this->expectException(PageNotFoundException::class);
+        $this->files->streamInline(new Response(config(App::class)), $path);
+    }
+
+    public function testAClimbThatLandsInAPrivateFolderIsRefusedToo(): void
+    {
+        $this->place('logs/cbs-test-secret.txt');
+        $this->place(self::AREA . '/decoy.txt');
+
+        $this->assertFalse($this->files->exists(self::AREA . '/../logs/cbs-test-secret.txt'));
+    }
+}
diff --git a/tests/unit/Libraries/MessageSanitizerTest.php b/tests/unit/Libraries/MessageSanitizerTest.php
new file mode 100644
index 0000000..5777609
--- /dev/null
+++ b/tests/unit/Libraries/MessageSanitizerTest.php
@@ -0,0 +1,240 @@
+<?php
+
+namespace Tests\Unit\Libraries;
+
+use App\Libraries\MessageSanitizer;
+use Config\CbsRadio;
+use PHPUnit\Framework\Attributes\DataProvider;
+use Tests\Support\TestCase\UnitTestCase;
+
+/**
+ * @internal
+ */
+final class MessageSanitizerTest extends UnitTestCase
+{
+    /**
+     * @param array<string, mixed> $config properties to set on the CbsRadio config, e.g. ['messageMaxLength' => 50]
+     */
+    private function sanitizer(array $config = []): MessageSanitizer
+    {
+        $cbs = new CbsRadio();
+
+        foreach ($config as $property => $value) {
+            $cbs->{$property} = $value;
+        }
+
+        return new MessageSanitizer($cbs);
+    }
+
+    // ------------------------------------------------------------------ sanitize
+
+    public function testMarkupIsStrippedAndWhitespaceCollapsed(): void
+    {
+        $this->assertSame(
+            'Happy birthday Mama Ruth',
+            $this->sanitizer()->sanitize("  <b>Happy</b>\n\n birthday\t Mama   Ruth  ")
+        );
+    }
+
+    public function testAScriptTagCannotSurviveSanitising(): void
+    {
+        $clean = $this->sanitizer()->sanitize('<script>alert(1)</script>Hi <img src=x onerror=alert(1)>');
+
+        $this->assertStringNotContainsString('<', $clean);
+        $this->assertStringNotContainsString('>', $clean);
+    }
+
+    public function testPlainPunctuationAndAccentsAreLeftAlone(): void
+    {
+        $this->assertSame("Congrats, José! It's 5 > 3 & we're proud.", $this->sanitizer()->sanitize("Congrats, José! It's 5 > 3 & we're proud."));
+    }
+
+    // ------------------------------------------------------------------ validateMessage
+
+    #[DataProvider('emptyMessages')]
+    public function testAnEmptyMessageIsRefused(string $input): void
+    {
+        $result = $this->sanitizer()->validateMessage($input);
+
+        $this->assertFalse($result['valid']);
+        $this->assertSame('Message cannot be empty.', $result['message']);
+        $this->assertSame('', $result['sanitized']);
+    }
+
+    /**
+     * @return array<string, array{0: string}>
+     */
+    public static function emptyMessages(): array
+    {
+        return [
+            'nothing'          => [''],
+            'only spaces'      => ['     '],
+            'only line breaks' => ["\n\r\n\t"],
+            'only markup'      => ['<b></b><i> </i>'],
+        ];
+    }
+
+    public function testAMessageAtTheLimitIsAccepted(): void
+    {
+        $result = $this->sanitizer(['messageMaxLength' => 50])->validateMessage(str_repeat('a', 50));
+
+        $this->assertTrue($result['valid']);
+    }
+
+    public function testAMessageOneOverTheLimitIsRefusedWithTheLimitInTheMessage(): void
+    {
+        $result = $this->sanitizer(['messageMaxLength' => 50])->validateMessage(str_repeat('a', 51));
+
+        $this->assertFalse($result['valid']);
+        $this->assertSame('Message is too long (max 50 characters).', $result['message']);
+    }
+
+    public function testLengthIsCountedInCharactersNotBytes(): void
+    {
+        // 50 two-byte characters is 100 bytes but 50 characters, and must be accepted.
+        $this->assertTrue($this->sanitizer(['messageMaxLength' => 50])->validateMessage(str_repeat('é', 50))['valid']);
+    }
+
+    public function testLengthIsCountedAfterWhitespaceIsCollapsed(): void
+    {
+        $sanitizer = $this->sanitizer(['messageMaxLength' => 50]);
+
+        // 42 characters as typed, but only "a b" once the run of spaces is collapsed: well within the limit.
+        $this->assertTrue($sanitizer->validateMessage('a' . str_repeat(' ', 40) . 'b')['valid']);
+
+        // 30 + 1 + 30 once collapsed: over the limit.
+        $this->assertFalse($sanitizer->validateMessage(str_repeat('a', 30) . str_repeat(' ', 20) . str_repeat('b', 30))['valid']);
+    }
+
+    public function testAValidMessageComesBackSanitised(): void
+    {
+        $result = $this->sanitizer()->validateMessage("  <b>Happy</b>   birthday!\n");
+
+        $this->assertSame(['valid' => true, 'message' => '', 'sanitized' => 'Happy birthday!'], $result);
+    }
+
+    // ------------------------------------------------------------------ unfilled example markers
+
+    #[DataProvider('markers')]
+    public function testAnUnfilledMarkerIsRefusedWhateverItsCase(string $typed, string $reported): void
+    {
+        $result = $this->sanitizer()->validateMessage("Happy birthday {$typed}, enjoy!");
+
+        $this->assertFalse($result['valid']);
+        $this->assertSame("Replace {$reported} with a name before sending.", $result['message']);
+    }
+
+    /**
+     * @return array<string, array{0: string, 1: string}>
+     */
+    public static function markers(): array
+    {
+        return [
+            'recipient marker'          => ['[their name]', '[their name]'],
+            'recipient, upper case'     => ['[THEIR NAME]', '[their name]'],
+            'sender marker'             => ['[your name]', '[your name]'],
+            'sender, mixed case'        => ['[Your Name]', '[your name]'],
+        ];
+    }
+
+    public function testAMarkerIsReportedBeforeALengthProblem(): void
+    {
+        $result = $this->sanitizer(['messageMaxLength' => 50])->validateMessage(str_repeat('x', 60) . ' [their name]');
+
+        $this->assertStringStartsWith('Replace [their name]', $result['message']);
+    }
+
+    public function testOrdinarySquareBracketsAreNotMarkers(): void
+    {
+        $this->assertTrue($this->sanitizer()->validateMessage('Hi [Ruth], enjoy (this [bracketed] bit)!')['valid']);
+        $this->assertNull($this->sanitizer()->unfilledPlaceholder('Hi [Ruth]'));
+    }
+
+    public function testUnfilledPlaceholderReportsTheFirstMarkerOrNull(): void
+    {
+        $sanitizer = $this->sanitizer();
+
+        $this->assertSame('[their name]', $sanitizer->unfilledPlaceholder('To [THEIR NAME] from [your name]'));
+        $this->assertSame('[your name]', $sanitizer->unfilledPlaceholder('From [your name]'));
+        $this->assertNull($sanitizer->unfilledPlaceholder('Nothing to fill in'));
+    }
+
+    // ------------------------------------------------------------------ validateRecipientName
+
+    public function testARecipientNameIsRequired(): void
+    {
+        $result = $this->sanitizer()->validateRecipientName('  <i> </i> ');
+
+        $this->assertFalse($result['valid']);
+        $this->assertSame('Recipient name cannot be empty.', $result['message']);
+    }
+
+    public function testARecipientNameHasALimit(): void
+    {
+        $sanitizer = $this->sanitizer(['recipientNameMaxLength' => 20]);
+
+        $this->assertTrue($sanitizer->validateRecipientName(str_repeat('a', 20))['valid']);
+
+        $result = $sanitizer->validateRecipientName(str_repeat('a', 21));
+        $this->assertFalse($result['valid']);
+        $this->assertSame('Recipient name is too long (max 20 characters).', $result['message']);
+    }
+
+    public function testARecipientNameIsSanitised(): void
+    {
+        $this->assertSame('Mama Ruth', $this->sanitizer()->validateRecipientName(' <i>Mama</i>  Ruth ')['sanitized']);
+    }
+
+    // ------------------------------------------------------------------ flaggedTerms
+
+    public function testNothingIsFlaggedWhenThereAreNoTerms(): void
+    {
+        $this->assertSame([], $this->sanitizer(['moderationFlagTerms' => []])->flaggedTerms('anything at all'));
+    }
+
+    public function testATermMatchesWhateverItsCase(): void
+    {
+        $this->assertSame(['scam'], $this->sanitizer(['moderationFlagTerms' => ['SCAM']])->flaggedTerms('This is a Scam!'));
+    }
+
+    public function testATermOnlyMatchesWholeWords(): void
+    {
+        $sanitizer = $this->sanitizer(['moderationFlagTerms' => ['ass']]);
+
+        $this->assertSame([], $sanitizer->flaggedTerms('A glass of class'), 'A term inside another word is not a match.');
+        $this->assertSame(['ass'], $sanitizer->flaggedTerms('what an ass'));
+    }
+
+    public function testAPhraseMatches(): void
+    {
+        $this->assertSame(['free money'], $this->sanitizer(['moderationFlagTerms' => ['free money']])->flaggedTerms('Get FREE MONEY now'));
+    }
+
+    public function testEachMatchingTermIsReportedOnceInConfiguredOrder(): void
+    {
+        $sanitizer = $this->sanitizer(['moderationFlagTerms' => ['scam', 'free money', 'lottery']]);
+
+        $this->assertSame(['scam', 'lottery'], $sanitizer->flaggedTerms('lottery lottery scam lottery'));
+    }
+
+    public function testBlankTermsAreIgnored(): void
+    {
+        $sanitizer = $this->sanitizer(['moderationFlagTerms' => ['', '   ', 'scam']]);
+
+        $this->assertSame(['scam'], $sanitizer->flaggedTerms('a scam'));
+        $this->assertSame([], $sanitizer->flaggedTerms('perfectly fine'));
+    }
+
+    public function testRegexCharactersInATermAreTakenLiterally(): void
+    {
+        $sanitizer = $this->sanitizer(['moderationFlagTerms' => ['c.o.d']]);
+
+        $this->assertSame(['c.o.d'], $sanitizer->flaggedTerms('pay c.o.d please'));
+        $this->assertSame([], $sanitizer->flaggedTerms('cxoxd'), 'A "." in a term is a full stop, not "any character".');
+    }
+
+    public function testAccentedTermsMatchIgnoringCase(): void
+    {
+        $this->assertSame(['café'], $this->sanitizer(['moderationFlagTerms' => ['café']])->flaggedTerms('Meet at the CAFÉ'));
+    }
+}
diff --git a/tests/unit/Libraries/VoiceNoteUploaderTest.php b/tests/unit/Libraries/VoiceNoteUploaderTest.php
new file mode 100644
index 0000000..7b1fc42
--- /dev/null
+++ b/tests/unit/Libraries/VoiceNoteUploaderTest.php
@@ -0,0 +1,455 @@
+<?php
+
+namespace Tests\Unit\Libraries;
+
+use App\Libraries\VoiceNoteUploader;
+use Config\CbsRadio;
+use PHPUnit\Framework\Attributes\DataProvider;
+use ReflectionMethod;
+use Tests\Support\Libraries\AudioFixtures;
+use Tests\Support\TestCase\UnitTestCase;
+
+/**
+ * VoiceNoteUploader against real audio, made the way real devices make it (tests/_support/Audio, regenerated by
+ * scripts/make-test-audio.sh). The container, not the file name, decides what PHP's file-type detection reports,
+ * and audio-only WebM and MP4 are reported as *video* types, which is exactly the thing a synthetic test file hides.
+ *
+ * Tests that need to open the file (true length, "this is really a video") need ffprobe, which ships with ffmpeg,
+ * and are skipped, loudly, where it is not installed. CI installs it.
+ *
+ * @internal
+ */
+final class VoiceNoteUploaderTest extends UnitTestCase
+{
+    private const STORE_SUBPATH = 'voice-notes-unit-test';
+
+    protected function tearDown(): void
+    {
+        $this->removeDirectory(WRITEPATH . self::STORE_SUBPATH);
+        AudioFixtures::cleanUp();
+
+        parent::tearDown();
+    }
+
+    // ------------------------------------------------------------------ helpers
+
+    /**
+     * @param array<string, mixed> $config properties to set on the CbsRadio config
+     */
+    private function uploader(array $config = [], bool $verifyWithFfprobe = true): VoiceNoteUploader
+    {
+        $cbs = new CbsRadio();
+
+        $cbs->voiceNoteVerifyWithFfprobe = $verifyWithFfprobe;
+        $cbs->voiceNoteUploadSubpath     = self::STORE_SUBPATH;
+
+        foreach ($config as $property => $value) {
+            $cbs->{$property} = $value;
+        }
+
+        return new VoiceNoteUploader($cbs);
+    }
+
+    private function requireFfprobe(): void
+    {
+        if (trim((string) shell_exec('command -v ffprobe 2>/dev/null')) === '') {
+            $this->markTestSkipped('ffprobe is not installed (it comes with ffmpeg), so the file cannot be opened to measure it.');
+        }
+    }
+
+    private function removeDirectory(string $path): void
+    {
+        if (! is_dir($path)) {
+            return;
+        }
+
+        foreach (scandir($path) ?: [] as $entry) {
+            if ($entry !== '.' && $entry !== '..') {
+                is_dir("{$path}/{$entry}") ? $this->removeDirectory("{$path}/{$entry}") : unlink("{$path}/{$entry}");
+            }
+        }
+
+        rmdir($path);
+    }
+
+    // ------------------------------------------------------------------ the formats real devices produce
+
+    /**
+     * @return array<string, array{0: string, 1: string, 2: string}> fixture, what PHP reports for it, the device
+     */
+    public static function deviceFormats(): array
+    {
+        return [
+            'Chrome, Edge, Android (WebM)'     => ['chrome-recording.webm', 'video/webm', 'voice-note.webm'],
+            'Firefox (Ogg)'                    => ['firefox-recording.ogg', 'audio/ogg', 'voice-note.ogg'],
+            'WhatsApp voice note (Opus)'       => ['whatsapp-voice.opus', 'audio/ogg', 'voice.opus'],
+            'phone voice memo (M4A)'           => ['voice-memo.m4a', 'audio/x-m4a', 'memo.m4a'],
+            'Safari and iPhone (MP4 as M4A)'   => ['safari-recording.m4a', 'video/mp4', 'voice-note.m4a'],
+            'MP3'                              => ['recording.mp3', 'audio/mpeg', 'recording.mp3'],
+            'WAV'                              => ['recording.wav', 'audio/x-wav', 'recording.wav'],
+            'AAC'                              => ['recording.aac', 'audio/x-hx-aac-adts', 'recording.aac'],
+        ];
+    }
+
+    #[DataProvider('deviceFormats')]
+    public function testEveryDeviceFormatIsAcceptedAndItsTrueLengthMeasured(string $fixture, string $detectedAs, string $clientName): void
+    {
+        $this->requireFfprobe();
+
+        $upload = AudioFixtures::upload($fixture, $clientName);
+
+        $this->assertSame($detectedAs, $upload->getMimeType(), 'PHP now reports a different type for this file; the allow-list may need to follow.');
+
+        $result = $this->uploader()->validate($upload, null);
+
+        $this->assertTrue($result['valid'], $result['message']);
+        $this->assertTrue($result['verified'], 'The length should have been measured from the file.');
+        $this->assertEqualsWithDelta(6, $result['duration'], 1);
+    }
+
+    #[DataProvider('deviceFormats')]
+    public function testEveryDeviceFormatIsAcceptedWithoutFfprobeToo(string $fixture, string $detectedAs, string $clientName): void
+    {
+        $result = $this->uploader(verifyWithFfprobe: false)->validate(AudioFixtures::upload($fixture, $clientName), 6);
+
+        $this->assertTrue($result['valid'], $result['message']);
+        $this->assertFalse($result['verified']);
+        $this->assertSame(6, $result['duration'], 'Without ffprobe the browser\'s reported length is all there is.');
+    }
+
+    public function testAudioOnlyWebmAndMp4AreAllowedEvenThoughPhpCallsThemVideo(): void
+    {
+        // The regression this guards: the allow-list once held only audio/* types, so every Chrome recording was refused.
+        $allowed = (new CbsRadio())->voiceNoteAllowedMimeTypes;
+
+        $this->assertContains('video/webm', $allowed);
+        $this->assertContains('video/mp4', $allowed);
+        $this->assertContains('audio/x-m4a', $allowed);
+        $this->assertContains('audio/x-hx-aac-adts', $allowed);
+    }
+
+    public function testTheFileExtensionIsMatchedIgnoringCase(): void
+    {
+        $result = $this->uploader(verifyWithFfprobe: false)->validate(AudioFixtures::upload('recording.mp3', 'RECORDING.MP3'), 6);
+
+        $this->assertTrue($result['valid'], $result['message']);
+    }
+
+    // ------------------------------------------------------------------ what is not a voice note
+
+    public function testATextFileIsRefused(): void
+    {
+        $result = $this->uploader(verifyWithFfprobe: false)->validate(AudioFixtures::upload('not-audio.txt', 'note.txt'), 6);
+
+        $this->assertFalse($result['valid']);
+        $this->assertStringContainsString("isn't a type of audio we can use", $result['message']);
+    }
+
+    public function testATextFileWithAnAudioNameIsStillRefused(): void
+    {
+        $result = $this->uploader(verifyWithFfprobe: false)->validate(AudioFixtures::upload('not-audio.txt', 'lovely-voice.mp3', 'audio/mpeg'), 6);
+
+        $this->assertFalse($result['valid'], 'The name and the type the browser claims must not decide; the contents do.');
+        $this->assertStringContainsString("isn't a type of audio we can use", $result['message']);
+    }
+
+    public function testRandomBytesAreRefused(): void
+    {
+        $result = $this->uploader(verifyWithFfprobe: false)->validate(AudioFixtures::upload('random-bytes.bin', 'voice.webm', 'audio/webm'), 6);
+
+        $this->assertFalse($result['valid']);
+    }
+
+    #[DataProvider('dangerousNames')]
+    public function testRealAudioUnderADangerousNameIsRefused(string $clientName): void
+    {
+        $result = $this->uploader(verifyWithFfprobe: false)->validate(AudioFixtures::upload('chrome-recording.webm', $clientName), 6);
+
+        $this->assertFalse($result['valid']);
+        $this->assertStringContainsString("file name doesn't look like an audio recording", $result['message']);
+    }
+
+    /**
+     * @return array<string, array{0: string}>
+     */
+    public static function dangerousNames(): array
+    {
+        return [
+            'a php file'        => ['voice.php'],
+            'a double extension' => ['voice.webm.php'],
+            'an executable'     => ['voice.exe'],
+            'an mp4 video name' => ['clip.mp4'],
+            'no extension'      => ['voice'],
+        ];
+    }
+
+    public function testARealVideoWithASoundTrackIsRefusedWhenTheFileCanBeOpened(): void
+    {
+        $this->requireFfprobe();
+
+        $result = $this->uploader()->validate(AudioFixtures::upload('video-with-sound.m4a', 'voice.m4a'), null);
+
+        $this->assertFalse($result['valid']);
+        $this->assertStringContainsString('looks like a video', $result['message']);
+    }
+
+    public function testWithoutFfprobeARealVideoIsNotCaughtAndThatIsADocumentedLimit(): void
+    {
+        // Pinned so the limit is explicit: without ffprobe, type, extension, size and the browser's own length are
+        // all that can be checked, and a video in an MP4 container passes them. Moderators hear every note anyway.
+        $result = $this->uploader(verifyWithFfprobe: false)->validate(AudioFixtures::upload('video-with-sound.m4a', 'voice.m4a'), 6);
+
+        $this->assertTrue($result['valid']);
+    }
+
+    public function testATruncatedFileIsRefusedWhenTheFileCanBeOpened(): void
+    {
+        $this->requireFfprobe();
+
+        $result = $this->uploader()->validate(AudioFixtures::upload('truncated.mp3', 'voice.mp3'), 6);
+
+        $this->assertFalse($result['valid']);
+        $this->assertNotSame('', $result['message']);
+    }
+
+    // ------------------------------------------------------------------ length
+
+    public function testTheLengthIsMeasuredFromTheFileNotTakenFromTheBrowser(): void
+    {
+        $this->requireFfprobe();
+
+        $liar = $this->uploader()->validate(AudioFixtures::upload('chrome-recording.webm', 'voice.webm'), 100);
+
+        $this->assertTrue($liar['valid'], 'A 6-second note claiming 100 seconds is a 6-second note.');
+        $this->assertSame(6, $liar['duration']);
+        $this->assertTrue($liar['verified']);
+
+        $understated = $this->uploader()->validate(AudioFixtures::upload('too-long-40s.webm', 'voice.webm'), 10);
+
+        $this->assertFalse($understated['valid'], 'A 40-second note claiming 10 seconds is still 40 seconds.');
+    }
+
+    public function testATooLongNoteIsRefusedWithBothNumbers(): void
+    {
+        $this->requireFfprobe();
+
+        $result = $this->uploader()->validate(AudioFixtures::upload('too-long-40s.webm', 'voice.webm'), null);
+
+        $this->assertFalse($result['valid']);
+        $this->assertSame('Your voice note is 40 seconds long. The longest allowed is 30 seconds.', $result['message']);
+    }
+
+    public function testATooShortNoteIsRefusedWithBothNumbers(): void
+    {
+        $this->requireFfprobe();
+
+        $result = $this->uploader()->validate(AudioFixtures::upload('too-short-2s.webm', 'voice.webm'), null);
+
+        $this->assertFalse($result['valid']);
+        $this->assertSame('Your voice note is 2 seconds long. It needs to be at least 5 seconds.', $result['message']);
+    }
+
+    public function testTheLimitsComeFromTheConfiguration(): void
+    {
+        $this->requireFfprobe();
+
+        $result = $this->uploader(['voiceNoteMaxSeconds' => 45])->validate(AudioFixtures::upload('too-long-40s.webm', 'voice.webm'), null);
+
+        $this->assertTrue($result['valid'], 'Raising the maximum to 45 seconds should let a 40-second note through.');
+        $this->assertSame(40, $result['duration']);
+    }
+
+    public function testAFractionOfASecondOutsideTheLimitsIsForgiven(): void
+    {
+        $this->requireFfprobe();
+
+        // The recorder's clock and the finished file can differ by a little, so 6 seconds against a minimum of 6
+        // or a maximum of 6 must pass, but a whole second out must not.
+        $this->assertTrue($this->uploader(['voiceNoteMinSeconds' => 6])->validate(AudioFixtures::upload('chrome-recording.webm', 'a.webm'), null)['valid']);
+        $this->assertTrue($this->uploader(['voiceNoteMaxSeconds' => 6])->validate(AudioFixtures::upload('chrome-recording.webm', 'a.webm'), null)['valid']);
+
+        $tooShort = $this->uploader(['voiceNoteMinSeconds' => 7])->validate(AudioFixtures::upload('chrome-recording.webm', 'a.webm'), null);
+        $this->assertFalse($tooShort['valid']);
+        $this->assertSame('Your voice note is 6 seconds long. It needs to be at least 7 seconds.', $tooShort['message']);
+
+        $tooLong = $this->uploader(['voiceNoteMaxSeconds' => 5])->validate(AudioFixtures::upload('chrome-recording.webm', 'a.webm'), null);
+        $this->assertFalse($tooLong['valid']);
+        $this->assertSame('Your voice note is 6 seconds long. The longest allowed is 5 seconds.', $tooLong['message']);
+    }
+
+    // ------------------------------------------------------------------ length without ffprobe: the browser's word is all there is
+
+    #[DataProvider('claimedLengths')]
+    public function testWithoutFfprobeTheBrowsersReportedLengthIsChecked(?int $claimed, bool $valid, ?string $message): void
+    {
+        $result = $this->uploader(verifyWithFfprobe: false)->validate(AudioFixtures::upload('chrome-recording.webm', 'voice.webm'), $claimed);
+
+        $this->assertSame($valid, $result['valid']);
+
+        if ($message !== null) {
+            $this->assertSame($message, $result['message']);
+        }
+    }
+
+    /**
+     * @return array<string, array{0: int|null, 1: bool, 2: string|null}>
+     */
+    public static function claimedLengths(): array
+    {
+        return [
+            'inside the limits'              => [6, true, null],
+            'no length reported'             => [null, true, null],
+            'exactly the minimum'            => [5, true, null],
+            'exactly the maximum'            => [30, true, null],
+            'one second too long'            => [31, false, 'Your voice note is 31 seconds long. The longest allowed is 30 seconds.'],
+            'far too long'                   => [100, false, 'Your voice note is 100 seconds long. The longest allowed is 30 seconds.'],
+            'too short'                      => [2, false, 'Your voice note is 2 seconds long. It needs to be at least 5 seconds.'],
+            'one second is singular'         => [1, false, 'Your voice note is 1 second long. It needs to be at least 5 seconds.'],
+            'zero seconds'                   => [0, false, 'Your voice note is 0 seconds long. It needs to be at least 5 seconds.'],
+        ];
+    }
+
+    public function testWithoutAReportedLengthTheStoredLengthIsUnknown(): void
+    {
+        $result = $this->uploader(verifyWithFfprobe: false)->validate(AudioFixtures::upload('chrome-recording.webm', 'voice.webm'), null);
+
+        $this->assertTrue($result['valid']);
+        $this->assertNull($result['duration']);
+    }
+
+    // ------------------------------------------------------------------ ffprobe availability
+
+    public function testAMissingFfprobeFallsBackToTheBrowsersLengthAndRecoversWhenFound(): void
+    {
+        $this->requireFfprobe();
+
+        $missing = $this->uploader(['voiceNoteFfprobePath' => '/nonexistent/ffprobe'])
+            ->validate(AudioFixtures::upload('chrome-recording.webm', 'a.webm'), 6);
+
+        $this->assertTrue($missing['valid']);
+        $this->assertFalse($missing['verified'], 'Nothing could be measured, so nothing is claimed to be verified.');
+
+        // The answer is remembered per path, not per process: asking about the real ffprobe afterwards must work.
+        $found = $this->uploader()->validate(AudioFixtures::upload('chrome-recording.webm', 'a.webm'), 6);
+
+        $this->assertTrue($found['verified']);
+    }
+
+    // ------------------------------------------------------------------ size
+
+    public function testAFileOverTheSizeLimitIsRefusedWithBothSizes(): void
+    {
+        $result = $this->uploader(['voiceNoteMaxSizeKB' => 10], false)->validate(AudioFixtures::upload('recording.wav', 'voice.wav'), 6);
+
+        $this->assertFalse($result['valid']);
+        $this->assertSame('Your voice note is 47 KB. The largest allowed is 10 KB. Try a shorter recording.', $result['message']);
+    }
+
+    #[DataProvider('sizes')]
+    public function testSizesAreDescribedInPlainUnits(float $kb, string $expected): void
+    {
+        $method = new ReflectionMethod(VoiceNoteUploader::class, 'describeSize');
+
+        $this->assertSame($expected, $method->invoke($this->uploader(), $kb));
+    }
+
+    /**
+     * @return array<string, array{0: float, 1: string}>
+     */
+    public static function sizes(): array
+    {
+        return [
+            'small'              => [128, '128 KB'],
+            'just under a megabyte' => [1000, '1000 KB'],
+            'exactly one MB'     => [1024, '1 MB'],
+            'one and a half MB'  => [1536, '1.5 MB'],
+            'two MB'             => [2048, '2 MB'],
+        ];
+    }
+
+    // ------------------------------------------------------------------ the messages follow the configuration
+
+    public function testTheListOfAcceptableFormatsComesFromTheConfiguration(): void
+    {
+        $uploader = $this->uploader(['voiceNoteAllowedExtensions' => ['mp3', 'wav']], false);
+
+        $wrongType = $uploader->validate(AudioFixtures::upload('not-audio.txt', 'a.txt'), 6);
+        $this->assertStringContainsString('choose an MP3 or WAV file.', $wrongType['message']);
+
+        $wrongName = $uploader->validate(AudioFixtures::upload('chrome-recording.webm', 'a.webm'), 6);
+        $this->assertStringContainsString('Choose an MP3 or WAV file.', $wrongName['message']);
+    }
+
+    public function testTheDefaultListNamesEveryAcceptedFormat(): void
+    {
+        $result = $this->uploader(verifyWithFfprobe: false)->validate(AudioFixtures::upload('not-audio.txt', 'a.txt'), 6);
+
+        $this->assertStringContainsString('MP3, M4A, WAV, OGG, OPUS, WEBM or AAC', $result['message']);
+    }
+
+    // ------------------------------------------------------------------ uploads PHP itself refused
+
+    #[DataProvider('phpUploadErrors')]
+    public function testAnUploadPhpRefusedIsExplained(int $error, string $expected): void
+    {
+        $result = $this->uploader()->validate(AudioFixtures::failedUpload($error), 6);
+
+        $this->assertFalse($result['valid']);
+        $this->assertStringContainsString($expected, $result['message']);
+    }
+
+    /**
+     * @return array<string, array{0: int, 1: string}>
+     */
+    public static function phpUploadErrors(): array
+    {
+        return [
+            'over the server limit'        => [UPLOAD_ERR_INI_SIZE, 'larger than this server accepts'],
+            'over the form limit'          => [UPLOAD_ERR_FORM_SIZE, 'larger than this server accepts'],
+            'cut off part-way'             => [UPLOAD_ERR_PARTIAL, "didn't finish uploading"],
+            'no temporary folder'          => [UPLOAD_ERR_NO_TMP_DIR, "didn't upload properly"],
+            'could not be written'         => [UPLOAD_ERR_CANT_WRITE, "didn't upload properly"],
+        ];
+    }
+
+    // ------------------------------------------------------------------ storing and removing
+
+    public function testAValidatedNoteIsStoredUnderAGeneratedNameAndCanBeDeleted(): void
+    {
+        $uploader = $this->uploader(verifyWithFfprobe: false);
+        $upload   = AudioFixtures::upload('chrome-recording.webm', 'voice-note.webm');
+
+        $this->assertTrue($uploader->validate($upload, 6)['valid']);
+
+        $path = $uploader->store($upload);
+
+        $this->assertMatchesRegularExpression('#^' . self::STORE_SUBPATH . '/\d+_[a-f0-9]+\.webm$#', $path, 'The visitor\'s own file name must never reach disk.');
+        $this->assertFileExists(WRITEPATH . $path);
+
+        $this->assertTrue($uploader->delete($path));
+        $this->assertFileDoesNotExist(WRITEPATH . $path);
+        $this->assertFalse($uploader->delete($path), 'Deleting something already gone is a quiet false, not an error.');
+    }
+
+    public function testAFixtureIsNeverConsumedByStoringIt(): void
+    {
+        $uploader = $this->uploader(verifyWithFfprobe: false);
+
+        $uploader->store(AudioFixtures::upload('chrome-recording.webm', 'voice-note.webm'));
+
+        $this->assertFileExists(AudioFixtures::path('chrome-recording.webm'));
+    }
+
+    public function testANoteThatHasAlreadyBeenStoredIsNotAcceptedTwice(): void
+    {
+        $uploader = $this->uploader(verifyWithFfprobe: false);
+        $upload   = AudioFixtures::upload('chrome-recording.webm', 'voice-note.webm');
+
+        $uploader->store($upload);
+
+        $result = $uploader->validate($upload, 6);
+
+        $this->assertFalse($result['valid']);
+        $this->assertSame('This file has already been processed.', $result['message']);
+    }
+}
diff --git a/tests/unit/Settings/RegistryTest.php b/tests/unit/Settings/RegistryTest.php
new file mode 100644
index 0000000..19315b0
--- /dev/null
+++ b/tests/unit/Settings/RegistryTest.php
@@ -0,0 +1,257 @@
+<?php
+
+namespace Tests\Unit\Settings;
+
+use App\Libraries\Settings\Registry;
+use App\Libraries\Settings\SettingsManager;
+use Config\Notifications;
+use PHPUnit\Framework\Attributes\DataProvider;
+use ReflectionMethod;
+use Tests\Support\TestCase\UnitTestCase;
+
+/**
+ * The registry is the one list of everything an administrator may change. These tests keep it honest: every entry
+ * points at a real setting in a real config class, and the values the code ships with are values the screen would
+ * itself accept.
+ *
+ * @internal
+ */
+final class RegistryTest extends UnitTestCase
+{
+    private const TYPES = ['string', 'text', 'int', 'bool', 'select', 'list'];
+
+    public function testThereAreSettingsAndGroupsToShowThem(): void
+    {
+        $this->assertNotEmpty(Registry::definitions());
+        $this->assertSame(
+            ['general', 'site', 'payments', 'notifications', 'templates', 'bookings'],
+            array_keys(Registry::groups())
+        );
+    }
+
+    public function testEveryGroupHasAtLeastOneSetting(): void
+    {
+        foreach (array_keys(Registry::groups()) as $group) {
+            $this->assertNotEmpty(Registry::forGroup($group), "The \"{$group}\" tab would be empty.");
+        }
+    }
+
+    public function testEverySettingBelongsToAKnownGroup(): void
+    {
+        foreach (Registry::definitions() as $key => $def) {
+            $this->assertArrayHasKey($def['group'], Registry::groups(), "{$key} is in an unknown group.");
+        }
+    }
+
+    public function testEverySettingIsCompletelyDescribed(): void
+    {
+        foreach (Registry::definitions() as $key => $def) {
+            $this->assertContains($def['type'], self::TYPES, "{$key} has an unknown type.");
+            $this->assertNotSame('', trim($def['label']), "{$key} has no label.");
+            $this->assertCount(2, $def['target'], "{$key} must target [Config class, property path].");
+
+            match ($def['type']) {
+                'int'    => $this->assertTrue(isset($def['min'], $def['max']) && $def['min'] <= $def['max'], "{$key} needs a sensible min and max."),
+                'select' => $this->assertNotEmpty($def['options'] ?? [], "{$key} needs options."),
+                'list'   => $this->assertTrue(isset($def['maxItems'], $def['maxLength']), "{$key} needs maxItems and maxLength."),
+                'string', 'text' => $this->assertTrue(isset($def['maxLength']), "{$key} needs a maxLength."),
+                default  => null,
+            };
+        }
+    }
+
+    public function testEveryTargetIsARealPropertyOfARealConfigClass(): void
+    {
+        foreach (Registry::definitions() as $key => $def) {
+            [$class, $path] = $def['target'];
+            $fqcn           = 'Config\\' . $class;
+
+            $this->assertTrue(class_exists($fqcn), "{$key} targets {$fqcn}, which does not exist.");
+
+            $segments = explode('.', $path);
+            $value    = (new $fqcn())->{array_shift($segments)} ?? null;
+
+            $this->assertNotNull($value, "{$key} targets {$fqcn}::{$path}, which does not exist.");
+
+            foreach ($segments as $segment) {
+                $this->assertIsArray($value, "{$key}: {$path} goes into something that is not an array.");
+                $this->assertArrayHasKey($segment, $value, "{$key} targets {$fqcn}::{$path}, which does not exist.");
+                $value = $value[$segment];
+            }
+        }
+    }
+
+    public function testTwoSettingsNeverShareATarget(): void
+    {
+        $seen = [];
+
+        foreach (Registry::definitions() as $key => $def) {
+            $target = implode('::', $def['target']);
+
+            $this->assertArrayNotHasKey($target, $seen, "{$key} and " . ($seen[$target] ?? '?') . " both change {$target}.");
+            $seen[$target] = $key;
+        }
+    }
+
+    public function testEverySettingHasItsOwnFormFieldName(): void
+    {
+        $fields = [];
+
+        foreach (array_keys(Registry::definitions()) as $key) {
+            $field = Registry::fieldName($key);
+
+            $this->assertArrayNotHasKey($field, $fields, "{$key} and " . ($fields[$field] ?? '?') . " would share a form field.");
+            $this->assertSame($key, Registry::keyForField($field), 'A field name must lead back to its own key.');
+            $this->assertMatchesRegularExpression('/^[A-Za-z0-9_]+$/', $field);
+
+            $fields[$field] = $key;
+        }
+
+        $this->assertNull(Registry::keyForField('no_such_setting'));
+    }
+
+    /**
+     * What the code ships with must be something the administrators' own screen would accept, or the first
+     * time someone saved an unrelated change on that tab it would refuse because of a default nobody set.
+     */
+    public function testEveryDefaultValuePassesItsOwnValidation(): void
+    {
+        $validate = new ReflectionMethod(SettingsManager::class, 'validate');
+        $manager  = new SettingsManager();
+
+        foreach (Registry::definitions() as $key => $def) {
+            [$class, $path] = $def['target'];
+            $fqcn           = 'Config\\' . $class;
+
+            $segments = explode('.', $path);
+            $value    = (new $fqcn())->{array_shift($segments)};
+
+            foreach ($segments as $segment) {
+                $value = $value[$segment];
+            }
+
+            $error = $validate->invoke($manager, $def, Registry::toRaw($def, $value));
+
+            $this->assertNull($error, "The default for {$key} fails its own check: {$error}");
+        }
+    }
+
+    /**
+     * Credentials live in .env and are only ever reported as "configured: yes/no". If one ever became an entry
+     * in the registry it would be shown on screen and stored in the database.
+     */
+    public function testNoSecretIsEditableOnScreen(): void
+    {
+        foreach (Registry::definitions() as $key => $def) {
+            $this->assertDoesNotMatchRegularExpression(
+                '/api_?key|secret|password|token/i',
+                $def['target'][1],
+                "{$key} changes something that looks like a credential."
+            );
+        }
+
+        $secretEnvKeys = [];
+
+        foreach (Registry::secrets() as $group => $secrets) {
+            $this->assertArrayHasKey($group, Registry::groups());
+
+            foreach ($secrets as $secret) {
+                $this->assertArrayHasKey('env', $secret);
+                $this->assertArrayHasKey('label', $secret);
+                $secretEnvKeys[] = $secret['env'];
+            }
+        }
+
+        $this->assertContains('momo.apiKey', $secretEnvKeys);
+        $this->assertContains('sms.apiKey', $secretEnvKeys);
+        $this->assertSame([], array_values(array_intersect($secretEnvKeys, array_keys(Registry::definitions()))));
+    }
+
+    public function testEveryShippedMessageTemplateOnlyUsesKnownPlaceholders(): void
+    {
+        $templates = (new Notifications())->templates;
+
+        $this->assertNotEmpty($templates);
+
+        foreach ($templates as $event => $fields) {
+            foreach ($fields as $field => $text) {
+                preg_match_all('/\{([^{}]*)\}/', $text, $found);
+
+                $this->assertSame(
+                    [],
+                    array_values(array_diff($found[1], Registry::TEMPLATE_TOKENS)),
+                    "The shipped {$event}/{$field} template uses a placeholder the settings screen would refuse."
+                );
+            }
+        }
+    }
+
+    // ------------------------------------------------------------------ cast / toRaw / normalize
+
+    #[DataProvider('casts')]
+    public function testCast(string $type, ?string $raw, mixed $expected): void
+    {
+        $this->assertSame($expected, Registry::cast(['type' => $type], $raw));
+    }
+
+    /**
+     * @return array<string, array{0: string, 1: string|null, 2: mixed}>
+     */
+    public static function casts(): array
+    {
+        return [
+            'bool "1"'               => ['bool', '1', true],
+            'bool "true"'            => ['bool', 'true', true],
+            'bool "on"'              => ['bool', 'on', true],
+            'bool "0"'               => ['bool', '0', false],
+            'bool "false"'           => ['bool', 'false', false],
+            'bool empty'             => ['bool', '', false],
+            'bool null'              => ['bool', null, false],
+            'int'                    => ['int', '45', 45],
+            'int null is zero'       => ['int', null, 0],
+            'string untouched'       => ['string', ' keep  me ', ' keep  me '],
+            'null string is empty'   => ['string', null, ''],
+            'list by lines'          => ['list', "a\nb\nc", ['a', 'b', 'c']],
+            'list by commas'         => ['list', 'a, b ,c', ['a', 'b', 'c']],
+            'list drops blanks'      => ['list', "a\n\n , b", ['a', 'b']],
+            'list drops duplicates'  => ['list', "a\nb\na", ['a', 'b']],
+            'empty list'             => ['list', '', []],
+        ];
+    }
+
+    public function testToRawIsTheInverseOfCast(): void
+    {
+        $this->assertSame('1', Registry::toRaw(['type' => 'bool'], true));
+        $this->assertSame('0', Registry::toRaw(['type' => 'bool'], false));
+        $this->assertSame("a\nb", Registry::toRaw(['type' => 'list'], ['a', 'b']));
+        $this->assertSame('', Registry::toRaw(['type' => 'list'], []));
+        $this->assertSame('45', Registry::toRaw(['type' => 'int'], 45));
+        $this->assertSame('hello', Registry::toRaw(['type' => 'string'], 'hello'));
+    }
+
+    #[DataProvider('normalisations')]
+    public function testNormalize(array $def, mixed $input, string $expected): void
+    {
+        $this->assertSame($expected, Registry::normalize($def, $input));
+    }
+
+    /**
+     * @return array<string, array{0: array<string, string>, 1: mixed, 2: string}>
+     */
+    public static function normalisations(): array
+    {
+        return [
+            'checkbox "on"'                => [['type' => 'bool'], 'on', '1'],
+            'checkbox "YES"'               => [['type' => 'bool'], ' YES ', '1'],
+            'checkbox "1"'                 => [['type' => 'bool'], '1', '1'],
+            'checkbox "no"'                => [['type' => 'bool'], 'no', '0'],
+            'checkbox left out'            => [['type' => 'bool'], '', '0'],
+            'checkbox given an array'      => [['type' => 'bool'], ['1'], '0'],
+            'list is tidied'               => [['type' => 'list'], "b, a\n\nb", "b\na"],
+            'text: line endings unified'   => [['type' => 'text'], "one\r\ntwo\rthree  ", "one\ntwo\nthree"],
+            'currency is upper-cased'      => [['type' => 'string', 'format' => 'currency'], ' ugx ', 'UGX'],
+            'strings are trimmed'          => [['type' => 'string'], "  hello \n", 'hello'],
+            'a non-scalar becomes empty'   => [['type' => 'string'], ['x'], ''],
+        ];
+    }
+}
