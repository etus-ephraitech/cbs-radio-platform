+<?php
+
+namespace Tests\Support\Libraries;
+
+use App\Libraries\VendorGiftClients\VendorGiftClientInterface;
+use RuntimeException;
+
+/**
+ * A gift vendor that answers from a script instead of the internet: a fixed catalogue, and a chosen result for
+ * every order. Records the orders it receives so a test can check what would have been sent.
+ */
+class FakeVendorClient implements VendorGiftClientInterface
+{
+    /** @var array<int, array<string, mixed>> */
+    public array $orders = [];
+
+    /**
+     * @param array<int, array<string, mixed>> $catalog       what fetchCatalog() returns
+     * @param array<string, mixed>             $orderResult   what submitOrder() returns
+     * @param string|null                      $failCatalogWith throw this from fetchCatalog() (a vendor that is down)
+     */
+    public function __construct(
+        public array $catalog = [],
+        public array $orderResult = ['success' => true, 'vendor_order_ref' => 'V-1001', 'message' => 'Order placed with vendor.'],
+        public ?string $failCatalogWith = null,
+    ) {
+    }
+
+    public function fetchCatalog(): array
+    {
+        if ($this->failCatalogWith !== null) {
+            throw new RuntimeException($this->failCatalogWith);
+        }
+
+        return $this->catalog;
+    }
+
+    public function submitOrder(array $orderData): array
+    {
+        $this->orders[] = $orderData;
+
+        return $this->orderResult;
+    }
+}
diff --git a/tests/_support/Libraries/RecordingNotifier.php b/tests/_support/Libraries/RecordingNotifier.php
new file mode 100644
index 0000000..c12908f
--- /dev/null
+++ b/tests/_support/Libraries/RecordingNotifier.php
@@ -0,0 +1,43 @@
+<?php
+
+namespace Tests\Support\Libraries;
+
+use App\Services\NotificationService;
+
+/**
+ * A NotificationService that only writes down what it was asked to send, so tests of bookings and moderation can
+ * check that the right message was triggered without sending, or logging, anything.
+ */
+class RecordingNotifier extends NotificationService
+{
+    /** @var array<int, array{event: string, status: string|null, id: int|null}> */
+    public array $sent = [];
+
+    public function sendBookingConfirmation(array $booking): void
+    {
+        $this->record('booking_confirmation', $booking);
+    }
+
+    public function sendModerationResult(array $booking): void
+    {
+        $this->record($booking['status'] === 'approved' ? 'moderation_approved' : 'moderation_rejected', $booking);
+    }
+
+    public function sendAiredNotice(array $booking): void
+    {
+        $this->record('aired', $booking);
+    }
+
+    /**
+     * @return string[]
+     */
+    public function events(): array
+    {
+        return array_column($this->sent, 'event');
+    }
+
+    private function record(string $event, array $booking): void
+    {
+        $this->sent[] = ['event' => $event, 'status' => $booking['status'] ?? null, 'id' => isset($booking['id']) ? (int) $booking['id'] : null];
+    }
+}
