+<?php
+
+namespace Config;
+
+use CodeIgniter\Config\BaseConfig;
+
+/**
+ * Which notification channels are active, and the exact wording sent for
+ * each event. Change wording here — never inline a message string in
+ * NotificationService. Placeholders in a template are replaced with
+ * {curly-brace} tokens; see each template's comment for what's available.
+ */
+class Notifications extends BaseConfig
+{
+
+    /**
+     * Per-channel on/off switch, independent of whether a sender supplied
+     * a phone/email — NotificationService checks both before sending.
+     * Email defaults off since it's not a confirmed Phase 1 requirement;
+     * flip to true once CBS confirms they want it alongside SMS.
+     */
+    public array $channelsEnabled = [
+        'sms'   => true,
+        'email' => false,
+    ];
+
+    /**
+     * {reference}  — e.g. CBS-000123
+     * {sender_name}
+     * {recipient_name}
+     */
+    public array $templates = [
+        'booking_confirmation' => [
+            'sms'          => 'Thanks {sender_name}! Your CBS Radio greeting (ref {reference}) was received and is being reviewed.',
+            'email_subject' => 'We received your CBS Radio greeting — {reference}',
+            'email_body'    => "Hi {sender_name},\n\nThanks for your submission to CBS Radio for {recipient_name}. Your reference is {reference}. We'll let you know once it's been reviewed.\n\n— CBS Radio",
+        ],
+        'moderation_approved' => [
+            'sms'           => 'Good news {sender_name}! Your CBS Radio greeting (ref {reference}) was approved and will air soon.',
+            'email_subject' => 'Your CBS Radio greeting was approved — {reference}',
+            'email_body'    => "Hi {sender_name},\n\nGood news — your greeting for {recipient_name} (ref {reference}) was approved and will air soon.\n\n— CBS Radio",
+        ],
+        'moderation_rejected' => [
+            'sms'           => 'Your CBS Radio greeting (ref {reference}) could not be approved. Contact CBS Radio for details.',
+            'email_subject' => 'Your CBS Radio greeting needs attention — {reference}',
+            'email_body'    => "Hi {sender_name},\n\nYour greeting (ref {reference}) could not be approved as submitted. Please contact CBS Radio for details.\n\n— CBS Radio",
+        ],
+        'aired' => [
+            'sms'           => 'Your CBS Radio greeting (ref {reference}) just aired. Thank you for using CBS Radio!',
+            'email_subject' => 'Your CBS Radio greeting just aired — {reference}',
+            'email_body'    => "Hi {sender_name},\n\nYour greeting for {recipient_name} (ref {reference}) just aired. Thank you for using CBS Radio!\n\n— CBS Radio",
+        ],
+    ];
+
+    /** What recipients see as the SMS sender. Alphanumeric senders are limited to 11 characters. */
+    public string $smsSenderId = 'CBSRADIO';
+
+    /** Empty means "use the address and name from .env (Config\Email)". */
+    public string $emailFromAddress = '';
+    public string $emailFromName    = '';
+
+    public function __construct()
+    {
+        parent::__construct();
+
+        $this->smsSenderId      = (string) env('sms.senderId', $this->smsSenderId);
+        $this->emailFromAddress = (string) env('notifications.emailFromAddress', $this->emailFromAddress);
+        $this->emailFromName    = (string) env('notifications.emailFromName', $this->emailFromName);
+
+        $smsEnabled   = env('notifications.smsEnabled');
+        $emailEnabled = env('notifications.emailEnabled');
+
+        if ($smsEnabled !== null) {
+            $this->channelsEnabled['sms'] = filter_var($smsEnabled, FILTER_VALIDATE_BOOLEAN);
+        }
+
+        if ($emailEnabled !== null) {
+            $this->channelsEnabled['email'] = filter_var($emailEnabled, FILTER_VALIDATE_BOOLEAN);
+        }
+
+    }
+
+    /**
+     * Fill a template string's {placeholder} tokens.
+     */
+    public function render(string $template, array $tokens): string
+    {
+        $replacements = [];
+
+        foreach ($tokens as $key => $value) {
+            $replacements['{' . $key . '}'] = $value;
+        }
+
+        return strtr($template, $replacements);
+    }
+}
diff --git a/app/Libraries/FileManager.php b/app/Libraries/FileManager.php
new file mode 100644
index 0000000..1f3ee80
--- /dev/null
+++ b/app/Libraries/FileManager.php
@@ -0,0 +1,101 @@
+<?php
+
+namespace App\Libraries;
+
+use CodeIgniter\HTTP\Files\UploadedFile;
+use CodeIgniter\HTTP\ResponseInterface;
+
+/**
+ * Generic file storage under writable/, used by any upload type (voice
+ * notes today; gift e-card assets, attachments, etc. later) so storage
+ * logic lives in one place instead of being copy-pasted per feature.
+ *
+ * IMPORTANT: writable/ is deliberately not web-accessible (CI4 convention,
+ * and correct for us — voice notes include personal content and shouldn't
+ * be guessable URLs). To let the browser play/download a file, route a
+ * controller action through streamInline() below rather than linking to
+ * the file directly.
+ */
+class FileManager
+{
+    /**
+     * Moves a validated upload into writable/{subdirectory}/ under a
+     * randomly generated name, creating the directory if needed. Returns
+     * the path relative to writable/, which is what should be stored on
+     * the owning DB row — never the absolute filesystem path.
+     */
+    public function store(UploadedFile $file, string $subdirectory): string
+    {
+        $targetDir = $this->fullPath($subdirectory);
+
+        if (! is_dir($targetDir)) {
+            mkdir($targetDir, 0755, true);
+        }
+
+        $newName = $file->getRandomName();
+        $file->move($targetDir, $newName);
+
+        return trim($subdirectory, '/') . '/' . $newName;
+    }
+
+    public function delete(string $relativePath): bool
+    {
+        $full = $this->fullPath($relativePath);
+
+        if (is_file($full)) {
+            return unlink($full);
+        }
+
+        return false;
+    }
+
+    public function exists(string $relativePath): bool
+    {
+        return is_file($this->fullPath($relativePath));
+    }
+
+    public function sizeKB(string $relativePath): float
+    {
+        $full = $this->fullPath($relativePath);
+
+        return is_file($full) ? filesize($full) / 1024 : 0.0;
+    }
+
+    /**
+     * Absolute filesystem path for a path relative to writable/.
+     */
+    public function fullPath(string $relativePath): string
+    {
+        return rtrim(WRITEPATH, '/') . '/' . ltrim($relativePath, '/');
+    }
+
+    /**
+     * Builds a Response that streams a stored file inline (e.g. in-browser
+     * audio playback of a voice note in the presenter portal), to be
+     * returned directly from a controller action — CI4 then sends it the
+     * normal way, rather than this library writing raw output itself.
+     *
+     * Usage in a controller:
+     *   public function playVoiceNote(int $bookingId)
+     *   {
+     *       $booking = $this->bookingModel->find($bookingId);
+     *       return (new FileManager())->streamInline($this->response, $booking['voice_note_path']);
+     *   }
+     */
+    public function streamInline(ResponseInterface $response, string $relativePath): ResponseInterface
+    {
+        $full = $this->fullPath($relativePath);
+
+        if (! is_file($full)) {
+            throw \CodeIgniter\Exceptions\PageNotFoundException::forPageNotFound();
+        }
+
+        $mime = mime_content_type($full) ?: 'application/octet-stream';
+
+        return $response
+            ->setHeader('Content-Type', $mime)
+            ->setHeader('Content-Disposition', 'inline; filename="' . basename($full) . '"')
+            ->setHeader('Cache-Control', 'private, max-age=0, must-revalidate')
+            ->setBody(file_get_contents($full));
+    }
+}
diff --git a/app/Libraries/MessageSanitizer.php b/app/Libraries/MessageSanitizer.php
new file mode 100644
index 0000000..d7cc747
--- /dev/null
+++ b/app/Libraries/MessageSanitizer.php
@@ -0,0 +1,140 @@
+<?php
+
+namespace App\Libraries;
+
+use Config\CbsRadio;
+
+/**
+ * Sanitizes and validates user-submitted booking text (message_text,
+ * recipient_name), and flags messages containing CBS's own configured
+ * moderation terms for priority review. All limits/terms come from
+ * Config\CbsRadio — change them there, not here.
+ */
+class MessageSanitizer
+{
+    protected CbsRadio $config;
+
+    public function __construct(?CbsRadio $config = null)
+    {
+        $this->config = $config ?? config('CbsRadio');
+    }
+
+    /**
+     * Strips tags and normalizes whitespace. Run this on message_text and
+     * recipient_name before they ever reach the database.
+     */
+    public function sanitize(string $text): string
+    {
+        $text = strip_tags($text);
+        $text = preg_replace('/\s+/', ' ', $text);
+
+        return trim($text);
+    }
+
+    /**
+     * @return array{valid: bool, message: string, sanitized: string}
+     */
+    public function validateMessage(string $text): array
+    {
+        $sanitized = $this->sanitize($text);
+
+        if ($sanitized === '') {
+            return ['valid' => false, 'message' => 'Message cannot be empty.', 'sanitized' => $sanitized];
+        }
+
+        // The message editor's "start from an example" fills in names when it can and
+        // otherwise leaves one of these markers. Reading one out on air would be
+        // embarrassing, so a message that still has one is sent back.
+        if (($marker = $this->unfilledPlaceholder($sanitized)) !== null) {
+            return [
+                'valid'     => false,
+                'message'   => "Replace {$marker} with a name before sending.",
+                'sanitized' => $sanitized,
+            ];
+        }
+
+        if (mb_strlen($sanitized) > $this->config->messageMaxLength) {
+            return [
+                'valid'     => false,
+                'message'   => 'Message is too long (max ' . $this->config->messageMaxLength . ' characters).',
+                'sanitized' => $sanitized,
+            ];
+        }
+
+        return ['valid' => true, 'message' => '', 'sanitized' => $sanitized];
+    }
+
+    /** The markers the message editor leaves when it could not fill a name in. */
+    public const PLACEHOLDERS = ['[their name]', '[your name]'];
+
+    /**
+     * The first unfilled marker still in the text, or null.
+     */
+    public function unfilledPlaceholder(string $text): ?string
+    {
+        foreach (self::PLACEHOLDERS as $marker) {
+            if (stripos($text, $marker) !== false) {
+                return $marker;
+            }
+        }
+
+        return null;
+    }
+
+    /**
+     * @return array{valid: bool, message: string, sanitized: string}
+     */
+    public function validateRecipientName(string $text): array
+    {
+        $sanitized = $this->sanitize($text);
+
+        if ($sanitized === '') {
+            return ['valid' => false, 'message' => 'Recipient name cannot be empty.', 'sanitized' => $sanitized];
+        }
+
+        if (mb_strlen($sanitized) > $this->config->recipientNameMaxLength) {
+            return [
+                'valid'     => false,
+                'message'   => 'Recipient name is too long (max ' . $this->config->recipientNameMaxLength . ' characters).',
+                'sanitized' => $sanitized,
+            ];
+        }
+
+        return ['valid' => true, 'message' => '', 'sanitized' => $sanitized];
+    }
+
+    /**
+     * Returns which configured flag terms (if any) appear in the message,
+     * for the booking flow to pass into moderation_logs or
+     * bookings.moderation_notes as a heads-up. This never blocks
+     * submission — it only helps a human moderator prioritize; the
+     * decision stays with them, which matters most for tributes where
+     * the same word can be perfectly appropriate or not depending on
+     * context.
+     *
+     * @return string[] matched terms, empty if none or no terms configured
+     */
+    public function flaggedTerms(string $text): array
+    {
+        if (empty($this->config->moderationFlagTerms)) {
+            return [];
+        }
+
+        $normalized = mb_strtolower($text);
+        $matches    = [];
+
+        foreach ($this->config->moderationFlagTerms as $term) {
+            $term = mb_strtolower(trim($term));
+
+            if ($term === '') {
+                continue;
+            }
+
+            if (preg_match('/\b' . preg_quote($term, '/') . '\b/u', $normalized)) {
+                $matches[] = $term;
+            }
+        }
+
+        return $matches;
+    }
+}
diff --git a/app/Libraries/VoiceNoteUploader.php b/app/Libraries/VoiceNoteUploader.php
new file mode 100644
index 0000000..defcd19
--- /dev/null
+++ b/app/Libraries/VoiceNoteUploader.php
@@ -0,0 +1,253 @@
+<?php
+
+namespace App\Libraries;
+
+use Config\CbsRadio;
+use CodeIgniter\HTTP\Files\UploadedFile;
+
+/**
+ * Validates and stores a booking's optional voice note upload. All limits
+ * come from Config\CbsRadio — change them there, not here.
+ *
+ * KNOWN LIMITATION: true server-side audio duration detection requires an
+ * extension this project doesn't currently depend on (e.g. getID3, or
+ * shelling out to ffprobe). Until one is added, duration is taken from
+ * $clientReportedSeconds — the browser's MediaRecorder API reports this
+ * accurately for a freshly-recorded clip, but a tampered or re-uploaded
+ * file could misreport it. For Phase 1 this is an acceptable trade-off
+ * given the low stakes (worst case: a slightly-too-long clip reaches
+ * moderation, where a human reviews it anyway); revisit if abuse shows up.
+ */
+class VoiceNoteUploader
+{
+    protected CbsRadio $config;
+    protected FileManager $fileManager;
+
+    public function __construct(?CbsRadio $config = null, ?FileManager $fileManager = null)
+    {
+        $this->config      = $config ?? config('CbsRadio');
+        $this->fileManager = $fileManager ?? new FileManager();
+    }
+
+    /**
+     * Checks an uploaded voice note and, when it passes, says how long it
+     * really is.
+     *
+     * Checked in order: the upload itself; the file type (by what PHP
+     * detects, not by what the browser claims); the file name's extension;
+     * the size; and the length. When the server has ffprobe, the file is
+     * also opened to confirm it is a playable audio recording and to measure
+     * its true length, so the browser's reported length is only a fallback
+     * for servers without it.
+     *
+     * 'duration' is whole seconds — measured when 'verified' is true,
+     * otherwise whatever the browser reported (or null if it reported none).
+     *
+     * @return array{valid: bool, message: string, duration: ?int, verified: bool}
+     */
+    public function validate(UploadedFile $file, ?int $clientReportedSeconds): array
+    {
+        $fail = static fn (string $message): array => ['valid' => false, 'message' => $message, 'duration' => null, 'verified' => false];
+
+        if (! $file->isValid()) {
+            return $fail(match ($file->getError()) {
+                UPLOAD_ERR_INI_SIZE, UPLOAD_ERR_FORM_SIZE => 'Your voice note is larger than this server accepts. Try a shorter recording.',
+                UPLOAD_ERR_PARTIAL                        => "Your voice note didn't finish uploading. Check your connection and try again.",
+                default                                   => "The voice note didn't upload properly. Please record it again.",
+            });
+        }
+
+        if ($file->hasMoved()) {
+            return $fail('This file has already been processed.');
+        }
+
+        if (! in_array($file->getMimeType(), $this->config->voiceNoteAllowedMimeTypes, true)) {
+            return $fail("That file isn't a type of audio we can use. Record it again, or choose an " . $this->describeFormats() . ' file.');
+        }
+
+        $extension = strtolower($file->getClientExtension());
+
+        if (! in_array($extension, $this->config->voiceNoteAllowedExtensions, true)) {
+            return $fail("That file name doesn't look like an audio recording. Choose an " . $this->describeFormats() . ' file.');
+        }
+
+        $sizeKB = $file->getSize() / 1024;
+
+        if ($sizeKB > $this->config->voiceNoteMaxSizeKB) {
+            return $fail('Your voice note is ' . $this->describeSize($sizeKB) . '. The largest allowed is '
+                . $this->describeSize($this->config->voiceNoteMaxSizeKB) . '. Try a shorter recording.');
+        }
+
+        $seconds  = $clientReportedSeconds !== null ? (float) $clientReportedSeconds : null;
+        $verified = false;
+        $inspect  = $this->inspect($file->getRealPath());
+
+        if ($inspect !== null) {
+            if (! $inspect['audio']) {
+                return $fail("That file doesn't contain a playable audio recording.");
+            }
+
+            if ($inspect['video']) {
+                return $fail('That looks like a video, not a voice note. Please send an audio recording.');
+            }
+
+            if ($inspect['duration'] !== null) {
+                $seconds  = $inspect['duration'];
+                $verified = true;
+            }
+        }
+
+        if ($seconds !== null) {
+            // The recorder's timer and the finished file can differ by a
+            // fraction of a second, so a hair under the minimum or over the
+            // maximum is let through rather than rejecting a correct recording.
+            $tolerance = 0.75;
+            $shown     = (int) round($seconds);
+
+            if ($seconds < $this->config->voiceNoteMinSeconds - $tolerance) {
+                return $fail("Your voice note is {$shown} second" . ($shown === 1 ? '' : 's') . ' long. It needs to be at least '
+                    . $this->config->voiceNoteMinSeconds . ' seconds.');
+            }
+
+            if ($seconds > $this->config->voiceNoteMaxSeconds + $tolerance) {
+                return $fail("Your voice note is {$shown} seconds long. The longest allowed is "
+                    . $this->config->voiceNoteMaxSeconds . ' seconds.');
+            }
+        }
+
+        return [
+            'valid'    => true,
+            'message'  => '',
+            'duration' => $seconds !== null ? (int) round($seconds) : null,
+            'verified' => $verified,
+        ];
+    }
+
+    /**
+     * Opens the file with ffprobe, if this server has it, and reports whether
+     * it holds audio, whether it holds (non-cover-art) video, and how long
+     * it is. Returns null when ffprobe can't be used — not installed, not
+     * allowed to run programs, or switched off — in which case the caller
+     * falls back to the length the browser reported.
+     *
+     * Browsers' WebM recordings carry no duration in the header, so when the
+     * header has none the length is taken from the last audio packet.
+     *
+     * @return array{audio: bool, video: bool, duration: ?float}|null
+     */
+    protected function inspect(string $path): ?array
+    {
+        if (! $this->config->voiceNoteVerifyWithFfprobe || ! $this->ffprobeUsable()) {
+            return null;
+        }
+
+        $bin = escapeshellcmd($this->config->voiceNoteFfprobePath);
+        $arg = escapeshellarg($path);
+
+        exec("timeout 10 {$bin} -v error -show_entries stream=codec_type:stream_disposition=attached_pic:format=duration -of json {$arg} 2>/dev/null", $lines, $code);
+
+        if ($code === 124 || $code === 127) {
+            return null; // timed out, or `timeout`/ffprobe isn't there after all: can't tell
+        }
+
+        $data = json_decode(implode("\n", $lines), true);
+
+        if ($code !== 0 || ! is_array($data)) {
+            return ['audio' => false, 'video' => false, 'duration' => null]; // ffprobe could not read it as media at all
+        }
+
+        $audio = false;
+        $video = false;
+
+        foreach ($data['streams'] ?? [] as $stream) {
+            if (($stream['codec_type'] ?? '') === 'audio') {
+                $audio = true;
+            } elseif (($stream['codec_type'] ?? '') === 'video' && empty($stream['disposition']['attached_pic'])) {
+                $video = true; // an attached picture (album art) is not a video
+            }
+        }
+
+        $duration = isset($data['format']['duration']) && is_numeric($data['format']['duration'])
+            ? (float) $data['format']['duration']
+            : null;
+
+        if ($duration === null && $audio) {
+            $lines = [];
+            exec("timeout 10 {$bin} -v error -select_streams a:0 -show_entries packet=pts_time,duration_time -of csv=p=0 {$arg} 2>/dev/null", $lines);
+
+            $last = null;
+
+            foreach (array_reverse($lines) as $line) {
+                $parts = explode(',', trim($line));
+
+                if (is_numeric($parts[0])) { // explode() always returns at least one element
+                    $last = (float) $parts[0] + (isset($parts[1]) && is_numeric($parts[1]) ? (float) $parts[1] : 0.0);
+                    break;
+                }
+            }
+
+            $duration = $last;
+        }
+
+        return ['audio' => $audio, 'video' => $video, 'duration' => $duration];
+    }
+
+    /**
+     * Whether we may run ffprobe here: running programs is allowed and the
+     * binary exists. Worked out once per request.
+     */
+    protected function ffprobeUsable(): bool
+    {
+        static $usable = null;
+
+        if ($usable !== null) {
+            return $usable;
+        }
+
+        $disabled = array_map('trim', explode(',', (string) ini_get('disable_functions')));
+
+        if (! function_exists('exec') || in_array('exec', $disabled, true)) {
+            return $usable = false;
+        }
+
+        exec('command -v ' . escapeshellarg($this->config->voiceNoteFfprobePath) . ' 2>/dev/null', $out, $code);
+
+        return $usable = ($code === 0);
+    }
+
+    /** "MP3, M4A and OGG"-style list of the formats configured as acceptable, so every message agrees with the settings. */
+    protected function describeFormats(): string
+    {
+        $list = array_map('strtoupper', $this->config->voiceNoteAllowedExtensions);
+        $last = array_pop($list);
+
+        return $list === [] ? (string) $last : implode(', ', $list) . ' or ' . $last;
+    }
+
+    protected function describeSize(float $kb): string
+    {
+        return $kb >= 1024 ? rtrim(rtrim(number_format($kb / 1024, 1), '0'), '.') . ' MB' : (int) round($kb) . ' KB';
+    }
+
+    /**
+     * Moves a validated upload into the configured voice-notes directory
+     * under a randomly generated name, and returns the relative path to
+     * store on the booking row. Delegates the actual filesystem work to
+     * FileManager so storage logic isn't duplicated per upload type.
+     *
+     * Call validate() first — this method does not re-check limits.
+     */
+    public function store(UploadedFile $file): string
+    {
+        return $this->fileManager->store($file, $this->config->voiceNoteUploadSubpath);
+    }
+
+    /**
+     * Deletes a stored voice note — e.g. when a booking is rejected or
+     * cancelled and its attachment should be cleaned up.
+     */
+    public function delete(string $relativePath): bool
+    {
+        return $this->fileManager->delete($relativePath);
+    }
+}
-- 
