+++ b/tests/database/Models/GiftModelsTest.php
@@ -0,0 +1,179 @@
+<?php
+
+namespace Tests\Database\Models;
+
+use App\Models\GiftModel;
+use App\Models\GiftOrderModel;
+use Tests\Support\TestCase\AppTestCase;
+
+/**
+ * The gift catalogue, and the orders placed against it.
+ *
+ * @internal
+ */
+final class GiftModelsTest extends AppTestCase
+{
+    // ------------------------------------------------------------------ gifts
+
+    public function testActiveGiftsAreSortedByNameAndCarryTheirVendorsName(): void
+    {
+        $vendor = $this->makeVendor(['name' => 'Acme Flowers']);
+
+        $this->makeGift(['name' => 'Rose bouquet', 'type' => 'physical', 'source' => 'vendor', 'vendor_id' => $vendor['id']]);
+        $this->makeGift(['name' => 'Birthday e-card']);
+        $this->makeGift(['name' => 'Retired', 'is_active' => 0]);
+
+        $gifts = (new GiftModel())->active();
+
+        $this->assertSame(['Birthday e-card', 'Rose bouquet'], array_column($gifts, 'name'));
+        $this->assertNull($gifts[0]['vendor_name'], 'A gift of our own has no vendor.');
+        $this->assertSame('Acme Flowers', $gifts[1]['vendor_name']);
+    }
+
+    public function testGiftsCanBeFilteredByTypeAmongActiveOnes(): void
+    {
+        $this->makeGift(['name' => 'Card', 'type' => 'ecard']);
+        $this->makeGift(['name' => 'Airtime 5k', 'type' => 'airtime']);
+        $this->makeGift(['name' => 'Old card', 'type' => 'ecard', 'is_active' => 0]);
+
+        $this->assertSame(['Card'], array_column((new GiftModel())->byType('ecard'), 'name'));
+    }
+
+    public function testOurOwnGiftsAndVendorGiftsAreListedSeparately(): void
+    {
+        $vendor = $this->makeVendor(['name' => 'Zed']);
+
+        $this->makeGift(['name' => 'Ours B']);
+        $this->makeGift(['name' => 'Ours A']);
+        $this->makeGift(['name' => 'Theirs', 'type' => 'physical', 'source' => 'vendor', 'vendor_id' => $vendor['id']]);
+
+        $model = new GiftModel();
+
+        $this->assertSame(['Ours A', 'Ours B'], array_column($model->localOnly(), 'name'));
+        $this->assertSame(['Theirs'], array_column($model->vendorSourced(), 'name'));
+        $this->assertSame('Zed', $model->vendorSourced()[0]['vendor_name']);
+    }
+
+    public function testAVendorGiftIsFoundByItsVendorsProductReference(): void
+    {
+        $vendor = $this->makeVendor();
+        $other  = $this->makeVendor();
+
+        $gift = $this->makeGift(['type' => 'physical', 'source' => 'vendor', 'vendor_id' => $vendor['id'], 'vendor_product_ref' => 'SKU-1']);
+
+        $model = new GiftModel();
+
+        $this->assertSame($gift['id'], $model->findByVendorProduct((int) $vendor['id'], 'SKU-1')['id']);
+        $this->assertNull($model->findByVendorProduct((int) $other['id'], 'SKU-1'), 'The same reference at another vendor is a different product.');
+        $this->assertNull($model->findByVendorProduct((int) $vendor['id'], 'SKU-2'));
+    }
+
+    public function testEveryGiftTypeIsAccepted(): void
+    {
+        foreach (['ecard', 'airtime', 'shoutout', 'dedication', 'physical'] as $type) {
+            $this->assertNotFalse((new GiftModel())->insert(['name' => "A {$type}", 'type' => $type, 'price' => 100]), $type);
+        }
+    }
+
+    public function testAnUnknownGiftTypeOrSourceIsRefused(): void
+    {
+        $model = new GiftModel();
+
+        $this->assertFalse($model->insert(['name' => 'X', 'type' => 'puppy', 'price' => 100]));
+        $this->assertFalse($model->insert(['name' => 'X', 'type' => 'ecard', 'price' => 100, 'source' => 'stolen']));
+    }
+
+    // ------------------------------------------------------------------ gift orders
+
+    public function testStandaloneOrdersAreThoseNotAttachedToABooking(): void
+    {
+        $booking = $this->makeBooking();
+
+        $alone    = $this->makeGiftOrder(['recipient_name' => 'On its own']);
+        $attached = $this->makeGiftOrder(['recipient_name' => 'With a greeting', 'booking_id' => $booking['id']]);
+
+        $model = new GiftOrderModel();
+
+        $this->assertSame([$alone['id']], array_column($model->standalone(), 'id'));
+        $this->assertSame([$attached['id']], array_column($model->forBooking((int) $booking['id']), 'id'));
+    }
+
+    public function testTheAdminListCarriesTheGiftAndFiltersByStatus(): void
+    {
+        $gift = $this->makeGift(['name' => 'Birthday e-card']);
+
+        $paid    = $this->makeGiftOrder(['gift_id' => $gift['id'], 'status' => GiftOrderModel::STATUS_PAID]);
+        $pending = $this->makeGiftOrder(['gift_id' => $gift['id']]);
+
+        $model = new GiftOrderModel();
+
+        $all = $model->adminList();
+        $this->assertCount(2, $all);
+        $this->assertSame('Birthday e-card', $all[0]['gift_name']);
+        $this->assertSame('local', $all[0]['gift_source']);
+
+        $this->assertSame([$paid['id']], array_column($model->adminList('paid'), 'id'));
+        $this->assertSame([$pending['id']], array_column($model->adminList('pending_payment'), 'id'));
+    }
+
+    public function testABookingsOrdersComeWithTheGiftsName(): void
+    {
+        $booking = $this->makeBooking();
+        $gift    = $this->makeGift(['name' => 'Rose']);
+
+        $this->makeGiftOrder(['gift_id' => $gift['id'], 'booking_id' => $booking['id']]);
+
+        $rows = (new GiftOrderModel())->forBookingWithGift((int) $booking['id']);
+
+        $this->assertCount(1, $rows);
+        $this->assertSame('Rose', $rows[0]['gift_name']);
+    }
+
+    public function testAnOrderMovesThroughItsStatuses(): void
+    {
+        $order = $this->makeGiftOrder();
+        $model = new GiftOrderModel();
+
+        $model->markPaid($order['id']);
+        $this->assertSame('paid', $model->find($order['id'])['status']);
+
+        $model->markFulfilled($order['id']);
+        $after = $model->find($order['id']);
+        $this->assertSame('fulfilled', $after['status']);
+        $this->assertNull($after['vendor_order_ref'], 'An order of our own has no vendor reference.');
+    }
+
+    public function testFulfillingAVendorOrderKeepsTheVendorsReference(): void
+    {
+        $order = $this->makeGiftOrder();
+
+        (new GiftOrderModel())->markFulfilled($order['id'], 'V-777');
+
+        $this->assertSame('V-777', (new GiftOrderModel())->find($order['id'])['vendor_order_ref']);
+    }
+
+    public function testAnOrderCanBeCancelled(): void
+    {
+        $order = $this->makeGiftOrder();
+
+        (new GiftOrderModel())->markCancelled($order['id']);
+
+        $this->assertSame('cancelled', (new GiftOrderModel())->find($order['id'])['status']);
+    }
+
+    public function testAnOrderNeedsAGiftASenderARecipientAndAnAmount(): void
+    {
+        $model = new GiftOrderModel();
+        $gift  = $this->makeGift();
+
+        $this->assertFalse($model->insert(['sender_name' => 'A', 'sender_phone' => '1', 'recipient_name' => 'B', 'amount' => 1]));
+        $this->assertArrayHasKey('gift_id', $model->errors());
+
+        foreach (['sender_name', 'sender_phone', 'recipient_name', 'amount'] as $field) {
+            $data = ['gift_id' => $gift['id'], 'sender_name' => 'A', 'sender_phone' => '0700000000', 'recipient_name' => 'B', 'amount' => 100];
+            unset($data[$field]);
+
+            $this->assertFalse($model->insert($data), "An order with no {$field} should be refused.");
+        }
+    }
+}
diff --git a/tests/database/Models/MessageTemplateModelTest.php b/tests/database/Models/MessageTemplateModelTest.php
new file mode 100644
index 0000000..1d96ab6
--- /dev/null
+++ b/tests/database/Models/MessageTemplateModelTest.php
@@ -0,0 +1,129 @@
+<?php
+
+namespace Tests\Database\Models;
+
+use App\Models\MessageTemplateModel;
+use Tests\Support\TestCase\AppTestCase;
+
+/**
+ * The example messages offered on the booking form.
+ *
+ * @internal
+ */
+final class MessageTemplateModelTest extends AppTestCase
+{
+    private MessageTemplateModel $templates;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->templates = new MessageTemplateModel();
+    }
+
+    /**
+     * @param array<string, mixed> $overrides
+     */
+    private function template(string $title, array $overrides = []): int|string
+    {
+        $id = $this->templates->insert($overrides + [
+            'category_id' => null,
+            'language'    => 'English',
+            'title'       => $title,
+            'body'        => "Body of {$title}",
+            'sort_order'  => 0,
+            'is_active'   => 1,
+        ]);
+
+        $this->assertNotFalse($id, json_encode($this->templates->errors()));
+
+        return $id;
+    }
+
+    public function testACategoryGetsItsOwnTemplatesAndTheOnesForAnyOccasion(): void
+    {
+        $birthdays = $this->makeCategory();
+        $tributes  = $this->makeCategory();
+
+        $this->template('Birthday only', ['category_id' => $birthdays['id']]);
+        $this->template('Tribute only', ['category_id' => $tributes['id']]);
+        $this->template('Any occasion');
+
+        $titles = array_column($this->templates->forCategory($birthdays['id']), 'title');
+        sort($titles);
+
+        $this->assertSame(['Any occasion', 'Birthday only'], $titles);
+    }
+
+    public function testAnInactiveTemplateIsNotOffered(): void
+    {
+        $category = $this->makeCategory();
+
+        $this->template('Shown', ['category_id' => $category['id']]);
+        $this->template('Hidden', ['category_id' => $category['id'], 'is_active' => 0]);
+
+        $this->assertSame(['Shown'], array_column($this->templates->forCategory($category['id']), 'title'));
+    }
+
+    public function testTemplatesComeInStaffOrderThenLanguageThenTitle(): void
+    {
+        $category = $this->makeCategory();
+
+        $this->template('Zebra', ['category_id' => $category['id'], 'sort_order' => 0, 'language' => 'English']);
+        $this->template('Apple', ['category_id' => $category['id'], 'sort_order' => 0, 'language' => 'English']);
+        $this->template('Okusanyuka', ['category_id' => $category['id'], 'sort_order' => 0, 'language' => 'Luganda']);
+        $this->template('First of all', ['category_id' => $category['id'], 'sort_order' => -0 + 0, 'language' => 'Swahili']);
+        $this->template('Last', ['category_id' => $category['id'], 'sort_order' => 5, 'language' => 'English']);
+
+        $this->assertSame(
+            ['Apple', 'Zebra', 'Okusanyuka', 'First of all', 'Last'],
+            array_column($this->templates->forCategory($category['id']), 'title'),
+            'sort_order first (lower first), then language, then title.'
+        );
+    }
+
+    public function testLanguagesAlwaysOfferEnglishAndLugandaPlusAnyInUse(): void
+    {
+        $this->assertSame(['English', 'Luganda'], $this->templates->languages());
+
+        $this->template('Swahili one', ['language' => 'Swahili']);
+        $this->template('English again', ['language' => 'English']);
+
+        $this->assertSame(['English', 'Luganda', 'Swahili'], $this->templates->languages());
+    }
+
+    public function testTheAdminListShowsTheCategoryNameOrNoneForAnyOccasion(): void
+    {
+        $category = $this->makeCategory(['name' => 'Birthdays']);
+
+        $this->template('Specific', ['category_id' => $category['id']]);
+        $this->template('General');
+
+        $byTitle = array_column($this->templates->adminList(), 'category_name', 'title');
+
+        $this->assertSame('Birthdays', $byTitle['Specific']);
+        $this->assertNull($byTitle['General']);
+    }
+
+    public function testATemplateNeedsATitleALanguageAndAMessage(): void
+    {
+        foreach (['title', 'language', 'body'] as $missing) {
+            $data = ['language' => 'English', 'title' => 'T', 'body' => 'B'];
+            $data[$missing] = '';
+
+            $this->assertFalse($this->templates->insert($data), "A template with no {$missing} should be refused.");
+            $this->assertArrayHasKey($missing, $this->templates->errors());
+        }
+    }
+
+    public function testATitleIsLimitedToEightyCharacters(): void
+    {
+        $this->assertFalse($this->templates->insert(['language' => 'English', 'title' => str_repeat('x', 81), 'body' => 'B']));
+        $this->assertNotFalse($this->templates->insert(['language' => 'English', 'title' => str_repeat('x', 80), 'body' => 'B']));
+    }
+
+    public function testThePlaceholdersAnyTemplateMayUse(): void
+    {
+        $this->assertSame(['recipient', 'sender'], MessageTemplateModel::TOKENS);
+    }
+}
diff --git a/tests/database/Models/NotificationsLogModelTest.php b/tests/database/Models/NotificationsLogModelTest.php
new file mode 100644
index 0000000..d92017a
--- /dev/null
+++ b/tests/database/Models/NotificationsLogModelTest.php
@@ -0,0 +1,97 @@
+<?php
+
+namespace Tests\Database\Models;
+
+use App\Models\NotificationsLogModel;
+use Tests\Support\TestCase\AppTestCase;
+
+/**
+ * The record of every text and email the system tried to send.
+ *
+ * @internal
+ */
+final class NotificationsLogModelTest extends AppTestCase
+{
+    private NotificationsLogModel $log;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->log = new NotificationsLogModel();
+    }
+
+    public function testASentMessageIsLoggedWithTheTimeItWentOut(): void
+    {
+        $booking = $this->makeBooking();
+
+        $id = $this->log->logSent((int) $booking['id'], 'sms', '0772123456', 'Thanks Grace');
+
+        $row = $this->log->find($id);
+        $this->assertSame('sent', $row['status']);
+        $this->assertSame('sms', $row['channel']);
+        $this->assertSame('0772123456', $row['recipient']);
+        $this->assertSame('Thanks Grace', $row['message']);
+        $this->assertEqualsWithDelta(time(), strtotime($row['sent_at']), 5);
+    }
+
+    public function testAFailedMessageIsLoggedWithNoSendTime(): void
+    {
+        $id = $this->log->logFailed(null, 'email', 'grace@example.test', "Subject\n\nBody");
+
+        $row = $this->log->find($id);
+        $this->assertSame('failed', $row['status']);
+        $this->assertNull($row['sent_at']);
+        $this->assertNull($row['booking_id'], 'A test message belongs to no booking.');
+    }
+
+    public function testAnUnknownChannelIsNotLogged(): void
+    {
+        $this->assertFalse($this->log->logSent(null, 'pigeon', 'someone', 'coo'));
+        $this->assertSame(0, $this->db->table('notifications_log')->countAllResults());
+    }
+
+    public function testABookingsMessagesAreNewestFirst(): void
+    {
+        $booking = $this->makeBooking();
+        $other   = $this->makeBooking();
+
+        $first  = $this->log->logSent((int) $booking['id'], 'sms', '1', 'first');
+        $second = $this->log->logFailed((int) $booking['id'], 'sms', '1', 'second');
+        $this->log->logSent((int) $other['id'], 'sms', '2', 'not ours');
+
+        $this->assertSame([$second, $first], array_map('intval', array_column($this->log->forBooking((int) $booking['id']), 'id')));
+    }
+
+    public function testTheLogCanBeFilteredByStatusChannelAndBooking(): void
+    {
+        $booking = $this->makeBooking();
+
+        $a = $this->log->logSent((int) $booking['id'], 'sms', '1', 'a');
+        $b = $this->log->logFailed((int) $booking['id'], 'sms', '1', 'b');
+        $c = $this->log->logSent((int) $booking['id'], 'email', 'x@y.test', 'c');
+        $d = $this->log->logSent(null, 'sms', '9', 'd');
+
+        $ids = fn (array $filters): array => array_map('intval', array_column($this->log->filtered($filters, 50, 0), 'id'));
+
+        $this->assertEqualsCanonicalizing([$a, $c, $d], $ids(['status' => 'sent']));
+        $this->assertSame([$b], $ids(['status' => 'failed']));
+        $this->assertEqualsCanonicalizing([$a, $b, $d], $ids(['channel' => 'sms']));
+        $this->assertEqualsCanonicalizing([$a, $b, $c], $ids(['booking_id' => $booking['id']]));
+        $this->assertSame([$b], $ids(['status' => 'failed', 'channel' => 'sms', 'booking_id' => $booking['id']]));
+    }
+
+    public function testTheLogIsPagedNewestFirstAndCountedWithTheSameFilters(): void
+    {
+        $ids = [];
+
+        for ($i = 1; $i <= 5; $i++) {
+            $ids[] = (int) $this->log->logSent(null, 'sms', (string) $i, "m{$i}");
+        }
+
+        $this->assertSame([$ids[4], $ids[3]], array_map('intval', array_column($this->log->filtered([], 2, 0), 'id')));
+        $this->assertSame([$ids[0]], array_map('intval', array_column($this->log->filtered([], 2, 4), 'id')));
+        $this->assertSame(5, $this->log->countFiltered([]));
+        $this->assertSame(0, $this->log->countFiltered(['status' => 'failed']));
+    }
+}
diff --git a/tests/database/Models/PaymentModelTest.php b/tests/database/Models/PaymentModelTest.php
