diff --git a/app/Services/BookingService.php b/app/Services/BookingService.php
new file mode 100644
index 0000000..68c9c48
--- /dev/null
+++ b/app/Services/BookingService.php
@@ -0,0 +1,207 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\BookingModel;
+use App\Models\CategoryModel;
+use App\Models\RateTierModel;
+use App\Libraries\MessageSanitizer;
+
+/**
+ * Owns booking creation and lifecycle transitions. This is the single
+ * entry point the booking-flow controller should call — it coordinates
+ * category/rate-tier lookup, message sanitization (via MessageSanitizer),
+ * slot reservation (via SchedulingService), and the initial sender
+ * confirmation (via NotificationService), inside one transaction.
+ *
+ * Voice note handling is NOT done here: the controller should run the
+ * uploaded file through App\Libraries\VoiceNoteUploader first (it deals
+ * with the HTTP UploadedFile object, which this service never touches)
+ * and pass the resulting stored path + duration in as plain values.
+ *
+ * Expected $input keys for createBooking():
+ *   category_id, rate_tier_id, sender_name, sender_phone, sender_email,
+ *   recipient_name, message_text, voice_note_path, voice_note_duration_seconds,
+ *   show_id (optional), scheduled_date (optional)
+ */
+class BookingService
+{
+    protected BookingModel $bookingModel;
+    protected CategoryModel $categoryModel;
+    protected RateTierModel $rateTierModel;
+    protected SchedulingService $schedulingService;
+    protected NotificationService $notificationService;
+    protected MessageSanitizer $messageSanitizer;
+
+    public function __construct(
+        ?BookingModel $bookingModel = null,
+        ?CategoryModel $categoryModel = null,
+        ?RateTierModel $rateTierModel = null,
+        ?SchedulingService $schedulingService = null,
+        ?NotificationService $notificationService = null,
+        ?MessageSanitizer $messageSanitizer = null
+    ) {
+        $this->bookingModel        = $bookingModel ?? new BookingModel();
+        $this->categoryModel       = $categoryModel ?? new CategoryModel();
+        $this->rateTierModel       = $rateTierModel ?? new RateTierModel();
+        $this->schedulingService   = $schedulingService ?? new SchedulingService();
+        $this->notificationService = $notificationService ?? new NotificationService();
+        $this->messageSanitizer    = $messageSanitizer ?? new MessageSanitizer();
+    }
+
+    /**
+     * @return array{success: bool, message: string, booking: ?array, errors: array}
+     */
+    public function createBooking(array $input): array
+    {
+        $category = $this->categoryModel->find($input['category_id'] ?? null);
+        $rateTier = $this->rateTierModel->find($input['rate_tier_id'] ?? null);
+
+        if ($category === null || (int) $category['is_active'] !== 1) {
+            return $this->failure('Selected category is not available.');
+        }
+
+        if ($rateTier === null || (int) $rateTier['is_active'] !== 1 || (int) $rateTier['category_id'] !== (int) $category['id']) {
+            return $this->failure('Selected package is not available for this category.');
+        }
+
+        $messageCheck = $this->messageSanitizer->validateMessage($input['message_text'] ?? '');
+
+        if (! $messageCheck['valid']) {
+            return $this->failure($messageCheck['message']);
+        }
+
+        $recipientCheck = $this->messageSanitizer->validateRecipientName($input['recipient_name'] ?? '');
+
+        if (! $recipientCheck['valid']) {
+            return $this->failure($recipientCheck['message']);
+        }
+
+        // Flags (not blocks) the booking for priority moderator attention —
+        // the decision always stays with a human reviewer.
+        $flaggedTerms = $this->messageSanitizer->flaggedTerms($messageCheck['sanitized']);
+
+        $db = db_connect();
+        $db->transStart();
+
+        $showSlotId = null;
+
+        if (! empty($input['show_id']) && ! empty($input['scheduled_date'])) {
+            $reservation = $this->schedulingService->reserveSlot(
+                (int) $input['show_id'],
+                $input['scheduled_date']
+            );
+
+            if (! $reservation['success']) {
+                $db->transComplete();
+
+                return $this->failure($reservation['message']);
+            }
+
+            $showSlotId = $reservation['slot']['id'];
+        }
+
+        $data = [
+            'category_id'                 => $category['id'],
+            'rate_tier_id'                => $rateTier['id'],
+            'show_slot_id'                => $showSlotId,
+            'sender_name'                 => $input['sender_name'] ?? null,
+            'sender_phone'                => $input['sender_phone'] ?? null,
+            'sender_email'                => $input['sender_email'] ?? null,
+            'recipient_name'              => $recipientCheck['sanitized'],
+            'message_text'                => $messageCheck['sanitized'],
+            'voice_note_path'             => $input['voice_note_path'] ?? null,
+            'voice_note_duration_seconds' => $input['voice_note_duration_seconds'] ?? null,
+            'scheduled_date'              => $input['scheduled_date'] ?? null,
+            'status'                      => BookingModel::STATUS_PENDING_PAYMENT,
+            'amount'                      => $rateTier['price'],
+            'currency'                    => $rateTier['currency'],
+            'moderation_notes'            => $flaggedTerms !== []
+                ? 'Auto-flagged for review — contains: ' . implode(', ', $flaggedTerms)
+                : null,
+        ];
+
+        $bookingId = $this->bookingModel->insert($data);
+
+        if ($bookingId === false) {
+            $db->transComplete();
+
+            return ['success' => false, 'message' => 'Could not create booking.', 'booking' => null, 'errors' => $this->bookingModel->errors()];
+        }
+
+        $db->transComplete();
+
+        if ($db->transStatus() === false) {
+            return $this->failure('Booking could not be saved, please try again.');
+        }
+
+        $booking = $this->bookingModel->find($bookingId);
+        $this->notificationService->sendBookingConfirmation($booking);
+
+        return ['success' => true, 'message' => 'Booking created.', 'booking' => $booking, 'errors' => []];
+    }
+
+    /**
+     * Called by PaymentService once a payment for this booking succeeds —
+     * moves the booking from awaiting payment into the moderation queue.
+     */
+    public function confirmPaymentReceived(int $bookingId): bool
+    {
+        $booking = $this->bookingModel->find($bookingId);
+
+        if ($booking === null || $booking['status'] !== BookingModel::STATUS_PENDING_PAYMENT) {
+            return false;
+        }
+
+        return $this->bookingModel->update($bookingId, [
+            'status' => BookingModel::STATUS_PENDING_MODERATION,
+        ]);
+    }
+
+    /**
+     * @return array{success: bool, message: string}
+     */
+    public function cancelBooking(int $bookingId): array
+    {
+        $booking = $this->bookingModel->find($bookingId);
+
+        if ($booking === null) {
+            return ['success' => false, 'message' => 'Booking not found.'];
+        }
+
+        if (in_array($booking['status'], [BookingModel::STATUS_AIRED, BookingModel::STATUS_CANCELLED], true)) {
+            return ['success' => false, 'message' => 'This booking can no longer be cancelled.'];
+        }
+
+        if (! empty($booking['show_slot_id'])) {
+            $this->schedulingService->releaseSlot((int) $booking['show_slot_id']);
+        }
+
+        $this->bookingModel->markCancelled($bookingId);
+
+        return ['success' => true, 'message' => 'Booking cancelled.'];
+    }
+
+    /**
+     * Called once a presenter has aired the booking — stamps the time and
+     * notifies the sender.
+     */
+    public function markAired(int $bookingId): bool
+    {
+        $booking = $this->bookingModel->find($bookingId);
+
+        if ($booking === null || $booking['status'] !== BookingModel::STATUS_APPROVED) {
+            return false;
+        }
+
+        $this->bookingModel->markAired($bookingId);
+        $this->notificationService->sendAiredNotice($this->bookingModel->find($bookingId));
+
+        return true;
+    }
+
+    protected function failure(string $message): array
+    {
+        return ['success' => false, 'message' => $message, 'booking' => null, 'errors' => []];
+    }
+}
diff --git a/app/Services/GiftOrderService.php b/app/Services/GiftOrderService.php
new file mode 100644
index 0000000..b998be7
--- /dev/null
+++ b/app/Services/GiftOrderService.php
@@ -0,0 +1,151 @@
+<?php
+
+namespace App\Services;
+
+use App\Libraries\VendorGiftClients\GenericRestVendorClient;
+use App\Models\GiftModel;
+use App\Models\GiftOrderModel;
+use App\Models\GiftVendorModel;
+
+/**
+ * Owns gift ordering — both the standalone "Send a Gift" flow and a gift
+ * attached to an existing booking, for both local gifts and vendor-sourced
+ * ones (see GiftModel::SOURCE_LOCAL / SOURCE_VENDOR). A local gift is
+ * fulfilled by an admin marking it done by hand; a vendor gift is
+ * fulfilled by actually placing the order with the vendor's API.
+ */
+class GiftOrderService
+{
+    protected GiftModel $giftModel;
+    protected GiftOrderModel $giftOrderModel;
+    protected GiftVendorModel $giftVendorModel;
+
+    public function __construct(
+        ?GiftModel $giftModel = null,
+        ?GiftOrderModel $giftOrderModel = null,
+        ?GiftVendorModel $giftVendorModel = null
+    ) {
+        $this->giftModel       = $giftModel ?? new GiftModel();
+        $this->giftOrderModel  = $giftOrderModel ?? new GiftOrderModel();
+        $this->giftVendorModel = $giftVendorModel ?? new GiftVendorModel();
+    }
+
+    /**
+     * Expected $input keys: gift_id, sender_name, sender_phone,
+     * recipient_name, recipient_phone, delivery_details, quantity.
+     * Pass $bookingId when the gift rides along with an existing greeting;
+     * leave null for the standalone "Send a Gift" flow.
+     *
+     * @return array{success: bool, message: string, giftOrder: ?array, errors: array}
+     */
+    public function createOrder(array $input, ?int $bookingId = null): array
+    {
+        $gift = $this->giftModel->find($input['gift_id'] ?? null);
+
+        if ($gift === null || (int) $gift['is_active'] !== 1) {
+            return ['success' => false, 'message' => 'Selected gift is not available.', 'giftOrder' => null, 'errors' => []];
+        }
+
+        $quantity = max((int) ($input['quantity'] ?? 1), 1);
+
+        $data = [
+            'booking_id'       => $bookingId,
+            'gift_id'          => $gift['id'],
+            'sender_name'      => $input['sender_name'] ?? null,
+            'sender_phone'     => $input['sender_phone'] ?? null,
+            'recipient_name'   => $input['recipient_name'] ?? null,
+            'recipient_phone'  => $input['recipient_phone'] ?? null,
+            'delivery_details' => $input['delivery_details'] ?? null,
+            'quantity'         => $quantity,
+            'amount'           => $gift['price'] * $quantity,
+            'currency'         => $gift['currency'],
+            'status'           => GiftOrderModel::STATUS_PENDING_PAYMENT,
+        ];
+
+        $id = $this->giftOrderModel->insert($data);
+
+        if ($id === false) {
+            return ['success' => false, 'message' => 'Could not create gift order.', 'giftOrder' => null, 'errors' => $this->giftOrderModel->errors()];
+        }
+
+        return ['success' => true, 'message' => 'Gift order created.', 'giftOrder' => $this->giftOrderModel->find($id), 'errors' => []];
+    }
+
+    /**
+     * Called by PaymentService once payment for this gift order succeeds.
+     */
+    public function confirmPaymentReceived(int $giftOrderId): bool
+    {
+        $order = $this->giftOrderModel->find($giftOrderId);
+
+        if ($order === null || $order['status'] !== GiftOrderModel::STATUS_PENDING_PAYMENT) {
+            return false;
+        }
+
+        return $this->giftOrderModel->markPaid($giftOrderId);
+    }
+
+    /**
+     * Fulfills a paid gift order. For a local gift this is an admin
+     * hand-off (e-card sent, airtime topped up) and just marks it done.
+     * For a vendor-sourced gift this actually places the order with the
+     * vendor's API first, and only marks it fulfilled if the vendor
+     * confirms.
+     *
+     * @return array{success: bool, message: string}
+     */
+    public function fulfill(int $giftOrderId): array
+    {
+        $order = $this->giftOrderModel->find($giftOrderId);
+
+        if ($order === null || $order['status'] !== GiftOrderModel::STATUS_PAID) {
+            return ['success' => false, 'message' => 'This gift order is not ready to be fulfilled.'];
+        }
+
+        $gift = $this->giftModel->find($order['gift_id']);
+
+        if ($gift === null) {
+            return ['success' => false, 'message' => 'The gift for this order no longer exists.'];
+        }
+
+        if ($gift['source'] !== GiftModel::SOURCE_VENDOR) {
+            $this->giftOrderModel->markFulfilled($giftOrderId);
+
+            return ['success' => true, 'message' => 'Gift order marked fulfilled.'];
+        }
+
+        $vendor = $this->giftVendorModel->find($gift['vendor_id']);
+
+        if ($vendor === null) {
+            return ['success' => false, 'message' => 'This gift\'s vendor is no longer configured.'];
+        }
+
+        $client = new GenericRestVendorClient($vendor);
+        $result = $client->submitOrder([
+            'vendor_product_ref' => $gift['vendor_product_ref'],
+            'quantity'           => (int) $order['quantity'],
+            'recipient_name'     => $order['recipient_name'],
+            'recipient_phone'    => $order['recipient_phone'],
+            'delivery_details'   => $order['delivery_details'],
+        ]);
+
+        if (! $result['success']) {
+            return ['success' => false, 'message' => $result['message']];
+        }
+
+        $this->giftOrderModel->markFulfilled($giftOrderId, $result['vendor_order_ref']);
+
+        return ['success' => true, 'message' => 'Order placed with vendor and marked fulfilled.'];
+    }
+
+    public function cancel(int $giftOrderId): bool
+    {
+        $order = $this->giftOrderModel->find($giftOrderId);
+
+        if ($order === null || $order['status'] === GiftOrderModel::STATUS_FULFILLED) {
+            return false;
+        }
+
+        return $this->giftOrderModel->markCancelled($giftOrderId);
+    }
+}
diff --git a/app/Services/ModerationService.php b/app/Services/ModerationService.php
new file mode 100644
index 0000000..41f1857
--- /dev/null
+++ b/app/Services/ModerationService.php
@@ -0,0 +1,112 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\BookingModel;
+use App\Models\ModerationLogModel;
+
+/**
+ * Owns the moderation workflow for a booking: approve, reject, or flag,
+ * each paired with an audit-log entry and a sender notification. This is
+ * the one place that should ever change a booking's moderation status.
+ */
+class ModerationService
+{
+    protected BookingModel $bookingModel;
+    protected ModerationLogModel $moderationLogModel;
+    protected SchedulingService $schedulingService;
+    protected NotificationService $notificationService;
+
+    public function __construct(
+        ?BookingModel $bookingModel = null,
+        ?ModerationLogModel $moderationLogModel = null,
+        ?SchedulingService $schedulingService = null,
+        ?NotificationService $notificationService = null
+    ) {
+        $this->bookingModel        = $bookingModel ?? new BookingModel();
+        $this->moderationLogModel  = $moderationLogModel ?? new ModerationLogModel();
+        $this->schedulingService   = $schedulingService ?? new SchedulingService();
+        $this->notificationService = $notificationService ?? new NotificationService();
+    }
+
+    /**
+     * @return array{success: bool, message: string}
+     */
+    public function approve(int $bookingId, int $moderatorId, ?string $notes = null): array
+    {
+        $booking = $this->bookingModel->find($bookingId);
+
+        if ($booking === null) {
+            return ['success' => false, 'message' => 'Booking not found.'];
+        }
+
+        if ($booking['status'] !== BookingModel::STATUS_PENDING_MODERATION) {
+            return ['success' => false, 'message' => 'Only bookings pending moderation can be approved.'];
+        }
+
+        $this->bookingModel->markApproved($bookingId, $moderatorId, $notes);
+        $this->moderationLogModel->log($bookingId, $moderatorId, 'approved', $notes);
+
+        $updated = $this->bookingModel->find($bookingId);
+        $this->notificationService->sendModerationResult($updated);
+
+        return ['success' => true, 'message' => 'Booking approved.'];
+    }
+
+    /**
+     * @return array{success: bool, message: string}
+     */
+    public function reject(int $bookingId, int $moderatorId, ?string $notes = null): array
+    {
+        $booking = $this->bookingModel->find($bookingId);
+
+        if ($booking === null) {
+            return ['success' => false, 'message' => 'Booking not found.'];
+        }
+
+        if (! in_array($booking['status'], [BookingModel::STATUS_PENDING_MODERATION, BookingModel::STATUS_PENDING_PAYMENT], true)) {
+            return ['success' => false, 'message' => 'This booking cannot be rejected in its current state.'];
+        }
+
+        $this->bookingModel->markRejected($bookingId, $moderatorId, $notes);
+        $this->moderationLogModel->log($bookingId, $moderatorId, 'rejected', $notes);
+
+        // Release the show-slot spot this booking was holding, if any.
+        if (! empty($booking['show_slot_id'])) {
+            $this->schedulingService->releaseSlot((int) $booking['show_slot_id']);
+        }
+
+        $updated = $this->bookingModel->find($bookingId);
+        $this->notificationService->sendModerationResult($updated);
+
+        return ['success' => true, 'message' => 'Booking rejected.'];
+    }
+
+    /**
+     * Flags a booking for closer review without changing its status —
+     * e.g. a moderator is unsure and wants a second opinion before
+     * approving or rejecting. Logged only; no sender notification.
+     *
+     * @return array{success: bool, message: string}
+     */
+    public function flag(int $bookingId, int $moderatorId, ?string $notes = null): array
+    {
+        $booking = $this->bookingModel->find($bookingId);
+
+        if ($booking === null) {
+            return ['success' => false, 'message' => 'Booking not found.'];
+        }
+
+        $this->moderationLogModel->log($bookingId, $moderatorId, 'flagged', $notes);
+
+        return ['success' => true, 'message' => 'Booking flagged for review.'];
+    }
+
+    /**
+     * Full moderation history for a booking — for an admin detail view.
+     */
+    public function history(int $bookingId): array
+    {
+        return $this->moderationLogModel->forBooking($bookingId);
+    }
+}
diff --git a/app/Services/NotificationService.php b/app/Services/NotificationService.php
new file mode 100644
index 0000000..45174b6
--- /dev/null
+++ b/app/Services/NotificationService.php
@@ -0,0 +1,227 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\NotificationsLogModel;
+use Config\Notifications;
+use Config\Services as CoreServices;
+
+/**
+ * Sends and logs every sender-facing notification. Wording lives in
+ * Config\Notifications (edit templates there, not here); which channels
+ * are active (SMS, email, or both) is also controlled there, independent
+ * of whether the sender actually supplied a phone/email.
+ *
+ * OPEN ITEM: CBS has not yet confirmed which SMS gateway to use (see the
+ * scope sign-off doc). sendSms() below is written against Africa's
+ * Talking's messaging API shape as a reasonable default for Uganda — verify
+ * the exact endpoint/params against whichever gateway CBS confirms, and
+ * against that provider's current docs, before relying on it in production.
+ * Email uses CodeIgniter's built-in Email service, configured via the
+ * standard email.* .env keys — no open item there.
+ */
+class NotificationService
+{
+    protected NotificationsLogModel $notificationsLogModel;
+    protected Notifications $config;
+
+    public function __construct(?NotificationsLogModel $notificationsLogModel = null, ?Notifications $config = null)
+    {
+        $this->notificationsLogModel = $notificationsLogModel ?? new NotificationsLogModel();
+        $this->config                = $config ?? config('Notifications');
+    }
+
+    /**
+     * Sent as soon as a booking is created, before moderation — confirms
+     * receipt and gives the sender their reference code.
+     */
+    public function sendBookingConfirmation(array $booking): void
+    {
+        $this->dispatch('booking_confirmation', $booking);
+    }
+
+    /**
+     * Sent after an admin approves or rejects a booking.
+     */
+    public function sendModerationResult(array $booking): void
+    {
+        $event = $booking['status'] === 'approved' ? 'moderation_approved' : 'moderation_rejected';
+        $this->dispatch($event, $booking);
+    }
+
+    /**
+     * Sent the moment a booking is marked aired.
+     */
+    public function sendAiredNotice(array $booking): void
+    {
+        $this->dispatch('aired', $booking);
+    }
+
+    /**
+     * Re-sends a previously failed notification using the exact message
+     * stored in its log row — so a resend says what the original would
+     * have, even if the templates in Config\Notifications have been
+     * edited since. The attempt is logged as a new row; the original
+     * failed row stays in place as the audit trail.
+     *
+     * @param array $logRow a notifications_log row
+     */
+    public function resend(array $logRow): bool
+    {
+        $bookingId = $logRow['booking_id'] !== null ? (int) $logRow['booking_id'] : null;
+
+        if ($logRow['channel'] === 'sms') {
+            return $this->sendSms($bookingId, $logRow['recipient'], $logRow['message']);
+        }
+
+        // Email rows are stored as "subject\n\nbody" (see sendEmail()).
+        [$subject, $body] = array_pad(explode("\n\n", $logRow['message'], 2), 2, '');
+
+        return $this->sendEmail($bookingId, $logRow['recipient'], $subject, $body);
+    }
+
+    /**
+     * Sends a one-off test message so staff can confirm the gateway
+     * settings work. Goes through exactly the same send-and-log path as a
+     * real notification (and shows up in the log with no booking), but
+     * ignores the channel on/off switch — testing a channel before
+     * turning it on is the point.
+     */
+    public function sendTest(string $channel, string $recipient): bool
+    {
+        if ($channel === 'sms') {
+            return $this->sendSms(null, $recipient, 'This is a test message from CBS Radio. Your SMS settings are working.');
+        }
+
+        if ($channel === 'email') {
+            return $this->sendEmail(
+                null,
+                $recipient,
+                'CBS Radio test email',
+                "This is a test email from CBS Radio.\n\nYour email settings are working."
+            );
+        }
+
+        return false;
+    }
+
+    /**
+     * Renders the named template and sends it over every enabled channel
+     * the sender gave us contact details for. Never throws — a
+     * notification failure should not break the booking/moderation flow
+     * that triggered it; failures are logged instead.
+     */
+    protected function dispatch(string $event, array $booking): void
+    {
+        helper('text');
+
+        $template = $this->config->templates[$event] ?? null;
+
+        if ($template === null) {
+            return;
+        }
+
+        $tokens = [
+            'reference'      => cbs_booking_reference((int) $booking['id']),
+            'sender_name'    => $booking['sender_name'] ?? '',
+            'recipient_name' => $booking['recipient_name'] ?? '',
+            // Must stay in step with Registry::TEMPLATE_TOKENS — a template
+            // may only use placeholders that are filled in here.
+            'contact_phone'  => config('CbsRadio')->contactPhone,
+        ];
+
+        if ($this->config->channelsEnabled['sms'] && ! empty($booking['sender_phone'])) {
+            $message = $this->config->render($template['sms'], $tokens);
+            $this->sendSms((int) $booking['id'], $booking['sender_phone'], $message);
+        }
+
+        if ($this->config->channelsEnabled['email'] && ! empty($booking['sender_email'])) {
+            $subject = $this->config->render($template['email_subject'], $tokens);
+            $body    = $this->config->render($template['email_body'], $tokens);
+            $this->sendEmail((int) $booking['id'], $booking['sender_email'], $subject, $body);
+        }
+    }
+
+    /**
+     * Sends one SMS and logs the outcome (sent/failed) against the booking.
+     */
+    protected function sendSms(?int $bookingId, string $toPhone, string $message): bool
+    {
+        $apiKey   = env('sms.apiKey');
+        $senderId = $this->config->smsSenderId;
+
+        if (empty($apiKey)) {
+            $this->notificationsLogModel->logFailed($bookingId, 'sms', $toPhone, $message);
+
+            return false;
+        }
+
+        try {
+            $client = CoreServices::curlrequest();
+
+            // Africa's Talking messaging API shape — confirm against the
+            // provider CBS actually selects before go-live.
+            $response = $client->post('https://api.africastalking.com/version1/messaging', [
+                'headers' => [
+                    'apiKey'       => $apiKey,
+                    'Accept'       => 'application/json',
+                    'Content-Type' => 'application/x-www-form-urlencoded',
+                ],
+                'form_params' => [
+                    'username' => env('sms.username', ''),
+                    'to'       => $toPhone,
+                    'message'  => $message,
+                    'from'     => $senderId,
+                ],
+            ]);
+
+            $ok = $response->getStatusCode() >= 200 && $response->getStatusCode() < 300;
+        } catch (\Throwable $e) {
+            $ok = false;
+        }
+
+        if ($ok) {
+            $this->notificationsLogModel->logSent($bookingId, 'sms', $toPhone, $message);
+        } else {
+            $this->notificationsLogModel->logFailed($bookingId, 'sms', $toPhone, $message);
+        }
+
+        return $ok;
+    }
+
+    /**
+     * Sends one email via CodeIgniter's built-in Email service (configured
+     * through the standard email.* .env keys — SMTP host/user/pass/port)
+     * and logs the outcome against the booking.
+     */
+    protected function sendEmail(?int $bookingId, string $toEmail, string $subject, string $body): bool
+    {
+        try {
+            $emailer = CoreServices::email();
+
+            // The "from" details come from settings when an admin has set
+            // them, otherwise from .env (Config\Email).
+            if ($this->config->emailFromAddress !== '') {
+                $emailer->setFrom($this->config->emailFromAddress, $this->config->emailFromName);
+            }
+
+            $emailer->setTo($toEmail);
+            $emailer->setSubject($subject);
+            $emailer->setMessage(nl2br(esc($body)));
+
+            $ok = $emailer->send();
+        } catch (\Throwable $e) {
+            $ok = false;
+        }
+
+        $logMessage = $subject . "\n\n" . $body;
+
+        if ($ok) {
+            $this->notificationsLogModel->logSent($bookingId, 'email', $toEmail, $logMessage);
+        } else {
+            $this->notificationsLogModel->logFailed($bookingId, 'email', $toEmail, $logMessage);
+        }
+
+        return $ok;
+    }
+}
diff --git a/app/Services/PaymentService.php b/app/Services/PaymentService.php
new file mode 100644
index 0000000..5e3cf96
--- /dev/null
+++ b/app/Services/PaymentService.php
@@ -0,0 +1,244 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\PaymentModel;
+
+/**
+ * Owns payment creation and settlement for both bookings and gift orders.
+ * Per the agreed scope, payment is a single Mobile Money provider plus an
+ * admin "mark as paid" fallback — not a multi-provider system.
+ *
+ * OPEN ITEM: CBS has not yet confirmed MTN vs Airtel (see the scope
+ * sign-off doc). chargeMobileMoney() below is the one method to fill in
+ * once that's decided — everything else (record-keeping, callback
+ * handling, downstream status updates, admin override) is provider-agnostic
+ * and does not need to change.
+ */
+class PaymentService
+{
+    /** provider value recorded on a payment that staff will confirm by hand. */
+    public const MANUAL_PROVIDER = 'manual';
+
+    protected PaymentModel $paymentModel;
+    protected BookingService $bookingService;
+    protected GiftOrderService $giftOrderService;
+
+    public function __construct(
+        ?PaymentModel $paymentModel = null,
+        ?BookingService $bookingService = null,
+        ?GiftOrderService $giftOrderService = null
+    ) {
+        $this->paymentModel     = $paymentModel ?? new PaymentModel();
+        $this->bookingService   = $bookingService ?? new BookingService();
+        $this->giftOrderService = $giftOrderService ?? new GiftOrderService();
+    }
+
+    /**
+     * @return array{success: bool, message: string, payment: ?array, manual: bool}
+     */
+    public function initiateForBooking(array $booking): array
+    {
+        return $this->initiate([
+            'booking_id' => $booking['id'],
+            'amount'     => $booking['amount'],
+            'currency'   => $booking['currency'],
+            'phone'      => $booking['sender_phone'],
+        ]);
+    }
+
+    /**
+     * @return array{success: bool, message: string, payment: ?array, manual: bool}
+     */
+    public function initiateForGiftOrder(array $giftOrder): array
+    {
+        return $this->initiate([
+            'gift_order_id' => $giftOrder['id'],
+            'amount'        => $giftOrder['amount'],
+            'currency'      => $giftOrder['currency'],
+            'phone'         => $giftOrder['sender_phone'],
+        ]);
+    }
+
+    /**
+     * Starts a payment for a booking or gift order, according to the payment
+     * mode set under Admin > Settings > Payments:
+     *
+     *  - manual: records a pending payment and tells the payer how to pay;
+     *    staff mark it paid from the payments screen.
+     *  - mobile_money: records a pending payment and asks the provider to
+     *    charge the payer's phone.
+     *
+     * Safe to call again for the same booking or gift order (the pay page is
+     * a GET and gets reloaded): an existing pending payment is returned
+     * instead of creating another one.
+     *
+     * @param array{booking_id?: int, gift_order_id?: int, amount: float, currency: string, phone: string} $context
+     * @return array{success: bool, message: string, payment: ?array, manual: bool}
+     */
+    protected function initiate(array $context): array
+    {
+        $settings = config('Payments');
+        $linkKey  = isset($context['booking_id']) ? 'booking_id' : 'gift_order_id';
+
+        $pending = $this->paymentModel
+            ->where($linkKey, $context[$linkKey])
+            ->where('status', PaymentModel::STATUS_PENDING)
+            ->first();
+
+        if ($pending !== null) {
+            return [
+                'success' => true,
+                'message' => 'Your payment is awaiting confirmation.',
+                'payment' => $pending,
+                'manual'  => $pending['provider'] === self::MANUAL_PROVIDER,
+            ];
+        }
+
+        if ($settings->mode === 'manual') {
+            $paymentId = $this->createPending($context, self::MANUAL_PROVIDER);
+
+            if ($paymentId === false) {
+                return $this->failure('Could not create payment record.');
+            }
+
+            return [
+                'success' => true,
+                'message' => 'Follow the payment instructions below.',
+                'payment' => $this->paymentModel->find($paymentId),
+                'manual'  => true,
+            ];
+        }
+
+        if ($settings->provider === '') {
+            return $this->failure('Online payments are not set up yet.');
+        }
+
+        $paymentId = $this->createPending($context, $settings->provider);
+
+        if ($paymentId === false) {
+            return $this->failure('Could not create payment record.');
+        }
+
+        $charge = $this->chargeMobileMoney($context['phone'], (float) $context['amount'], (string) $paymentId);
+
+        if (! $charge['success']) {
+            $this->paymentModel->markFailed($paymentId);
+
+            return [
+                'success' => false,
+                'message' => $charge['message'],
+                'payment' => $this->paymentModel->find($paymentId),
+                'manual'  => false,
+            ];
+        }
+
+        return [
+            'success' => true,
+            'message' => 'Payment request sent to your phone.',
+            'payment' => $this->paymentModel->find($paymentId),
+            'manual'  => false,
+        ];
+    }
+
+    /**
+     * @return int|string|false the new payment id
+     */
+    protected function createPending(array $context, string $provider): int|string|false
+    {
+        return $this->paymentModel->insert([
+            'booking_id'    => $context['booking_id'] ?? null,
+            'gift_order_id' => $context['gift_order_id'] ?? null,
+            'provider'      => $provider,
+            'amount'        => $context['amount'],
+            'currency'      => $context['currency'],
+            'status'        => PaymentModel::STATUS_PENDING,
+        ]);
+    }
+
+    /**
+     * @return array{success: bool, message: string, payment: null, manual: bool}
+     */
+    protected function failure(string $message): array
+    {
+        return ['success' => false, 'message' => $message, 'payment' => null, 'manual' => false];
+    }
+
+    /**
+     * Called from the Mobile Money provider's webhook/callback route once
+     * they confirm success or failure for a prior charge request.
+     *
+     * @param array{provider_reference: string, status: string} $payload
+     */
+    public function handleCallback(array $payload): bool
+    {
+        $payment = $this->paymentModel
+            ->where('provider_reference', $payload['provider_reference'])
+            ->first();
+
+        if ($payment === null) {
+            return false;
+        }
+
+        if ($payload['status'] === 'success') {
+            $this->paymentModel->markSuccess($payment['id'], $payload['provider_reference']);
+            $this->settleLinkedRecord($payment);
+
+            return true;
+        }
+
+        $this->paymentModel->markFailed($payment['id']);
+
+        return true;
+    }
+
+    /**
+     * Admin fallback: mark a payment as paid manually when the Mobile
+     * Money flow fails or can't be verified, so a booking is never stuck
+     * because of a payment hiccup.
+     */
+    public function markManualPayment(int $paymentId, int $adminUserId): bool
+    {
+        $payment = $this->paymentModel->find($paymentId);
+
+        if ($payment === null || $payment['status'] === 'success') {
+            return false;
+        }
+
+        $this->paymentModel->markManuallyPaid($paymentId, $adminUserId);
+        $this->settleLinkedRecord($this->paymentModel->find($paymentId));
+
+        return true;
+    }
+
+    /**
+     * Pushes a successful payment's status onto whichever record it's
+     * linked to — a booking moves into moderation, a gift order moves
+     * to paid.
+     */
+    protected function settleLinkedRecord(array $payment): void
+    {
+        if (! empty($payment['booking_id'])) {
+            $this->bookingService->confirmPaymentReceived((int) $payment['booking_id']);
+        }
+
+        if (! empty($payment['gift_order_id'])) {
+            $this->giftOrderService->confirmPaymentReceived((int) $payment['gift_order_id']);
+        }
+    }
+
+    /**
+     * The one provider-specific integration point. Fill this in once CBS
+     * confirms MTN or Airtel — the request/response shape differs between
+     * the two providers' Collections APIs, so this should be written
+     * against that provider's current docs rather than guessed at here.
+     *
+     * @return array{success: bool, message: string}
+     */
+    protected function chargeMobileMoney(string $phone, float $amount, string $referenceId): array
+    {
+        // TODO: replace with the confirmed provider's real Collections API
+        // call once MTN vs Airtel is decided (see scope sign-off doc).
+        return ['success' => false, 'message' => 'Mobile Money provider integration not yet implemented.'];
+    }
+}
diff --git a/app/Services/PresenterQueueService.php b/app/Services/PresenterQueueService.php
new file mode 100644
index 0000000..29f7612
--- /dev/null
+++ b/app/Services/PresenterQueueService.php
@@ -0,0 +1,70 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\BookingModel;
+use App\Models\ShowModel;
+use App\Models\ShowSlotModel;
+
+/**
+ * Builds the presenter portal's live queue: approved bookings for a given
+ * show, grouped by today's (or a chosen) slot, oldest-submitted first so
+ * presenters work through them in a predictable order.
+ */
+class PresenterQueueService
+{
+    protected BookingModel $bookingModel;
+    protected ShowModel $showModel;
+    protected ShowSlotModel $showSlotModel;
+
+    public function __construct(
+        ?BookingModel $bookingModel = null,
+        ?ShowModel $showModel = null,
+        ?ShowSlotModel $showSlotModel = null
+    ) {
+        $this->bookingModel  = $bookingModel ?? new BookingModel();
+        $this->showModel     = $showModel ?? new ShowModel();
+        $this->showSlotModel = $showSlotModel ?? new ShowSlotModel();
+    }
+
+    /**
+     * The approved queue for a show on a given date (defaults to today).
+     * Returns an empty array if no slot exists yet for that date — that
+     * just means nothing has been booked into it.
+     */
+    public function queueForShow(int $showId, ?string $date = null): array
+    {
+        $date = $date ?? date('Y-m-d');
+
+        $slot = $this->showSlotModel
+            ->where('show_id', $showId)
+            ->where('slot_date', $date)
+            ->first();
+
+        if ($slot === null) {
+            return [];
+        }
+
+        return $this->bookingModel->approvedForSlot((int) $slot['id']);
+    }
+
+    /**
+     * Every active show with today's queue attached — the presenter
+     * portal's default landing view (one feed per show the presenter
+     * covers, rather than picking a show first).
+     */
+    public function todaysQueuesByShow(): array
+    {
+        $shows  = $this->showModel->active();
+        $result = [];
+
+        foreach ($shows as $show) {
+            $result[] = [
+                'show'  => $show,
+                'queue' => $this->queueForShow((int) $show['id']),
+            ];
+        }
+
+        return $result;
+    }
+}
diff --git a/app/Services/SchedulingService.php b/app/Services/SchedulingService.php
new file mode 100644
index 0000000..7283916
--- /dev/null
+++ b/app/Services/SchedulingService.php
@@ -0,0 +1,88 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\ShowModel;
+use App\Models\ShowSlotModel;
+use Config\CbsRadio;
+
+/**
+ * Owns all show-slot capacity logic: finding/creating the slot for a date,
+ * and reserving/releasing a spot in it. BookingService calls this rather
+ * than touching ShowSlotModel directly, so capacity rules live in one place.
+ */
+class SchedulingService
+{
+    protected ShowModel $showModel;
+    protected ShowSlotModel $showSlotModel;
+    protected CbsRadio $config;
+
+    public function __construct(
+        ?ShowModel $showModel = null,
+        ?ShowSlotModel $showSlotModel = null,
+        ?CbsRadio $config = null
+    ) {
+        $this->showModel     = $showModel ?? new ShowModel();
+        $this->showSlotModel = $showSlotModel ?? new ShowSlotModel();
+        $this->config        = $config ?? config('CbsRadio');
+    }
+
+    /**
+     * Reserve a spot in a show's slot for a given date. Creates the slot
+     * row on first use for that date. Runs inside its own transaction so
+     * two simultaneous bookings can't both squeeze into the last spot.
+     *
+     * @return array{success: bool, message: string, slot: ?array}
+     */
+    public function reserveSlot(int $showId, string $date): array
+    {
+        $show = $this->showModel->find($showId);
+
+        if ($show === null || (int) $show['is_active'] !== 1) {
+            return ['success' => false, 'message' => 'This show is not available for booking.', 'slot' => null];
+        }
+
+        $db = db_connect();
+        $db->transStart();
+
+        $slot = $this->showSlotModel->findOrCreateForDate($showId, $date, $this->config->defaultSlotCapacity);
+
+        if (! $this->showSlotModel->hasCapacity($slot)) {
+            $db->transComplete();
+
+            return ['success' => false, 'message' => 'This show is fully booked for the selected date.', 'slot' => $slot];
+        }
+
+        $this->showSlotModel->incrementBooked($slot['id']);
+        $db->transComplete();
+
+        if ($db->transStatus() === false) {
+            return ['success' => false, 'message' => 'Could not reserve the slot, please try again.', 'slot' => null];
+        }
+
+        return ['success' => true, 'message' => 'Slot reserved.', 'slot' => $this->showSlotModel->find($slot['id'])];
+    }
+
+    /**
+     * Release a previously reserved spot — call when a booking tied to a
+     * slot is cancelled or rejected.
+     */
+    public function releaseSlot(int $slotId): bool
+    {
+        return $this->showSlotModel->decrementBooked($slotId);
+    }
+
+    /**
+     * Shows available for a given day (1=Mon..7=Sun) for the booking
+     * flow's time-slot picker.
+     */
+    public function showsForDay(int $isoDayOfWeek): array
+    {
+        $shows = $this->showModel->active();
+
+        return array_values(array_filter(
+            $shows,
+            fn (array $show) => $this->showModel->runsOn($show, $isoDayOfWeek)
+        ));
+    }
+}
