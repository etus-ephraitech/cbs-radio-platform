+            'aired'              => ['label' => 'Aired',              'class' => 'bg-success'],
+            'cancelled'          => ['label' => 'Cancelled',          'class' => 'bg-dark'],
+        ];
+
+        $entry = $map[$status] ?? ['label' => ucfirst($status), 'class' => 'bg-secondary'];
+
+        return '<span class="badge ' . $entry['class'] . '">' . esc($entry['label']) . '</span>';
