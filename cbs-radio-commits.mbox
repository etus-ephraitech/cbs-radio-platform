+++ b/tests/database/Models/ShowModelTest.php
@@ -0,0 +1,70 @@
+<?php
+
+namespace Tests\Database\Models;
+
+use App\Models\ShowModel;
+use PHPUnit\Framework\Attributes\DataProvider;
+use Tests\Support\TestCase\AppTestCase;
+
+/**
+ * @internal
+ */
+final class ShowModelTest extends AppTestCase
+{
+    public function testActiveShowsComeInOrderOfStartTime(): void
+    {
+        $this->makeShow(['name' => 'Evening Drive', 'start_time' => '16:00:00', 'end_time' => '19:00:00']);
+        $this->makeShow(['name' => 'Morning Express', 'start_time' => '06:00:00', 'end_time' => '10:00:00']);
+        $this->makeShow(['name' => 'Midday', 'start_time' => '12:00:00', 'end_time' => '14:00:00']);
+
+        $this->assertSame(
+            ['Morning Express', 'Midday', 'Evening Drive'],
+            array_column((new ShowModel())->active(), 'name')
+        );
+    }
+
+    public function testAnInactiveShowIsLeftOut(): void
+    {
+        $this->makeShow(['name' => 'Live']);
+        $this->makeShow(['name' => 'Retired', 'is_active' => 0]);
+
+        $this->assertSame(['Live'], array_column((new ShowModel())->active(), 'name'));
+    }
+
+    #[DataProvider('days')]
+    public function testWhichDaysAShowRuns(?string $stored, int $isoDay, bool $runs): void
+    {
+        $this->assertSame($runs, (new ShowModel())->runsOn(['days_of_week' => $stored], $isoDay));
+    }
+
+    /**
+     * @return array<string, array{0: string|null, 1: int, 2: bool}>
+     */
+    public static function days(): array
+    {
+        return [
+            'nothing stored: every day (Monday)'  => [null, 1, true],
+            'nothing stored: every day (Sunday)'  => [null, 7, true],
+            'an empty string is every day too'    => ['', 3, true],
+            'a listed day'                        => ['1,3,5', 3, true],
+            'the first listed day'                => ['1,3,5', 1, true],
+            'a day not listed'                    => ['1,3,5', 2, false],
+            'Sunday is 7'                         => ['6,7', 7, true],
+            'Monday is not in a weekend'          => ['6,7', 1, false],
+            'a single day'                        => ['4', 4, true],
+            'a single day, another day'           => ['4', 5, false],
+        ];
+    }
+
+    public function testAShowNeedsANameAndTimes(): void
+    {
+        $model = new ShowModel();
+
+        $this->assertFalse($model->insert(['name' => '', 'start_time' => '06:00:00', 'end_time' => '10:00:00']));
+        $this->assertArrayHasKey('name', $model->errors());
+
+        $this->assertFalse($model->insert(['name' => 'No times']));
+        $this->assertArrayHasKey('start_time', $model->errors());
+        $this->assertArrayHasKey('end_time', $model->errors());
+    }
+}
diff --git a/tests/database/Models/ShowSlotModelTest.php b/tests/database/Models/ShowSlotModelTest.php
new file mode 100644
index 0000000..0fde3e6
--- /dev/null
+++ b/tests/database/Models/ShowSlotModelTest.php
@@ -0,0 +1,133 @@
+<?php
+
+namespace Tests\Database\Models;
+
+use App\Models\ShowSlotModel;
+use CodeIgniter\Database\Exceptions\DatabaseException;
+use Tests\Support\TestCase\AppTestCase;
+
+/**
+ * A slot is one show on one date, with a capacity that bookings use up.
+ *
+ * @internal
+ */
+final class ShowSlotModelTest extends AppTestCase
+{
+    private ShowSlotModel $slots;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->slots = new ShowSlotModel();
+    }
+
+    public function testASlotIsCreatedTheFirstTimeADateIsAskedFor(): void
+    {
+        $show = $this->makeShow();
+
+        $slot = $this->slots->findOrCreateForDate($show['id'], '2026-12-24');
+
+        $this->assertSame((int) $show['id'], (int) $slot['show_id']);
+        $this->assertSame('2026-12-24', $slot['slot_date']);
+        $this->assertSame(20, (int) $slot['capacity'], 'The default capacity is 20.');
+        $this->assertSame(0, (int) $slot['booked_count']);
+        $this->assertSame(1, (int) $slot['is_open']);
+    }
+
+    public function testTheCapacityGivenIsUsedForANewSlot(): void
+    {
+        $slot = $this->slots->findOrCreateForDate($this->makeShow()['id'], '2026-12-24', 3);
+
+        $this->assertSame(3, (int) $slot['capacity']);
+    }
+
+    public function testAskingAgainForTheSameDayReturnsTheSameSlotAndKeepsItsCapacity(): void
+    {
+        $show = $this->makeShow();
+
+        $first  = $this->slots->findOrCreateForDate($show['id'], '2026-12-24', 3);
+        $second = $this->slots->findOrCreateForDate($show['id'], '2026-12-24', 99);
+
+        $this->assertSame($first['id'], $second['id']);
+        $this->assertSame(3, (int) $second['capacity'], 'A day already booked keeps its capacity when the default changes.');
+        $this->assertSame(1, $this->db->table('show_slots')->countAllResults());
+    }
+
+    public function testDifferentDatesAndDifferentShowsGetTheirOwnSlots(): void
+    {
+        $morning = $this->makeShow();
+        $evening = $this->makeShow();
+
+        $ids = [
+            $this->slots->findOrCreateForDate($morning['id'], '2026-12-24')['id'],
+            $this->slots->findOrCreateForDate($morning['id'], '2026-12-25')['id'],
+            $this->slots->findOrCreateForDate($evening['id'], '2026-12-24')['id'],
+        ];
+
+        $this->assertCount(3, array_unique($ids));
+    }
+
+    public function testTheDatabaseRefusesTwoSlotsForTheSameShowAndDate(): void
+    {
+        $show = $this->makeShow();
+        $this->slots->insert(['show_id' => $show['id'], 'slot_date' => '2026-12-24', 'capacity' => 5]);
+
+        $this->expectException(DatabaseException::class);
+
+        $this->slots->insert(['show_id' => $show['id'], 'slot_date' => '2026-12-24', 'capacity' => 5]);
+    }
+
+    public function testCapacityRemainsWhileFewerAreBookedThanTheLimit(): void
+    {
+        $this->assertTrue($this->slots->hasCapacity(['is_open' => 1, 'booked_count' => 4, 'capacity' => 5]));
+        $this->assertFalse($this->slots->hasCapacity(['is_open' => 1, 'booked_count' => 5, 'capacity' => 5]));
+        $this->assertFalse($this->slots->hasCapacity(['is_open' => 1, 'booked_count' => 9, 'capacity' => 5]), 'Overbooked is still full.');
+    }
+
+    public function testAClosedSlotHasNoCapacityHoweverEmpty(): void
+    {
+        $this->assertFalse($this->slots->hasCapacity(['is_open' => 0, 'booked_count' => 0, 'capacity' => 5]));
+    }
+
+    public function testAZeroCapacitySlotIsAlwaysFull(): void
+    {
+        $this->assertFalse($this->slots->hasCapacity(['is_open' => 1, 'booked_count' => 0, 'capacity' => 0]));
+    }
+
+    public function testBookingsAreCountedUpAndDown(): void
+    {
+        $slot = $this->slots->findOrCreateForDate($this->makeShow()['id'], '2026-12-24', 5);
+
+        $this->assertTrue($this->slots->incrementBooked($slot['id']));
+        $this->assertTrue($this->slots->incrementBooked($slot['id']));
+        $this->assertSame(2, (int) $this->slots->find($slot['id'])['booked_count']);
+
+        $this->assertTrue($this->slots->decrementBooked($slot['id']));
+        $this->assertSame(1, (int) $this->slots->find($slot['id'])['booked_count']);
+    }
+
+    public function testTheCountNeverGoesBelowZero(): void
+    {
+        $slot = $this->slots->findOrCreateForDate($this->makeShow()['id'], '2026-12-24', 5);
+
+        $this->slots->decrementBooked($slot['id']);
+        $this->slots->decrementBooked($slot['id']);
+
+        $this->assertSame(0, (int) $this->slots->find($slot['id'])['booked_count']);
+    }
+
+    public function testCountingUsesTheDatabaseValueNotAStaleCopy(): void
+    {
+        // Two requests holding the same old copy of the row must still add up to two.
+        $slot = $this->slots->findOrCreateForDate($this->makeShow()['id'], '2026-12-24', 5);
+
+        $staleCopyA = $this->slots->find($slot['id']);
+        $staleCopyB = $this->slots->find($slot['id']);
+
+        $this->slots->incrementBooked($staleCopyA['id']);
+        $this->slots->incrementBooked($staleCopyB['id']);
+
+        $this->assertSame(2, (int) $this->slots->find($slot['id'])['booked_count']);
+    }
+}
diff --git a/tests/database/Services/BookingServiceTest.php b/tests/database/Services/BookingServiceTest.php
new file mode 100644
index 0000000..9df9eb9
--- /dev/null
+++ b/tests/database/Services/BookingServiceTest.php
@@ -0,0 +1,372 @@
+<?php
+
+namespace Tests\Database\Services;
+
+use App\Models\BookingModel;
+use App\Models\ShowSlotModel;
+use App\Services\BookingService;
+use Tests\Support\Libraries\RecordingNotifier;
+use Tests\Support\TestCase\AppTestCase;
+
+/**
+ * Making a booking, and moving it through payment, cancellation and airing.
+ *
+ * @internal
+ */
+final class BookingServiceTest extends AppTestCase
+{
+    private RecordingNotifier $notifier;
+    private BookingService $service;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        config('CbsRadio')->defaultSlotCapacity = 2;
+
+        $this->notifier = new RecordingNotifier();
+        $this->service  = new BookingService(notificationService: $this->notifier);
+    }
+
+    /**
+     * What the booking form posts, for a category and package that really exist.
+     *
+     * @param array<string, mixed> $overrides
+     *
+     * @return array<string, mixed>
+     */
+    private function input(array $overrides = []): array
+    {
+        $category = $this->makeCategory();
+        $tier     = $this->makeTier($category['id'], ['price' => 30000, 'currency' => 'UGX']);
+
+        return $overrides + [
+            'category_id'    => $category['id'],
+            'rate_tier_id'   => $tier['id'],
+            'sender_name'    => 'Grace Nakato',
+            'sender_phone'   => '0772123456',
+            'sender_email'   => 'grace@example.test',
+            'recipient_name' => 'Mama Ruth',
+            'message_text'   => 'Happy birthday Mama Ruth!',
+        ];
+    }
+
+    private function bookingCount(): int
+    {
+        return $this->db->table('bookings')->countAllResults();
+    }
+
+    // ------------------------------------------------------------------ creating
+
+    public function testABookingIsCreatedAwaitingPaymentAtThePackagesPrice(): void
+    {
+        $result = $this->service->createBooking($this->input());
+
+        $this->assertTrue($result['success']);
+        $this->assertSame('Booking created.', $result['message']);
+
+        $booking = $result['booking'];
+        $this->assertSame(BookingModel::STATUS_PENDING_PAYMENT, $booking['status']);
+        $this->assertSame('30000.00', $booking['amount'], 'The price comes from the package, never from the form.');
+        $this->assertSame('UGX', $booking['currency']);
+        $this->assertNull($booking['show_slot_id']);
+        $this->assertNull($booking['moderation_notes']);
+    }
+
+    public function testThePriceCannotBeChosenByTheVisitor(): void
+    {
+        $result = $this->service->createBooking($this->input(['amount' => 1, 'currency' => 'USD', 'status' => 'approved']));
+
+        $this->assertSame('30000.00', $result['booking']['amount']);
+        $this->assertSame('pending_payment', $result['booking']['status']);
+    }
+
+    public function testTheMessageAndNameAreSanitisedBeforeTheyAreStored(): void
+    {
+        $result = $this->service->createBooking($this->input([
+            'message_text'   => "  <b>Happy</b>   birthday\n<script>x()</script>",
+            'recipient_name' => ' <i>Mama</i>  Ruth ',
+        ]));
+
+        $this->assertSame('Happy birthday x()', $result['booking']['message_text']);
+        $this->assertSame('Mama Ruth', $result['booking']['recipient_name']);
+    }
+
+    public function testTheSenderIsToldThatTheBookingWasReceived(): void
+    {
+        $result = $this->service->createBooking($this->input());
+
+        $this->assertSame(['booking_confirmation'], $this->notifier->events());
+        $this->assertSame((int) $result['booking']['id'], $this->notifier->sent[0]['id']);
+    }
+
+    public function testAVoiceNoteIsRecordedWithItsLength(): void
+    {
+        $result = $this->service->createBooking($this->input(['voice_note_path' => 'voice-notes/abc.webm', 'voice_note_duration_seconds' => 12]));
+
+        $this->assertSame('voice-notes/abc.webm', $result['booking']['voice_note_path']);
+        $this->assertSame(12, (int) $result['booking']['voice_note_duration_seconds']);
+    }
+
+    // ------------------------------------------------------------------ refusing
+
+    public function testAnUnknownOrInactiveCategoryIsRefused(): void
+    {
+        $inactive = $this->makeCategory(['is_active' => 0]);
+        $tier     = $this->makeTier($inactive['id']);
+
+        foreach ([999999, $inactive['id']] as $categoryId) {
+            $result = $this->service->createBooking($this->input(['category_id' => $categoryId, 'rate_tier_id' => $tier['id']]));
+
+            $this->assertFalse($result['success']);
+            $this->assertSame('Selected category is not available.', $result['message']);
+        }
+
+        $this->assertSame(0, $this->bookingCount());
+    }
+
+    public function testMissingIdsAreRefusedNotTreatedAsEverything(): void
+    {
+        // find(null) means "all rows" in CodeIgniter; a booking with no category or package chosen must be refused.
+        $category = $this->makeCategory();
+        $tier     = $this->makeTier($category['id']);
+
+        foreach (
+            [
+            [['rate_tier_id' => $tier['id']], 'Selected category is not available.'],
+            [['category_id' => $category['id']], 'Selected package is not available for this category.'],
+            [[], 'Selected category is not available.'],
+            [['category_id' => '', 'rate_tier_id' => ''], 'Selected category is not available.'],
+            ] as [$ids, $expected]
+        ) {
+            $input = $ids + $this->input();
+            unset($input['category_id'], $input['rate_tier_id']);
+            $input += $ids;
+
+            $result = $this->service->createBooking($input);
+
+            $this->assertFalse($result['success']);
+            $this->assertSame($expected, $result['message']);
+        }
+
+        $this->assertSame(0, $this->bookingCount());
+    }
+
+    public function testAPackageFromAnotherCategoryOrAnInactiveOneIsRefused(): void
+    {
+        $elsewhere = $this->makeTier();
+        $category  = $this->makeCategory();
+        $retired   = $this->makeTier($category['id'], ['is_active' => 0]);
+
+        foreach ([$elsewhere['id'], $retired['id'], 999999] as $tierId) {
+            $result = $this->service->createBooking($this->input(['category_id' => $category['id'], 'rate_tier_id' => $tierId]));
+
+            $this->assertFalse($result['success']);
+            $this->assertSame('Selected package is not available for this category.', $result['message']);
+        }
+
+        $this->assertSame(0, $this->bookingCount());
+    }
+
+    public function testABadMessageIsRefusedBeforeAnythingIsSavedOrSent(): void
+    {
+        foreach (
+            [
+            ['message_text' => '   ', 'expect' => 'Message cannot be empty.'],
+            ['message_text' => 'Happy birthday [their name]!', 'expect' => 'Replace [their name] with a name before sending.'],
+            ['message_text' => str_repeat('x', 501), 'expect' => 'Message is too long (max 500 characters).'],
+            ['recipient_name' => '', 'expect' => 'Recipient name cannot be empty.'],
+            ] as $case
+        ) {
+            $expect = array_pop($case);
+            $result = $this->service->createBooking($this->input($case));
+
+            $this->assertFalse($result['success']);
+            $this->assertSame($expect, $result['message']);
+        }
+
+        $this->assertSame(0, $this->bookingCount());
+        $this->assertSame([], $this->notifier->sent);
+    }
+
+    public function testTheMessageLimitComesFromTheConfiguration(): void
+    {
+        config('CbsRadio')->messageMaxLength = 20;
+
+        $service = new BookingService(notificationService: $this->notifier);
+
+        $this->assertFalse($service->createBooking($this->input(['message_text' => str_repeat('x', 21)]))['success']);
+        $this->assertTrue($service->createBooking($this->input(['message_text' => str_repeat('x', 20)]))['success']);
+    }
+
+    // ------------------------------------------------------------------ flagged words
+
+    public function testAFlaggedWordMarksTheBookingForReviewButNeverBlocksIt(): void
+    {
+        config('CbsRadio')->moderationFlagTerms = ['scam', 'lottery'];
+
+        $service = new BookingService(notificationService: $this->notifier);
+        $result  = $service->createBooking($this->input(['message_text' => 'You won the LOTTERY, not a scam']));
+
+        $this->assertTrue($result['success'], 'A flag only asks a moderator to look; it never refuses a booking.');
+        $this->assertSame(BookingModel::STATUS_PENDING_PAYMENT, $result['booking']['status']);
+        $this->assertSame('Auto-flagged for review — contains: scam, lottery', $result['booking']['moderation_notes']);
+    }
+
+    // ------------------------------------------------------------------ choosing a show
+
+    public function testChoosingAShowAndDateReservesAPlace(): void
+    {
+        $show = $this->makeShow();
+
+        $result = $this->service->createBooking($this->input(['show_id' => $show['id'], 'scheduled_date' => '2026-12-24']));
+
+        $this->assertTrue($result['success']);
+        $this->assertNotNull($result['booking']['show_slot_id']);
+        $this->assertSame('2026-12-24', $result['booking']['scheduled_date']);
+
+        $slot = (new ShowSlotModel())->find($result['booking']['show_slot_id']);
+        $this->assertSame(1, (int) $slot['booked_count']);
+        $this->assertSame((int) $show['id'], (int) $slot['show_id']);
+    }
+
+    public function testAShowWithNoDateReservesNothing(): void
+    {
+        $show = $this->makeShow();
+
+        $result = $this->service->createBooking($this->input(['show_id' => $show['id']]));
+
+        $this->assertTrue($result['success']);
+        $this->assertNull($result['booking']['show_slot_id']);
+        $this->assertSame(0, $this->db->table('show_slots')->countAllResults());
+    }
+
+    public function testAFullDayIsRefusedAndNoBookingIsMade(): void
+    {
+        $show = $this->makeShow();
+
+        $this->service->createBooking($this->input(['show_id' => $show['id'], 'scheduled_date' => '2026-12-24']));
+        $this->service->createBooking($this->input(['show_id' => $show['id'], 'scheduled_date' => '2026-12-24']));
+
+        $third = $this->service->createBooking($this->input(['show_id' => $show['id'], 'scheduled_date' => '2026-12-24']));
+
+        $this->assertFalse($third['success']);
+        $this->assertSame('This show is fully booked for the selected date.', $third['message']);
+        $this->assertSame(2, $this->bookingCount());
+    }
+
+    public function testAnInactiveShowIsRefused(): void
+    {
+        $show = $this->makeShow(['is_active' => 0]);
+
+        $result = $this->service->createBooking($this->input(['show_id' => $show['id'], 'scheduled_date' => '2026-12-24']));
+
+        $this->assertFalse($result['success']);
+        $this->assertSame('This show is not available for booking.', $result['message']);
+    }
+
+    public function testABookingThatCannotBeSavedDoesNotKeepItsPlaceOnTheShow(): void
+    {
+        // The place is reserved first and the booking saved second. If the saving then fails, the place must be
+        // given back, or a failed booking would quietly use up capacity that nobody holds.
+        $show = $this->makeShow();
+
+        $result = $this->service->createBooking($this->input([
+            'show_id' => $show['id'], 'scheduled_date' => '2026-12-24', 'sender_name' => '', // the model refuses a booking with no sender
+        ]));
+
+        $this->assertFalse($result['success']);
+        $this->assertSame('Could not create booking.', $result['message']);
+        $this->assertArrayHasKey('sender_name', $result['errors']);
+
+        $slot = $this->db->table('show_slots')->get()->getRowArray();
+        $this->assertSame(0, (int) ($slot['booked_count'] ?? 0), 'The failed booking is holding a place on the show.');
+        $this->assertSame([], $this->notifier->sent);
+    }
+
+    // ------------------------------------------------------------------ payment received
+
+    public function testPaymentMovesABookingOnToModeration(): void
+    {
+        $booking = $this->makeBooking();
+
+        $this->assertTrue($this->service->confirmPaymentReceived((int) $booking['id']));
+        $this->assertSame('pending_moderation', (new BookingModel())->find($booking['id'])['status']);
+    }
+
+    public function testPaymentCannotBeConfirmedTwiceOrOutOfOrder(): void
+    {
+        $approved = $this->makeBooking(['status' => BookingModel::STATUS_APPROVED]);
+        $moderation = $this->makeBooking(['status' => BookingModel::STATUS_PENDING_MODERATION]);
+
+        $this->assertFalse($this->service->confirmPaymentReceived((int) $approved['id']), 'An approved booking must not slip back into the queue.');
+        $this->assertFalse($this->service->confirmPaymentReceived((int) $moderation['id']));
+        $this->assertFalse($this->service->confirmPaymentReceived(999999));
+        $this->assertSame('approved', (new BookingModel())->find($approved['id'])['status']);
+    }
+
+    // ------------------------------------------------------------------ cancelling
+
+    public function testCancellingAGivesThePlaceBack(): void
+    {
+        $show   = $this->makeShow();
+        $result = $this->service->createBooking($this->input(['show_id' => $show['id'], 'scheduled_date' => '2026-12-24']));
+
+        $cancel = $this->service->cancelBooking((int) $result['booking']['id']);
+
+        $this->assertSame(['success' => true, 'message' => 'Booking cancelled.'], $cancel);
+        $this->assertSame('cancelled', (new BookingModel())->find($result['booking']['id'])['status']);
+        $this->assertSame(0, (int) (new ShowSlotModel())->find($result['booking']['show_slot_id'])['booked_count']);
+    }
+
+    public function testABookingWithNoShowCanBeCancelledToo(): void
+    {
+        $booking = $this->makeBooking();
+
+        $this->assertTrue($this->service->cancelBooking((int) $booking['id'])['success']);
+    }
+
+    public function testAnAiredOrAlreadyCancelledBookingCannotBeCancelled(): void
+    {
+        foreach ([BookingModel::STATUS_AIRED, BookingModel::STATUS_CANCELLED] as $status) {
+            $booking = $this->makeBooking(['status' => $status]);
+
+            $this->assertSame(
+                ['success' => false, 'message' => 'This booking can no longer be cancelled.'],
+                $this->service->cancelBooking((int) $booking['id'])
+            );
+            $this->assertSame($status, (new BookingModel())->find($booking['id'])['status']);
+        }
+    }
+
+    public function testCancellingAnUnknownBookingSaysSo(): void
+    {
+        $this->assertSame(['success' => false, 'message' => 'Booking not found.'], $this->service->cancelBooking(999999));
+    }
+
+    // ------------------------------------------------------------------ airing
+
+    public function testAnApprovedBookingCanBeMarkedAiredAndTheSenderIsTold(): void
+    {
+        $booking = $this->makeBooking(['status' => BookingModel::STATUS_APPROVED]);
+
+        $this->assertTrue($this->service->markAired((int) $booking['id']));
+
+        $after = (new BookingModel())->find($booking['id']);
+        $this->assertSame('aired', $after['status']);
+        $this->assertNotNull($after['aired_at']);
+        $this->assertSame(['aired'], $this->notifier->events());
+    }
+
+    public function testOnlyAnApprovedBookingCanBeMarkedAired(): void
+    {
+        foreach ([BookingModel::STATUS_PENDING_PAYMENT, BookingModel::STATUS_PENDING_MODERATION, BookingModel::STATUS_REJECTED, BookingModel::STATUS_AIRED, BookingModel::STATUS_CANCELLED] as $status) {
+            $booking = $this->makeBooking(['status' => $status]);
+
+            $this->assertFalse($this->service->markAired((int) $booking['id']), "A {$status} booking must not be markable as aired.");
+        }
+
+        $this->assertFalse($this->service->markAired(999999));
+        $this->assertSame([], $this->notifier->sent, 'Nobody is told a greeting aired when it did not.');
+    }
+}
diff --git a/tests/database/Services/GenericRestVendorClientTest.php b/tests/database/Services/GenericRestVendorClientTest.php
new file mode 100644
index 0000000..395d4f4
--- /dev/null
+++ b/tests/database/Services/GenericRestVendorClientTest.php
@@ -0,0 +1,189 @@
+<?php
+
+namespace Tests\Database\Services;
+
+use App\Libraries\VendorGiftClients\GenericRestVendorClient;
+use Tests\Support\Concerns\SetsEnvironment;
+use Tests\Support\Libraries\FakeHttpGateway;
+use Tests\Support\TestCase\AppTestCase;
+
+/**
+ * The generic REST gift vendor client. Its request and response shapes are an assumption about a typical vendor
+ * (the real vendor is not yet chosen), so these tests record that assumption: what it sends, how it reads the
+ * answer, and that it never lets a vendor's trouble escape as an exception.
+ *
+ * @internal
+ */
+final class GenericRestVendorClientTest extends AppTestCase
+{
+    use SetsEnvironment;
+
+    /**
+     * @param array<string, mixed> $overrides
+     */
+    private function client(array $overrides = []): GenericRestVendorClient
+    {
+        return new GenericRestVendorClient($overrides + ['slug' => 'acme', 'api_base_url' => 'https://vendor.example.test/api']);
+    }
+
+    // ------------------------------------------------------------------ the catalogue
+
+    public function testTheCatalogueIsFetchedWithTheVendorsKeyAndNormalised(): void
+    {
+        $this->setEnv('vendor.acme.apiKey', 'secret-key');
+        $http = FakeHttpGateway::install(body: json_encode(['data' => [
+            ['id' => 12, 'name' => 'Rose bouquet', 'price' => '65000', 'currency' => 'UGX', 'category' => 'physical', 'description' => 'A dozen roses'],
+        ]]));
+
+        $catalog = $this->client()->fetchCatalog();
+
+        $this->assertSame(['GET', 'https://vendor.example.test/api/products'], [$http->calls[0]['method'], $http->calls[0]['url']]);
+        $this->assertSame('Bearer secret-key', $http->calls[0]['options']['headers']['Authorization']);
+        $this->assertSame([[
+            'vendor_product_ref' => '12',
+            'name'               => 'Rose bouquet',
+            'description'        => 'A dozen roses',
+            'price'              => 65000.0,
+            'currency'           => 'UGX',
+            'type'               => 'physical',
+        ]], $catalog);
+    }
+
+    public function testMissingOptionalFieldsGetSensibleDefaults(): void
+    {
+        $this->setEnv('vendor.acme.apiKey', 'k');
+        FakeHttpGateway::install(body: json_encode(['data' => [['id' => 'A', 'name' => 'Plain', 'price' => 100]]]));
+
+        $item = $this->client()->fetchCatalog()[0];
+
+        $this->assertSame(['UGX', 'physical', null], [$item['currency'], $item['type'], $item['description']]);
+    }
+
+    public function testRowsMissingAnIdANameOrAPriceAreSkipped(): void
+    {
+        $this->setEnv('vendor.acme.apiKey', 'k');
+        FakeHttpGateway::install(body: json_encode(['data' => [
+            ['name' => 'No id', 'price' => 1],
+            ['id' => 2, 'price' => 1],
+            ['id' => 3, 'name' => 'No price'],
+            ['id' => 4, 'name' => 'Free', 'price' => 0],
+            ['id' => 5, 'name' => 'Fine', 'price' => 10],
+        ]]));
+
+        $this->assertSame(['4', '5'], array_column($this->client()->fetchCatalog(), 'vendor_product_ref'), 'A price of 0 is a price; a missing price is not.');
+    }
+
+    public function testATrailingSlashOnTheBaseAddressDoesNotDoubleUp(): void
+    {
+        $this->setEnv('vendor.acme.apiKey', 'k');
+        $http = FakeHttpGateway::install(body: '{"data": []}');
+
+        $this->client(['api_base_url' => 'https://vendor.example.test/api/'])->fetchCatalog();
+
+        $this->assertSame('https://vendor.example.test/api/products', $http->calls[0]['url']);
+    }
+
+    public function testNothingIsRequestedWithoutAKeyOrAnAddress(): void
+    {
+        $http = FakeHttpGateway::install();
+
+        $this->setEnv('vendor.acme.apiKey', null);
+        $this->assertSame([], $this->client()->fetchCatalog());
+
+        $this->setEnv('vendor.acme.apiKey', 'k');
+        $this->assertSame([], $this->client(['api_base_url' => ''])->fetchCatalog());
+        $this->assertSame([], $http->calls);
+    }
+
+    public function testEachVendorUsesItsOwnKey(): void
+    {
+        $this->setEnv('vendor.acme.apiKey', 'acme-key');
+        $this->setEnv('vendor.zed.apiKey', 'zed-key');
+        $http = FakeHttpGateway::install(body: '{"data": []}');
+
+        $this->client(['slug' => 'zed'])->fetchCatalog();
+
+        $this->assertSame('Bearer zed-key', $http->calls[0]['options']['headers']['Authorization']);
+    }
+
+    public function testAVendorThatIsDownOrAnswersNonsenseGivesAnEmptyCatalogue(): void
+    {
+        $this->setEnv('vendor.acme.apiKey', 'k');
+
+        FakeHttpGateway::install(failWith: 'Connection timed out');
+        $this->assertSame([], $this->client()->fetchCatalog());
+
+        FakeHttpGateway::install(body: 'this is not json');
+        $this->assertSame([], $this->client()->fetchCatalog());
+
+        FakeHttpGateway::install(body: '{"unexpected": "shape"}');
+        $this->assertSame([], $this->client()->fetchCatalog());
+    }
+
+    // ------------------------------------------------------------------ orders
+
+    /**
+     * @return array<string, mixed>
+     */
+    private function order(): array
+    {
+        return [
+            'vendor_product_ref' => 'SKU-9', 'quantity' => 2, 'recipient_name' => 'Mama Ruth',
+            'recipient_phone' => '0700111222', 'delivery_details' => 'Ntinda, blue gate',
+        ];
+    }
+
+    public function testAnOrderIsPostedInTheVendorsFormatAndTheirReferenceReturned(): void
+    {
+        $this->setEnv('vendor.acme.apiKey', 'secret-key');
+        $http = FakeHttpGateway::install(201, json_encode(['order_id' => 'ORD-5521']));
+
+        $result = $this->client()->submitOrder($this->order());
+
+        $this->assertSame(['success' => true, 'vendor_order_ref' => 'ORD-5521', 'message' => 'Order placed with vendor.'], $result);
+        $this->assertSame(['POST', 'https://vendor.example.test/api/orders'], [$http->calls[0]['method'], $http->calls[0]['url']]);
+        $this->assertSame('Bearer secret-key', $http->calls[0]['options']['headers']['Authorization']);
+        $this->assertSame([
+            'product_id' => 'SKU-9', 'quantity' => 2, 'recipient_name' => 'Mama Ruth',
+            'recipient_phone' => '0700111222', 'delivery_details' => 'Ntinda, blue gate',
+        ], $http->lastPayload());
+    }
+
+    public function testAnOrderTheVendorDeclinesIsReportedAsDeclined(): void
+    {
+        $this->setEnv('vendor.acme.apiKey', 'k');
+
+        foreach ([[422, '{"error": "out of stock"}'], [200, '{}'], [500, '']] as [$status, $body]) {
+            FakeHttpGateway::install($status, $body);
+
+            $this->assertSame(
+                ['success' => false, 'vendor_order_ref' => null, 'message' => 'Vendor declined the order.'],
+                $this->client()->submitOrder($this->order()),
+                "HTTP {$status} with body '{$body}'"
+            );
+        }
+    }
+
+    public function testAnUnreachableVendorIsReportedWithoutAnException(): void
+    {
+        $this->setEnv('vendor.acme.apiKey', 'k');
+        FakeHttpGateway::install(failWith: 'Connection refused');
+
+        $result = $this->client()->submitOrder($this->order());
+
+        $this->assertFalse($result['success']);
+        $this->assertSame('Could not reach vendor: Connection refused', $result['message']);
+    }
+
+    public function testNoOrderIsSentWithoutAKeyOrAnAddress(): void
+    {
+        $http = FakeHttpGateway::install();
+        $this->setEnv('vendor.acme.apiKey', null);
+
+        $this->assertSame(
+            ['success' => false, 'vendor_order_ref' => null, 'message' => 'Vendor is not configured.'],
+            $this->client()->submitOrder($this->order())
+        );
+        $this->assertSame([], $http->calls);
+    }
+}
diff --git a/tests/database/Services/GiftOrderServiceTest.php b/tests/database/Services/GiftOrderServiceTest.php
new file mode 100644
index 0000000..cdd7cc5
--- /dev/null
+++ b/tests/database/Services/GiftOrderServiceTest.php
@@ -0,0 +1,303 @@
+<?php
+
+namespace Tests\Database\Services;
+
+use App\Libraries\VendorGiftClients\VendorGiftClientInterface;
+use App\Models\GiftModel;
+use App\Models\GiftOrderModel;
+use App\Services\GiftOrderService;
+use Tests\Support\Libraries\FakeVendorClient;
+use Tests\Support\TestCase\AppTestCase;
+
+/**
+ * Ordering gifts, and getting them to the recipient, from our own stock or a vendor.
+ *
+ * @internal
+ */
+final class GiftOrderServiceTest extends AppTestCase
+{
+    private GiftOrderService $service;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->service = new GiftOrderService();
+    }
+
+    /**
+     * A service whose vendor is the given fake, so nothing reaches the internet.
+     */
+    private function serviceWithVendor(FakeVendorClient $vendor): GiftOrderService
+    {
+        return new class ($vendor) extends GiftOrderService {
+            public function __construct(private FakeVendorClient $fake)
+            {
+                parent::__construct();
+            }
+
+            protected function vendorClient(array $vendor): VendorGiftClientInterface
+            {
+                return $this->fake;
+            }
+        };
+    }
+
+    /**
+     * @param array<string, mixed> $overrides
+     *
+     * @return array<string, mixed>
+     */
+    private function input(int|string $giftId, array $overrides = []): array
+    {
+        return $overrides + [
+            'gift_id'          => $giftId,
+            'sender_name'      => 'Grace Nakato',
+            'sender_phone'     => '0772123456',
+            'recipient_name'   => 'Mama Ruth',
+            'recipient_phone'  => '0700111222',
+            'delivery_details' => 'Kampala, Ntinda',
+        ];
+    }
+
+    // ------------------------------------------------------------------ ordering
+
+    public function testAnOrderIsPricedFromTheGiftAndWaitsForPayment(): void
+    {
+        $gift = $this->makeGift(['price' => 5000, 'currency' => 'UGX']);
+
+        $result = $this->service->createOrder($this->input($gift['id'], ['quantity' => 3]));
+
+        $this->assertTrue($result['success']);
+        $this->assertSame('Gift order created.', $result['message']);
+
+        $order = $result['giftOrder'];
+        $this->assertSame('15000.00', $order['amount'], 'Price times quantity, taken from the gift and never from the form.');
+        $this->assertSame('UGX', $order['currency']);
+        $this->assertSame('pending_payment', $order['status']);
+        $this->assertSame('Mama Ruth', $order['recipient_name']);
+        $this->assertSame('Kampala, Ntinda', $order['delivery_details']);
+        $this->assertNull($order['booking_id']);
+    }
+
+    public function testTheVisitorCannotNameTheirOwnPrice(): void
+    {
+        $gift = $this->makeGift(['price' => 5000]);
+
+        $result = $this->service->createOrder($this->input($gift['id'], ['amount' => 1, 'status' => 'paid', 'currency' => 'USD']));
+
+        $this->assertSame('5000.00', $result['giftOrder']['amount']);
+        $this->assertSame('pending_payment', $result['giftOrder']['status']);
+        $this->assertSame('UGX', $result['giftOrder']['currency']);
+    }
+
+    /**
+     * @return array<string, array{0: mixed, 1: int}>
+     */
+    public static function quantities(): array
+    {
+        return [
+            'not given'      => [null, 1],
+            'zero'           => [0, 1],
+            'negative'       => [-4, 1],
+            'words'          => ['lots', 1],
+            'a normal one'   => [2, 2],
+            'a numeric text' => ['3', 3],
+        ];
+    }
+
+    /**
+     * @dataProvider quantities
+     */
+    public function testQuantityIsAtLeastOne(mixed $given, int $expected): void
+    {
+        $gift  = $this->makeGift(['price' => 1000]);
+        $input = $this->input($gift['id']);
+
+        if ($given !== null) {
+            $input['quantity'] = $given;
+        }
+
+        $order = $this->service->createOrder($input)['giftOrder'];
+
+        $this->assertSame($expected, (int) $order['quantity']);
+        $this->assertSame(number_format($expected * 1000, 2, '.', ''), $order['amount']);
+    }
+
+    public function testAnOrderCanBeAttachedToAGreeting(): void
+    {
+        $booking = $this->makeBooking();
+        $gift    = $this->makeGift();
+
+        $result = $this->service->createOrder($this->input($gift['id']), (int) $booking['id']);
+
+        $this->assertSame((string) $booking['id'], (string) $result['giftOrder']['booking_id']);
+    }
+
+    public function testAnUnknownOrInactiveGiftCannotBeOrdered(): void
+    {
+        $retired = $this->makeGift(['is_active' => 0]);
+
+        foreach ([$retired['id'], 999999] as $giftId) {
+            $result = $this->service->createOrder($this->input($giftId));
+
+            $this->assertFalse($result['success']);
+            $this->assertSame('Selected gift is not available.', $result['message']);
+            $this->assertNull($result['giftOrder']);
+        }
+
+        $this->assertSame(0, $this->db->table('gift_orders')->countAllResults());
+    }
+
+    public function testAnOrderWithNoGiftChosenIsRefusedNotTreatedAsEveryGift(): void
+    {
+        $this->makeGift();
+
+        $result = $this->service->createOrder(['sender_name' => 'A', 'sender_phone' => '0700000000', 'recipient_name' => 'B']);
+
+        $this->assertFalse($result['success']);
+        $this->assertSame('Selected gift is not available.', $result['message']);
+        $this->assertSame(0, $this->db->table('gift_orders')->countAllResults());
+    }
+
+    public function testAnOrderMissingRequiredDetailsIsRefusedWithTheReasons(): void
+    {
+        $gift = $this->makeGift();
+
+        $result = $this->service->createOrder($this->input($gift['id'], ['sender_name' => '']));
+
+        $this->assertFalse($result['success']);
+        $this->assertSame('Could not create gift order.', $result['message']);
+        $this->assertArrayHasKey('sender_name', $result['errors']);
+        $this->assertSame(0, $this->db->table('gift_orders')->countAllResults());
+    }
+
+    // ------------------------------------------------------------------ payment
+
+    public function testPaymentMarksAnOrderPaidButOnlyOnce(): void
+    {
+        $order = $this->makeGiftOrder();
+
+        $this->assertTrue($this->service->confirmPaymentReceived((int) $order['id']));
+        $this->assertSame('paid', (new GiftOrderModel())->find($order['id'])['status']);
+
+        $this->assertFalse($this->service->confirmPaymentReceived((int) $order['id']), 'A paid order is not paid again.');
+        $this->assertFalse($this->service->confirmPaymentReceived(999999));
+    }
+
+    public function testAFulfilledOrderCannotBeMarkedPaidAgain(): void
+    {
+        $order = $this->makeGiftOrder(['status' => 'fulfilled']);
+
+        $this->assertFalse($this->service->confirmPaymentReceived((int) $order['id']));
+        $this->assertSame('fulfilled', (new GiftOrderModel())->find($order['id'])['status']);
+    }
+
+    // ------------------------------------------------------------------ delivering
+
+    public function testAnUnpaidOrderCannotBeFulfilled(): void
+    {
+        foreach (['pending_payment', 'fulfilled', 'cancelled'] as $status) {
+            $order = $this->makeGiftOrder(['status' => $status]);
+
+            $this->assertSame(
+                ['success' => false, 'message' => 'This gift order is not ready to be fulfilled.'],
+                $this->service->fulfill((int) $order['id'])
+            );
+        }
+
+        $this->assertSame(['success' => false, 'message' => 'This gift order is not ready to be fulfilled.'], $this->service->fulfill(999999));
+    }
+
+    public function testAGiftOfOurOwnIsSimplyMarkedFulfilled(): void
+    {
+        $order = $this->makeGiftOrder(['status' => 'paid']);
+
+        $this->assertSame(['success' => true, 'message' => 'Gift order marked fulfilled.'], $this->service->fulfill((int) $order['id']));
+        $this->assertSame('fulfilled', (new GiftOrderModel())->find($order['id'])['status']);
+    }
+
+    public function testAVendorGiftIsOrderedFromTheVendorAndKeepsTheirReference(): void
+    {
+        $vendor = $this->makeVendor();
+        $gift   = $this->makeGift(['type' => 'physical', 'source' => 'vendor', 'vendor_id' => $vendor['id'], 'vendor_product_ref' => 'SKU-77']);
+        $order  = $this->makeGiftOrder(['gift_id' => $gift['id'], 'status' => 'paid', 'quantity' => 2, 'delivery_details' => 'Ntinda, blue gate']);
+
+        $fake   = new FakeVendorClient(orderResult: ['success' => true, 'vendor_order_ref' => 'V-2024-9', 'message' => 'ok']);
+        $result = $this->serviceWithVendor($fake)->fulfill((int) $order['id']);
+
+        $this->assertSame(['success' => true, 'message' => 'Order placed with vendor and marked fulfilled.'], $result);
+
+        $after = (new GiftOrderModel())->find($order['id']);
+        $this->assertSame('fulfilled', $after['status']);
+        $this->assertSame('V-2024-9', $after['vendor_order_ref']);
+
+        $this->assertCount(1, $fake->orders);
+        $this->assertSame('SKU-77', $fake->orders[0]['vendor_product_ref']);
+        $this->assertSame(2, $fake->orders[0]['quantity']);
+        $this->assertSame('Mama Ruth', $fake->orders[0]['recipient_name']);
+        $this->assertSame('0700111222', $fake->orders[0]['recipient_phone']);
+        $this->assertSame('Ntinda, blue gate', $fake->orders[0]['delivery_details']);
+    }
+
+    public function testAVendorWhoDeclinesLeavesTheOrderPaidAndSaysWhy(): void
+    {
+        $vendor = $this->makeVendor();
+        $gift   = $this->makeGift(['type' => 'physical', 'source' => 'vendor', 'vendor_id' => $vendor['id'], 'vendor_product_ref' => 'SKU-1']);
+        $order  = $this->makeGiftOrder(['gift_id' => $gift['id'], 'status' => 'paid']);
+
+        $fake   = new FakeVendorClient(orderResult: ['success' => false, 'vendor_order_ref' => null, 'message' => 'Out of stock.']);
+        $result = $this->serviceWithVendor($fake)->fulfill((int) $order['id']);
+
+        $this->assertSame(['success' => false, 'message' => 'Out of stock.'], $result);
+        $this->assertSame('paid', (new GiftOrderModel())->find($order['id'])['status'], 'Staff can try again.');
+    }
+
+    public function testAVendorGiftWhoseVendorIsGoneFailsCleanly(): void
+    {
+        // vendor_id is NULL here (as it would be if the vendor had been removed). CodeIgniter's find(null) means
+        // "everything", so a careless lookup would "find" every vendor and place the order with the wrong one.
+        $gift  = $this->makeGift(['type' => 'physical', 'source' => 'vendor', 'vendor_id' => null, 'vendor_product_ref' => 'SKU-1']);
+        $order = $this->makeGiftOrder(['gift_id' => $gift['id'], 'status' => 'paid']);
+
+        $fake   = new FakeVendorClient();
+        $result = $this->serviceWithVendor($fake)->fulfill((int) $order['id']);
+
+        $this->assertFalse($result['success']);
+        $this->assertSame("This gift's vendor is no longer configured.", $result['message']);
+        $this->assertSame([], $fake->orders, 'Nothing may have been sent to any vendor.');
+        $this->assertSame('paid', (new GiftOrderModel())->find($order['id'])['status']);
+    }
+
+    // ------------------------------------------------------------------ cancelling
+
+    public function testAnOrderNotYetDeliveredCanBeCancelled(): void
+    {
+        foreach (['pending_payment', 'paid'] as $status) {
+            $order = $this->makeGiftOrder(['status' => $status]);
+
+            $this->assertTrue($this->service->cancel((int) $order['id']));
+            $this->assertSame('cancelled', (new GiftOrderModel())->find($order['id'])['status']);
+        }
+    }
+
+    public function testADeliveredOrderCannotBeCancelled(): void
+    {
+        $order = $this->makeGiftOrder(['status' => 'fulfilled']);
+
+        $this->assertFalse($this->service->cancel((int) $order['id']));
+        $this->assertSame('fulfilled', (new GiftOrderModel())->find($order['id'])['status']);
+        $this->assertFalse($this->service->cancel(999999));
+    }
+
+    public function testTheGiftModelStillHoldsWhatWasOrdered(): void
+    {
+        $gift = $this->makeGift(['price' => 5000]);
+        $this->service->createOrder($this->input($gift['id']));
+
+        // Re-pricing a gift later must not change what an existing order cost.
+        (new GiftModel())->update($gift['id'], ['price' => 9999]);
+
+        $this->assertSame('5000.00', $this->db->table('gift_orders')->get()->getRowArray()['amount']);
+    }
+}
diff --git a/tests/database/Services/GiftVendorSyncServiceTest.php b/tests/database/Services/GiftVendorSyncServiceTest.php
new file mode 100644
index 0000000..2192e32
--- /dev/null
+++ b/tests/database/Services/GiftVendorSyncServiceTest.php
@@ -0,0 +1,175 @@
+<?php
+
+namespace Tests\Database\Services;
+
+use App\Libraries\VendorGiftClients\VendorGiftClientInterface;
+use App\Models\GiftModel;
+use App\Services\GiftVendorSyncService;
+use Tests\Support\Libraries\FakeVendorClient;
+use Tests\Support\TestCase\AppTestCase;
+
+/**
+ * Pulling each vendor's catalogue into our gift list, without trampling what staff have decided.
+ *
+ * @internal
+ */
+final class GiftVendorSyncServiceTest extends AppTestCase
+{
+    /**
+     * A sync service whose vendors answer from a script: slug => fake client.
+     *
+     * @param array<string, FakeVendorClient> $clients
+     */
+    private function syncing(array $clients): GiftVendorSyncService
+    {
+        return new class ($clients) extends GiftVendorSyncService {
+            /** @param array<string, FakeVendorClient> $clients */
+            public function __construct(private array $clients)
+            {
+                parent::__construct();
+            }
+
+            protected function vendorClient(array $vendor): VendorGiftClientInterface
+            {
+                return $this->clients[$vendor['slug']];
+            }
+        };
+    }
+
+    /**
+     * @param array<string, mixed> $overrides
+     *
+     * @return array<string, mixed>
+     */
+    private function product(string $ref, array $overrides = []): array
+    {
+        return $overrides + [
+            'vendor_product_ref' => $ref,
+            'name'               => "Product {$ref}",
+            'description'        => "About {$ref}",
+            'price'              => 25000.0,
+            'currency'           => 'UGX',
+            'type'               => 'physical',
+        ];
+    }
+
+    public function testANewCatalogueBecomesActiveGiftsLinkedToTheirVendor(): void
+    {
+        $vendor = $this->makeVendor(['slug' => 'acme']);
+        $client = new FakeVendorClient([$this->product('A1', ['price' => 25000.0]), $this->product('A2', ['price' => 8000.0])]);
+
+        $result = $this->syncing(['acme' => $client])->syncAll();
+
+        $this->assertSame(['synced' => 2, 'errors' => []], $result);
+
+        $gift = (new GiftModel())->findByVendorProduct((int) $vendor['id'], 'A1');
+        $this->assertSame('Product A1', $gift['name']);
+        $this->assertSame('physical', $gift['type']);
+        $this->assertSame('vendor', $gift['source']);
+        $this->assertSame((string) $vendor['id'], (string) $gift['vendor_id']);
+        $this->assertSame('25000.00', $gift['price']);
+        $this->assertSame('1', (string) $gift['is_active'], 'New products are offered straight away.');
+        $this->assertNotNull($gift['synced_at']);
+    }
+
+    public function testSyncingAgainUpdatesWhatChangedWithoutDuplicating(): void
+    {
+        $vendor = $this->makeVendor(['slug' => 'acme']);
+        $client = new FakeVendorClient([$this->product('A1', ['price' => 25000.0])]);
+        $sync   = $this->syncing(['acme' => $client]);
+
+        $sync->syncAll();
+
+        $client->catalog = [$this->product('A1', ['price' => 30000.0, 'name' => 'Renamed by the vendor'])];
+        $sync->syncAll();
+
+        $this->assertSame(1, $this->db->table('gifts')->countAllResults());
+
+        $gift = (new GiftModel())->findByVendorProduct((int) $vendor['id'], 'A1');
+        $this->assertSame('30000.00', $gift['price']);
+        $this->assertSame('Renamed by the vendor', $gift['name']);
+    }
+
+    public function testAGiftStaffSwitchedOffStaysOffWhenTheVendorListsItAgain(): void
+    {
+        // The regression this guards: every sync used to re-activate gifts that staff had deliberately hidden.
+        $vendor = $this->makeVendor(['slug' => 'acme']);
+        $client = new FakeVendorClient([$this->product('A1')]);
+        $sync   = $this->syncing(['acme' => $client]);
+
+        $sync->syncAll();
+
+        $gift = (new GiftModel())->findByVendorProduct((int) $vendor['id'], 'A1');
+        (new GiftModel())->update($gift['id'], ['is_active' => 0]);
+
+        $sync->syncAll();
+
+        $this->assertSame('0', (string) (new GiftModel())->find($gift['id'])['is_active']);
+    }
+
+    public function testTheSameProductAtTwoVendorsIsTwoGifts(): void
+    {
+        $this->makeVendor(['slug' => 'acme']);
+        $this->makeVendor(['slug' => 'zed']);
+
+        $result = $this->syncing([
+            'acme' => new FakeVendorClient([$this->product('SKU-1')]),
+            'zed'  => new FakeVendorClient([$this->product('SKU-1')]),
+        ])->syncAll();
+
+        $this->assertSame(2, $result['synced']);
+        $this->assertSame(2, $this->db->table('gifts')->countAllResults());
+    }
+
+    public function testAnInactiveVendorIsNotSynced(): void
+    {
+        $this->makeVendor(['slug' => 'acme', 'is_active' => 0]);
+        $client = new FakeVendorClient([$this->product('A1')]);
+
+        $result = $this->syncing(['acme' => $client])->syncAll();
+
+        $this->assertSame(['synced' => 0, 'errors' => []], $result);
+        $this->assertSame(0, $this->db->table('gifts')->countAllResults());
+    }
+
+    public function testOneVendorBeingDownDoesNotStopTheOthers(): void
+    {
+        $this->makeVendor(['name' => 'Acme', 'slug' => 'acme']);
+        $this->makeVendor(['name' => 'Zed', 'slug' => 'zed']);
+
+        $result = $this->syncing([
+            'acme' => new FakeVendorClient(failCatalogWith: 'Connection refused'),
+            'zed'  => new FakeVendorClient([$this->product('Z1')]),
+        ])->syncAll();
+
+        $this->assertSame(1, $result['synced']);
+        $this->assertSame(['Acme: Connection refused'], $result['errors'], 'The failure names the vendor so staff know whose catalogue is stale.');
+        $this->assertSame(1, $this->db->table('gifts')->countAllResults());
+    }
+
+    public function testAnEmptyCatalogueIsNotAnError(): void
+    {
+        $this->makeVendor(['slug' => 'acme']);
+
+        $this->assertSame(['synced' => 0, 'errors' => []], $this->syncing(['acme' => new FakeVendorClient([])])->syncAll());
+    }
+
+    public function testAnEmptyCatalogueDoesNotRemoveGiftsAlreadyHere(): void
+    {
+        // A vendor API that hiccups and returns nothing must not wipe the gifts staff already offer.
+        $vendor = $this->makeVendor(['slug' => 'acme']);
+        $client = new FakeVendorClient([$this->product('A1')]);
+        $sync   = $this->syncing(['acme' => $client]);
+
+        $sync->syncAll();
+        $client->catalog = [];
+        $sync->syncAll();
+
+        $this->assertNotNull((new GiftModel())->findByVendorProduct((int) $vendor['id'], 'A1'));
+    }
+
+    public function testWithNoVendorsThereIsNothingToDo(): void
+    {
+        $this->assertSame(['synced' => 0, 'errors' => []], $this->syncing([])->syncAll());
+    }
+}
diff --git a/tests/database/Services/ModerationServiceTest.php b/tests/database/Services/ModerationServiceTest.php
new file mode 100644
index 0000000..5141299
--- /dev/null
+++ b/tests/database/Services/ModerationServiceTest.php
@@ -0,0 +1,202 @@
+<?php
+
+namespace Tests\Database\Services;
+
+use App\Models\BookingModel;
+use App\Models\ShowSlotModel;
+use App\Services\BookingService;
+use App\Services\ModerationService;
+use Tests\Support\Libraries\RecordingNotifier;
+use Tests\Support\Libraries\StaffUser;
+use Tests\Support\TestCase\AppTestCase;
+
+/**
+ * Approving, rejecting and flagging greetings, with the audit trail and the messages that go to the sender.
+ *
+ * @internal
+ */
+final class ModerationServiceTest extends AppTestCase
+{
+    private RecordingNotifier $notifier;
+    private ModerationService $moderation;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->notifier   = new RecordingNotifier();
+        $this->moderation = new ModerationService(notificationService: $this->notifier);
+    }
+
+    private function queued(array $overrides = []): array
+    {
+        return $this->makeBooking($overrides + ['status' => BookingModel::STATUS_PENDING_MODERATION]);
+    }
+
+    // ------------------------------------------------------------------ approving
+
+    public function testApprovingRecordsWhoWhyAndTellsTheSender(): void
+    {
+        $booking = $this->queued();
+
+        $result = $this->moderation->approve((int) $booking['id'], StaffUser::id(), 'Lovely');
+
+        $this->assertSame(['success' => true, 'message' => 'Booking approved.'], $result);
+
+        $after = (new BookingModel())->find($booking['id']);
+        $this->assertSame('approved', $after['status']);
+        $this->assertSame((string) StaffUser::id(), (string) $after['moderated_by']);
+        $this->assertSame('Lovely', $after['moderation_notes']);
+        $this->assertSame(['moderation_approved'], $this->notifier->events());
+    }
+
+    public function testApprovingIsLoggedForTheAuditTrail(): void
+    {
+        $booking = $this->queued();
+
+        $this->moderation->approve((int) $booking['id'], StaffUser::id(), 'Lovely');
+
+        $history = $this->moderation->history((int) $booking['id']);
+        $this->assertCount(1, $history);
+        $this->assertSame(['approved', 'Lovely', (string) StaffUser::id()], [$history[0]['action'], $history[0]['notes'], (string) $history[0]['moderator_id']]);
+    }
+
+    public function testOnlyABookingWaitingForModerationCanBeApproved(): void
+    {
+        foreach ([BookingModel::STATUS_PENDING_PAYMENT, BookingModel::STATUS_APPROVED, BookingModel::STATUS_REJECTED, BookingModel::STATUS_AIRED, BookingModel::STATUS_CANCELLED] as $status) {
+            $booking = $this->makeBooking(['status' => $status]);
+
+            $this->assertSame(
+                ['success' => false, 'message' => 'Only bookings pending moderation can be approved.'],
+                $this->moderation->approve((int) $booking['id'], StaffUser::id()),
+                "A {$status} booking must not be approvable (an unpaid one would go on air for free)."
+            );
+            $this->assertSame($status, (new BookingModel())->find($booking['id'])['status']);
+        }
+
+        $this->assertSame([], $this->notifier->sent);
+        $this->assertSame(0, $this->db->table('moderation_logs')->countAllResults());
+    }
+
+    public function testApprovingAnUnknownBookingSaysSo(): void
+    {
+        $this->assertSame(['success' => false, 'message' => 'Booking not found.'], $this->moderation->approve(999999, StaffUser::id()));
+    }
+
+    // ------------------------------------------------------------------ rejecting
+
+    public function testRejectingRecordsWhoWhyAndTellsTheSender(): void
+    {
+        $booking = $this->queued();
+
+        $result = $this->moderation->reject((int) $booking['id'], StaffUser::id(), 'Not suitable for air');
+
+        $this->assertSame(['success' => true, 'message' => 'Booking rejected.'], $result);
+
+        $after = (new BookingModel())->find($booking['id']);
+        $this->assertSame('rejected', $after['status']);
+        $this->assertSame('Not suitable for air', $after['moderation_notes']);
+        $this->assertSame(['moderation_rejected'], $this->notifier->events());
+        $this->assertSame('rejected', $this->moderation->history((int) $booking['id'])[0]['action']);
+    }
+
+    public function testAnUnpaidBookingCanBeRejectedToo(): void
+    {
+        $booking = $this->makeBooking(['status' => BookingModel::STATUS_PENDING_PAYMENT]);
+
+        $this->assertTrue($this->moderation->reject((int) $booking['id'], StaffUser::id())['success']);
+    }
+
+    public function testRejectingGivesThePlaceOnTheShowBack(): void
+    {
+        $show = $this->makeShow();
+        $slot = (new ShowSlotModel())->findOrCreateForDate($show['id'], '2026-12-24', 5);
+        (new ShowSlotModel())->incrementBooked($slot['id']);
+
+        $booking = $this->queued(['show_slot_id' => $slot['id']]);
+
+        $this->moderation->reject((int) $booking['id'], StaffUser::id());
+
+        $this->assertSame(0, (int) (new ShowSlotModel())->find($slot['id'])['booked_count']);
+    }
+
+    public function testOnlyABookingNotYetApprovedOrFinishedCanBeRejected(): void
+    {
+        foreach ([BookingModel::STATUS_APPROVED, BookingModel::STATUS_REJECTED, BookingModel::STATUS_AIRED, BookingModel::STATUS_CANCELLED] as $status) {
+            $booking = $this->makeBooking(['status' => $status]);
+
+            $this->assertSame(
+                ['success' => false, 'message' => 'This booking cannot be rejected in its current state.'],
+                $this->moderation->reject((int) $booking['id'], StaffUser::id())
+            );
+        }
+
+        $this->assertSame([], $this->notifier->sent);
+    }
+
+    public function testRejectingAnUnknownBookingSaysSo(): void
+    {
+        $this->assertSame(['success' => false, 'message' => 'Booking not found.'], $this->moderation->reject(999999, StaffUser::id()));
+    }
+
+    // ------------------------------------------------------------------ flagging
+
+    public function testFlaggingLogsAConcernWithoutChangingTheBooking(): void
+    {
+        $booking = $this->queued();
+
+        $result = $this->moderation->flag((int) $booking['id'], StaffUser::id(), 'Check the name with the presenter');
+
+        $this->assertSame(['success' => true, 'message' => 'Booking flagged for review.'], $result);
+        $this->assertSame('pending_moderation', (new BookingModel())->find($booking['id'])['status']);
+        $this->assertSame('flagged', $this->moderation->history((int) $booking['id'])[0]['action']);
+        $this->assertSame([], $this->notifier->sent, 'The sender is not told about an internal flag.');
+    }
+
+    public function testABookingInAnyStateCanBeFlagged(): void
+    {
+        foreach (BookingModel::STATUSES as $status) {
+            $booking = $this->makeBooking(['status' => $status]);
+
+            $this->assertTrue($this->moderation->flag((int) $booking['id'], StaffUser::id())['success'], $status);
+        }
+    }
+
+    public function testFlaggingAnUnknownBookingSaysSo(): void
+    {
+        $this->assertSame(['success' => false, 'message' => 'Booking not found.'], $this->moderation->flag(999999, StaffUser::id()));
+    }
+
+    // ------------------------------------------------------------------ history
+
+    public function testTheHistoryHoldsEveryDecisionOnABookingAndNoOthers(): void
+    {
+        $booking = $this->queued();
+        $other   = $this->queued();
+
+        $this->moderation->flag((int) $booking['id'], StaffUser::id(), 'first thought');
+        $this->moderation->approve((int) $booking['id'], StaffUser::id(), 'fine after all');
+        $this->moderation->flag((int) $other['id'], StaffUser::id(), 'not ours');
+
+        $actions = array_column($this->moderation->history((int) $booking['id']), 'action');
+        sort($actions);
+
+        $this->assertSame(['approved', 'flagged'], $actions);
+        $this->assertSame([], $this->moderation->history(999999));
+    }
+
+    // ------------------------------------------------------------------ the whole journey
+
+    public function testABookingCanTravelFromPaymentToAir(): void
+    {
+        $booking = $this->makeBooking();
+        $service = new BookingService(notificationService: $this->notifier);
+
+        $this->assertTrue($service->confirmPaymentReceived((int) $booking['id']));
+        $this->assertTrue($this->moderation->approve((int) $booking['id'], StaffUser::id())['success']);
+        $this->assertTrue($service->markAired((int) $booking['id']));
+
+        $this->assertSame('aired', (new BookingModel())->find($booking['id'])['status']);
+        $this->assertSame(['moderation_approved', 'aired'], $this->notifier->events());
+    }
+}
diff --git a/tests/database/Services/NotificationServiceTest.php b/tests/database/Services/NotificationServiceTest.php
new file mode 100644
index 0000000..da3cb35
--- /dev/null
+++ b/tests/database/Services/NotificationServiceTest.php
@@ -0,0 +1,312 @@
+<?php
+
+namespace Tests\Database\Services;
+
+use App\Services\NotificationService;
+use Tests\Support\Concerns\SetsEnvironment;
+use Tests\Support\Libraries\FakeHttpGateway;
+use Tests\Support\TestCase\AppTestCase;
+
+/**
+ * The texts and emails sent to people who book. The real service runs here; the outside world (the SMS gateway,
+ * the mail server) is replaced by fakes that record what would have been sent.
+ *
+ * @internal
+ */
+final class NotificationServiceTest extends AppTestCase
+{
+    use SetsEnvironment;
+
+    private const GATEWAY = 'https://api.africastalking.com/version1/messaging';
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        helper('text');
+
+        $this->setEnv('sms.apiKey', 'test-key');
+        $this->setEnv('sms.username', 'cbsradio');
+    }
+
+    /**
+     * @param array{sms?: bool, email?: bool} $channels
+     */
+    private function notifier(array $channels = ['sms' => true, 'email' => false]): NotificationService
+    {
+        $config                  = config('Notifications');
+        $config->channelsEnabled = $channels + ['sms' => false, 'email' => false];
+        $config->smsSenderId     = 'CBSTEST';
+
+        return new NotificationService(null, $config);
+    }
+
+    /**
+     * @return array<int, array<string, mixed>>
+     */
+    private function loggedMessages(): array
+    {
+        return $this->db->table('notifications_log')->orderBy('id', 'ASC')->get()->getResultArray();
+    }
+
+    private function booking(array $overrides = []): array
+    {
+        return $this->makeBooking($overrides + ['sender_phone' => '0772123456', 'sender_email' => 'grace@example.test']);
+    }
+
+    // ------------------------------------------------------------------ texts
+
+    public function testTheConfirmationTextGoesToTheGatewayWithTheRightDetails(): void
+    {
+        $http    = FakeHttpGateway::install();
+        $booking = $this->booking();
+
+        $this->notifier()->sendBookingConfirmation($booking);
+
+        $this->assertCount(1, $http->calls);
+        $this->assertSame(['POST', self::GATEWAY], [$http->calls[0]['method'], $http->calls[0]['url']]);
+        $this->assertSame('test-key', $http->calls[0]['options']['headers']['apiKey']);
+
+        $payload = $http->lastPayload();
+        $this->assertSame('cbsradio', $payload['username']);
+        $this->assertSame('0772123456', $payload['to']);
+        $this->assertSame('CBSTEST', $payload['from'], 'The sender name comes from the configuration, not from .env.');
+        $this->assertSame(
+            'Thanks Grace Nakato! Your CBS Radio greeting (ref ' . cbs_booking_reference((int) $booking['id']) . ') was received and is being reviewed.',
+            $payload['message']
+        );
+    }
+
+    public function testASentTextIsLoggedAgainstTheBooking(): void
+    {
+        FakeHttpGateway::install();
+        $booking = $this->booking();
+
+        $this->notifier()->sendBookingConfirmation($booking);
+
+        $log = $this->loggedMessages();
+        $this->assertCount(1, $log);
+        $this->assertSame(['sms', 'sent', '0772123456', (string) $booking['id']], [$log[0]['channel'], $log[0]['status'], $log[0]['recipient'], (string) $log[0]['booking_id']]);
+    }
+
+    public function testWithNoGatewayKeyTheTextIsNotSentAndTheFailureIsLogged(): void
+    {
+        $this->setEnv('sms.apiKey', null);
+        $http = FakeHttpGateway::install();
+
+        $sent = $this->notifier()->sendTest('sms', '0772123456');
+
+        $this->assertFalse($sent);
+        $this->assertSame([], $http->calls, 'No key, no call.');
+        $this->assertSame('failed', $this->loggedMessages()[0]['status']);
+    }
+
+    public function testAGatewayThatRefusesTheTextIsLoggedAsFailed(): void
+    {
+        FakeHttpGateway::install(500);
+
+        $this->assertFalse($this->notifier()->sendTest('sms', '0772123456'));
+        $this->assertSame('failed', $this->loggedMessages()[0]['status']);
+    }
+
+    public function testANetworkErrorIsLoggedAsFailedAndNeverEscapesToTheVisitor(): void
+    {
+        FakeHttpGateway::install(failWith: 'Connection refused');
+
+        $this->assertFalse($this->notifier()->sendTest('sms', '0772123456'));
+        $this->assertSame('failed', $this->loggedMessages()[0]['status']);
+    }
+
+    public function testASuccessStatusFromTheGatewayCountsAsSent(): void
+    {
+        foreach ([200, 201, 202] as $status) {
+            FakeHttpGateway::install($status);
+
+            $this->assertTrue($this->notifier()->sendTest('sms', '0772123456'), "HTTP {$status}");
+        }
+    }
+
+    // ------------------------------------------------------------------ emails
+
+    public function testTheConfirmationEmailIsSentWithTheRenderedSubjectAndBody(): void
+    {
+        $booking = $this->booking();
+
+        $this->notifier(['sms' => false, 'email' => true])->sendBookingConfirmation($booking);
+
+        $email = service('email');
+        $ref   = cbs_booking_reference((int) $booking['id']);
+
+        $this->assertSame("We received your CBS Radio greeting — {$ref}", $email->archive['subject']);
+        $this->assertStringContainsString('grace@example.test', json_encode($email->archive['recipients']));
+        $this->assertStringContainsString("Your reference is {$ref}", $email->archive['body']);
+        $this->assertStringContainsString('Mama Ruth', $email->archive['body']);
+    }
+
+    public function testASentEmailIsLoggedWithItsSubjectAndBody(): void
+    {
+        $booking = $this->booking();
+
+        $this->notifier(['sms' => false, 'email' => true])->sendBookingConfirmation($booking);
+
+        $log = $this->loggedMessages();
+        $this->assertCount(1, $log);
+        $this->assertSame(['email', 'sent', 'grace@example.test'], [$log[0]['channel'], $log[0]['status'], $log[0]['recipient']]);
+        $this->assertStringStartsWith('We received your CBS Radio greeting', $log[0]['message']);
+        $this->assertStringContainsString("\n\n", $log[0]['message'], 'Subject, a blank line, then the body.');
+    }
+
+    public function testAMailServerThatFailsIsLoggedAsFailed(): void
+    {
+        service('email')->returnValue = false;
+
+        $this->assertFalse($this->notifier(['sms' => false, 'email' => true])->sendTest('email', 'grace@example.test'));
+        $this->assertSame('failed', $this->loggedMessages()[0]['status']);
+    }
+
+    public function testTheFromAddressIsTakenFromTheConfigurationWhenSet(): void
+    {
+        $config                   = config('Notifications');
+        $config->channelsEnabled  = ['sms' => false, 'email' => true];
+        $config->emailFromAddress = 'greetings@cbs.example.test';
+        $config->emailFromName    = 'CBS Radio';
+
+        (new NotificationService(null, $config))->sendTest('email', 'grace@example.test');
+
+        $this->assertSame('greetings@cbs.example.test', service('email')->archive['fromEmail']);
+        $this->assertSame('CBS Radio', service('email')->archive['fromName']);
+    }
+
+    // ------------------------------------------------------------------ who gets what
+
+    public function testBothChannelsAreUsedWhenBothAreOnAndTheSenderGaveBoth(): void
+    {
+        $http = FakeHttpGateway::install();
+
+        $this->notifier(['sms' => true, 'email' => true])->sendBookingConfirmation($this->booking());
+
+        $this->assertCount(1, $http->calls);
+        $this->assertSame(['sms', 'email'], array_column($this->loggedMessages(), 'channel'));
+    }
+
+    public function testAChannelSwitchedOffIsNeverUsed(): void
+    {
+        $http = FakeHttpGateway::install();
+
+        $this->notifier(['sms' => false, 'email' => false])->sendBookingConfirmation($this->booking());
+
+        $this->assertSame([], $http->calls);
+        $this->assertSame([], $this->loggedMessages());
+    }
+
+    public function testNoTextIsSentWithoutAPhoneNumberAndNoEmailWithoutAnAddress(): void
+    {
+        $http = FakeHttpGateway::install();
+
+        $this->notifier(['sms' => true, 'email' => true])->sendBookingConfirmation($this->makeBooking(['sender_phone' => '0772123456', 'sender_email' => null]));
+
+        $this->assertCount(1, $http->calls);
+        $this->assertSame(['sms'], array_column($this->loggedMessages(), 'channel'), 'No address, so no email attempt at all.');
+    }
+
+    // ------------------------------------------------------------------ which message
+
+    public function testTheModerationMessageDependsOnTheOutcome(): void
+    {
+        $http = FakeHttpGateway::install();
+        $notifier = $this->notifier();
+
+        $notifier->sendModerationResult($this->booking(['status' => 'approved']));
+        $approved = $http->lastPayload()['message'];
+
+        $notifier->sendModerationResult($this->booking(['status' => 'rejected']));
+        $rejected = $http->lastPayload()['message'];
+
+        $this->assertStringContainsString('was approved and will air soon', $approved);
+        $this->assertStringContainsString('could not be approved', $rejected);
+    }
+
+    public function testTheAiredNoticeSaysItAired(): void
+    {
+        $http = FakeHttpGateway::install();
+
+        $this->notifier()->sendAiredNotice($this->booking(['status' => 'aired']));
+
+        $this->assertStringContainsString('just aired', $http->lastPayload()['message']);
+    }
+
+    // ------------------------------------------------------------------ the wording is the administrators'
+
+    public function testTheMessagesUseTheTemplatesInForceAndFillEveryPlaceholder(): void
+    {
+        config('CbsRadio')->contactPhone = '0414 000 000';
+        $config = config('Notifications');
+        $config->templates['booking_confirmation']['sms'] = '{sender_name} / {recipient_name} / {reference} / {contact_phone}';
+        $http    = FakeHttpGateway::install();
+        $booking = $this->booking();
+
+        (new NotificationService(null, $config))->sendBookingConfirmation($booking);
+
+        $this->assertSame(
+            'Grace Nakato / Mama Ruth / ' . cbs_booking_reference((int) $booking['id']) . ' / 0414 000 000',
+            $http->lastPayload()['message']
+        );
+    }
+
+    public function testASendersNameCannotBeUsedToPullInOtherPlaceholders(): void
+    {
+        $config = config('Notifications');
+        $config->templates['booking_confirmation']['sms'] = 'Hi {sender_name}. Ref {reference}.';
+        $http    = FakeHttpGateway::install();
+        $booking = $this->booking(['sender_name' => '{reference} {contact_phone}']);
+
+        (new NotificationService(null, $config))->sendBookingConfirmation($booking);
+
+        $this->assertStringStartsWith('Hi {reference} {contact_phone}. Ref CBS-', $http->lastPayload()['message']);
+    }
+
+    // ------------------------------------------------------------------ resending
+
+    public function testAFailedTextCanBeSentAgainWithItsOriginalWording(): void
+    {
+        $http = FakeHttpGateway::install(500);
+        $this->notifier()->sendTest('sms', '0772123456');
+        $failed = $this->loggedMessages()[0];
+
+        $http = FakeHttpGateway::install(200);
+        $this->assertTrue($this->notifier()->resend($failed));
+
+        $this->assertSame($failed['message'], $http->lastPayload()['message']);
+        $this->assertSame('0772123456', $http->lastPayload()['to']);
+        $this->assertSame(['failed', 'sent'], array_column($this->loggedMessages(), 'status'), 'The attempt is added to the log; history is kept.');
+    }
+
+    public function testAFailedEmailCanBeSentAgainSplitIntoSubjectAndBody(): void
+    {
+        service('email')->returnValue = false;
+        $this->notifier(['sms' => false, 'email' => true])->sendTest('email', 'grace@example.test');
+        $failed = $this->loggedMessages()[0];
+
+        service('email')->returnValue = true;
+        $this->assertTrue($this->notifier(['sms' => false, 'email' => true])->resend($failed));
+
+        $this->assertSame('CBS Radio test email', service('email')->archive['subject']);
+        $this->assertStringContainsString('Your email settings are working.', service('email')->archive['body']);
+    }
+
+    // ------------------------------------------------------------------ the Settings screen's test buttons
+
+    public function testTheTestButtonsSendTestMessagesAndAnUnknownChannelDoesNothing(): void
+    {
+        $http = FakeHttpGateway::install();
+        $notifier = $this->notifier(['sms' => false, 'email' => false]);
+
+        $this->assertTrue($notifier->sendTest('sms', '0772123456'), 'The test works even with the channel switched off.');
+        $this->assertStringContainsString('SMS settings are working', $http->lastPayload()['message']);
+
+        $this->assertTrue($notifier->sendTest('email', 'grace@example.test'));
+
+        $this->assertFalse($notifier->sendTest('pigeon', 'anyone'));
+        $this->assertCount(2, $this->loggedMessages(), 'An unknown channel logs nothing.');
+    }
+}
diff --git a/tests/database/Services/PaymentServiceTest.php b/tests/database/Services/PaymentServiceTest.php
new file mode 100644
index 0000000..af60a50
--- /dev/null
+++ b/tests/database/Services/PaymentServiceTest.php
@@ -0,0 +1,310 @@
+<?php
+
+namespace Tests\Database\Services;
+
+use App\Models\BookingModel;
+use App\Models\GiftOrderModel;
+use App\Models\PaymentModel;
+use App\Services\BookingService;
+use App\Services\PaymentService;
+use Tests\Support\Libraries\FakeMobileMoneyPayments;
+use Tests\Support\Libraries\RecordingNotifier;
+use Tests\Support\Libraries\StaffUser;
+use Tests\Support\TestCase\AppTestCase;
+
+/**
+ * Taking payment, by hand (staff confirm it) or online (Mobile Money), and what a confirmed payment sets moving.
+ *
+ * @internal
+ */
+final class PaymentServiceTest extends AppTestCase
+{
+    private RecordingNotifier $notifier;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->notifier = new RecordingNotifier();
+    }
+
+    private function service(string $class = PaymentService::class): PaymentService
+    {
+        return new $class(bookingService: new BookingService(notificationService: $this->notifier));
+    }
+
+    private function paymentCount(): int
+    {
+        return $this->db->table('payments')->countAllResults();
+    }
+
+    // ------------------------------------------------------------------ manual mode
+
+    public function testInManualModeAPendingPaymentIsCreatedForTheBookingsAmount(): void
+    {
+        config('Payments')->mode = 'manual';
+        $booking = $this->makeBooking(['amount' => 30000]);
+
+        $result = $this->service()->initiateForBooking($booking);
+
+        $this->assertTrue($result['success']);
+        $this->assertTrue($result['manual']);
+        $this->assertSame('Follow the payment instructions below.', $result['message']);
+
+        $payment = $result['payment'];
+        $this->assertSame('manual', $payment['provider']);
+        $this->assertSame('pending', $payment['status']);
+        $this->assertSame('30000.00', $payment['amount']);
+        $this->assertSame((string) $booking['id'], (string) $payment['booking_id']);
+        $this->assertNull($payment['gift_order_id']);
+    }
+
+    public function testAskingAgainReusesTheSamePendingPayment(): void
+    {
+        // The pay page can be reloaded, or opened twice; each load must not add another payment.
+        config('Payments')->mode = 'manual';
+        $booking = $this->makeBooking();
+        $service = $this->service();
+
+        $first  = $service->initiateForBooking($booking);
+        $second = $service->initiateForBooking($booking);
+
+        $this->assertSame($first['payment']['id'], $second['payment']['id']);
+        $this->assertSame('Your payment is awaiting confirmation.', $second['message']);
+        $this->assertTrue($second['manual']);
+        $this->assertSame(1, $this->paymentCount());
+    }
+
+    public function testAFailedPaymentLeavesRoomForAFreshAttempt(): void
+    {
+        config('Payments')->mode = 'manual';
+        $booking = $this->makeBooking();
+        $service = $this->service();
+
+        $first = $service->initiateForBooking($booking);
+        (new PaymentModel())->markFailed($first['payment']['id']);
+
+        $second = $service->initiateForBooking($booking);
+
+        $this->assertNotSame($first['payment']['id'], $second['payment']['id']);
+        $this->assertSame('pending', $second['payment']['status']);
+    }
+
+    public function testEachBookingGetsItsOwnPayment(): void
+    {
+        config('Payments')->mode = 'manual';
+        $service = $this->service();
+
+        $a = $service->initiateForBooking($this->makeBooking());
+        $b = $service->initiateForBooking($this->makeBooking());
+
+        $this->assertNotSame($a['payment']['id'], $b['payment']['id']);
+        $this->assertSame(2, $this->paymentCount());
+    }
+
+    public function testAGiftOrderIsPaidForTheSameWay(): void
+    {
+        config('Payments')->mode = 'manual';
+        $order = $this->makeGiftOrder(['amount' => 15000]);
+
+        $result = $this->service()->initiateForGiftOrder($order);
+
+        $this->assertTrue($result['success']);
+        $this->assertSame((string) $order['id'], (string) $result['payment']['gift_order_id']);
+        $this->assertNull($result['payment']['booking_id']);
+        $this->assertSame('15000.00', $result['payment']['amount']);
+    }
+
+    // ------------------------------------------------------------------ online mode
+
+    public function testOnlinePaymentsAreRefusedUntilAProviderIsChosen(): void
+    {
+        config('Payments')->mode     = 'mobile_money';
+        config('Payments')->provider = '';
+
+        $result = $this->service()->initiateForBooking($this->makeBooking());
+
+        $this->assertFalse($result['success']);
+        $this->assertSame('Online payments are not set up yet.', $result['message']);
+        $this->assertSame(0, $this->paymentCount());
+    }
+
+    public function testTodaysMobileMoneyIntegrationIsAStubAndAFailedChargeIsRecordedAsFailed(): void
+    {
+        // Pinned honestly: until CBS confirms the provider, the real charge always fails. What matters is that the
+        // failure is recorded and reported, not lost, and that nobody is left looking at a payment that never was.
+        config('Payments')->mode     = 'mobile_money';
+        config('Payments')->provider = 'mtn';
+
+        $result = $this->service()->initiateForBooking($this->makeBooking());
+
+        $this->assertFalse($result['success']);
+        $this->assertFalse($result['manual']);
+        $this->assertSame('Mobile Money provider integration not yet implemented.', $result['message']);
+        $this->assertSame('failed', $result['payment']['status']);
+    }
+
+    public function testAnAcceptedChargeLeavesAPendingPaymentAndAsksThePayersPhone(): void
+    {
+        config('Payments')->mode     = 'mobile_money';
+        config('Payments')->provider = 'mtn';
+        $booking = $this->makeBooking(['amount' => 30000, 'sender_phone' => '0772123456']);
+
+        /** @var FakeMobileMoneyPayments $service */
+        $service = $this->service(FakeMobileMoneyPayments::class);
+
+        $result = $service->initiateForBooking($booking);
+
+        $this->assertTrue($result['success']);
+        $this->assertFalse($result['manual']);
+        $this->assertSame('Payment request sent to your phone.', $result['message']);
+        $this->assertSame(['mtn', 'pending'], [$result['payment']['provider'], $result['payment']['status']]);
+
+        $this->assertCount(1, $service->charges);
+        $this->assertSame('0772123456', $service->charges[0]['phone']);
+        $this->assertSame(30000.0, $service->charges[0]['amount']);
+        $this->assertSame((string) $result['payment']['id'], $service->charges[0]['reference'], 'The provider is given our payment id to quote back.');
+    }
+
+    public function testADeclinedChargeIsReportedWithTheProvidersReason(): void
+    {
+        config('Payments')->mode     = 'mobile_money';
+        config('Payments')->provider = 'airtel';
+
+        /** @var FakeMobileMoneyPayments $service */
+        $service              = $this->service(FakeMobileMoneyPayments::class);
+        $service->chargeResult = ['success' => false, 'message' => 'Insufficient funds.'];
+
+        $result = $service->initiateForBooking($this->makeBooking());
+
+        $this->assertFalse($result['success']);
+        $this->assertSame('Insufficient funds.', $result['message']);
+        $this->assertSame('failed', $result['payment']['status']);
+    }
+
+    public function testAnOnlinePaymentAlreadyPendingIsNotChargedAgain(): void
+    {
+        config('Payments')->mode     = 'mobile_money';
+        config('Payments')->provider = 'mtn';
+        $booking = $this->makeBooking();
+
+        /** @var FakeMobileMoneyPayments $service */
+        $service = $this->service(FakeMobileMoneyPayments::class);
+
+        $service->initiateForBooking($booking);
+        $again = $service->initiateForBooking($booking);
+
+        $this->assertCount(1, $service->charges, 'Reloading the page must not send the payer a second prompt.');
+        $this->assertSame('Your payment is awaiting confirmation.', $again['message']);
+        $this->assertFalse($again['manual']);
+    }
+
+    // ------------------------------------------------------------------ the provider's callback
+
+    public function testASuccessfulCallbackSettlesThePaymentAndMovesTheBookingOn(): void
+    {
+        $booking = $this->makeBooking();
+        $payment = $this->makePayment(['booking_id' => $booking['id'], 'provider' => 'mtn', 'provider_reference' => 'REF-1']);
+
+        $this->assertTrue($this->service()->handleCallback(['provider_reference' => 'REF-1', 'status' => 'success']));
+
+        $after = (new PaymentModel())->find($payment['id']);
+        $this->assertSame('success', $after['status']);
+        $this->assertNotNull($after['paid_at']);
+        $this->assertSame('pending_moderation', (new BookingModel())->find($booking['id'])['status']);
+    }
+
+    public function testASuccessfulCallbackForAGiftOrderMarksItPaid(): void
+    {
+        $order = $this->makeGiftOrder();
+        $this->makePayment(['gift_order_id' => $order['id'], 'provider' => 'mtn', 'provider_reference' => 'REF-G']);
+
+        $this->service()->handleCallback(['provider_reference' => 'REF-G', 'status' => 'success']);
+
+        $this->assertSame('paid', (new GiftOrderModel())->find($order['id'])['status']);
+    }
+
+    public function testAFailedCallbackFailsThePaymentAndLeavesTheBookingAlone(): void
+    {
+        $booking = $this->makeBooking();
+        $payment = $this->makePayment(['booking_id' => $booking['id'], 'provider' => 'mtn', 'provider_reference' => 'REF-2']);
+
+        $this->assertTrue($this->service()->handleCallback(['provider_reference' => 'REF-2', 'status' => 'failed']));
+
+        $this->assertSame('failed', (new PaymentModel())->find($payment['id'])['status']);
+        $this->assertSame('pending_payment', (new BookingModel())->find($booking['id'])['status']);
+    }
+
+    public function testACallbackForAnUnknownReferenceIsIgnored(): void
+    {
+        $booking = $this->makeBooking();
+        $this->makePayment(['booking_id' => $booking['id'], 'provider_reference' => 'REF-3']);
+
+        $this->assertFalse($this->service()->handleCallback(['provider_reference' => 'SOMEONE-ELSES', 'status' => 'success']));
+        $this->assertSame('pending_payment', (new BookingModel())->find($booking['id'])['status']);
+    }
+
+    public function testTheSameSuccessCallbackArrivingTwiceDoesNoHarm(): void
+    {
+        // Providers retry callbacks. The second one must not push a booking that has moved on back through the queue.
+        $booking = $this->makeBooking();
+        $this->makePayment(['booking_id' => $booking['id'], 'provider_reference' => 'REF-4']);
+        $service = $this->service();
+
+        $service->handleCallback(['provider_reference' => 'REF-4', 'status' => 'success']);
+        (new BookingModel())->update($booking['id'], ['status' => BookingModel::STATUS_APPROVED]);
+
+        $service->handleCallback(['provider_reference' => 'REF-4', 'status' => 'success']);
+
+        $this->assertSame('approved', (new BookingModel())->find($booking['id'])['status']);
+    }
+
+    // ------------------------------------------------------------------ staff confirming a payment by hand
+
+    public function testStaffCanConfirmAManualPaymentAndTheBookingMovesOn(): void
+    {
+        $booking = $this->makeBooking();
+        $payment = $this->makePayment(['booking_id' => $booking['id']]);
+
+        $this->assertTrue($this->service()->markManualPayment((int) $payment['id'], StaffUser::id()));
+
+        $after = (new PaymentModel())->find($payment['id']);
+        $this->assertSame('success', $after['status']);
+        $this->assertSame((string) StaffUser::id(), (string) $after['marked_paid_by']);
+        $this->assertSame('pending_moderation', (new BookingModel())->find($booking['id'])['status']);
+    }
+
+    public function testConfirmingAGiftOrdersPaymentMarksTheOrderPaid(): void
+    {
+        $order   = $this->makeGiftOrder();
+        $payment = $this->makePayment(['gift_order_id' => $order['id']]);
+
+        $this->service()->markManualPayment((int) $payment['id'], StaffUser::id());
+
+        $this->assertSame('paid', (new GiftOrderModel())->find($order['id'])['status']);
+    }
+
+    public function testAPaymentAlreadyConfirmedCannotBeConfirmedAgain(): void
+    {
+        $booking = $this->makeBooking();
+        $payment = $this->makePayment(['booking_id' => $booking['id']]);
+        $service = $this->service();
+
+        $this->assertTrue($service->markManualPayment((int) $payment['id'], StaffUser::id()));
+        $this->assertFalse($service->markManualPayment((int) $payment['id'], StaffUser::id()));
+    }
+
+    public function testAnUnknownPaymentCannotBeConfirmed(): void
+    {
+        $this->assertFalse($this->service()->markManualPayment(999999, StaffUser::id()));
+    }
+
+    public function testAPaymentThatFailedCanStillBeConfirmedByHandIfTheMoneyArrivedAnyway(): void
+    {
+        $booking = $this->makeBooking();
+        $payment = $this->makePayment(['booking_id' => $booking['id'], 'status' => 'failed']);
+
+        $this->assertTrue($this->service()->markManualPayment((int) $payment['id'], StaffUser::id()));
+        $this->assertSame('pending_moderation', (new BookingModel())->find($booking['id'])['status']);
+    }
+}
diff --git a/tests/database/Services/PresenterQueueServiceTest.php b/tests/database/Services/PresenterQueueServiceTest.php
new file mode 100644
index 0000000..b76877b
--- /dev/null
+++ b/tests/database/Services/PresenterQueueServiceTest.php
@@ -0,0 +1,101 @@
+<?php
+
+namespace Tests\Database\Services;
+
+use App\Models\BookingModel;
+use App\Models\ShowSlotModel;
+use App\Services\PresenterQueueService;
+use Tests\Support\TestCase\AppTestCase;
+
+/**
+ * What a presenter reads out: approved greetings for a show on a day, in the order they were made.
+ *
+ * @internal
+ */
+final class PresenterQueueServiceTest extends AppTestCase
+{
+    private PresenterQueueService $queue;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->queue = new PresenterQueueService();
+    }
+
+    private function slot(int|string $showId, string $date): array
+    {
+        return (new ShowSlotModel())->findOrCreateForDate((int) $showId, $date, 20);
+    }
+
+    public function testAShowWithNoSlotForTheDayHasAnEmptyQueue(): void
+    {
+        $show = $this->makeShow();
+
+        $this->assertSame([], $this->queue->queueForShow((int) $show['id'], '2026-12-24'));
+    }
+
+    public function testTheQueueIsTheApprovedGreetingsForThatShowAndDayInOrder(): void
+    {
+        $show = $this->makeShow();
+        $slot = $this->slot($show['id'], '2026-12-24');
+
+        $first  = $this->makeBooking(['status' => BookingModel::STATUS_APPROVED, 'show_slot_id' => $slot['id'], 'recipient_name' => 'First']);
+        $second = $this->makeBooking(['status' => BookingModel::STATUS_APPROVED, 'show_slot_id' => $slot['id'], 'recipient_name' => 'Second']);
+
+        $this->assertSame(['First', 'Second'], array_column($this->queue->queueForShow((int) $show['id'], '2026-12-24'), 'recipient_name'));
+        $this->assertNotNull($first);
+        $this->assertNotNull($second);
+    }
+
+    public function testOnlyApprovedGreetingsAreQueued(): void
+    {
+        $show = $this->makeShow();
+        $slot = $this->slot($show['id'], '2026-12-24');
+
+        foreach ([BookingModel::STATUS_PENDING_PAYMENT, BookingModel::STATUS_PENDING_MODERATION, BookingModel::STATUS_REJECTED, BookingModel::STATUS_CANCELLED, BookingModel::STATUS_AIRED] as $status) {
+            $this->makeBooking(['status' => $status, 'show_slot_id' => $slot['id']]);
+        }
+
+        $this->assertSame([], $this->queue->queueForShow((int) $show['id'], '2026-12-24'), 'Nothing unpaid, unreviewed or already read out may reach a presenter.');
+    }
+
+    public function testAnotherShowOrAnotherDayDoesNotLeakIn(): void
+    {
+        $morning = $this->makeShow();
+        $evening = $this->makeShow();
+
+        $here = $this->slot($morning['id'], '2026-12-24');
+        $this->makeBooking(['status' => BookingModel::STATUS_APPROVED, 'show_slot_id' => $here['id'], 'recipient_name' => 'Here']);
+        $this->makeBooking(['status' => BookingModel::STATUS_APPROVED, 'show_slot_id' => $this->slot($morning['id'], '2026-12-25')['id'], 'recipient_name' => 'Other day']);
+        $this->makeBooking(['status' => BookingModel::STATUS_APPROVED, 'show_slot_id' => $this->slot($evening['id'], '2026-12-24')['id'], 'recipient_name' => 'Other show']);
+
+        $this->assertSame(['Here'], array_column($this->queue->queueForShow((int) $morning['id'], '2026-12-24'), 'recipient_name'));
+    }
+
+    public function testTheDefaultDayIsToday(): void
+    {
+        $show = $this->makeShow();
+        $slot = $this->slot($show['id'], date('Y-m-d'));
+        $this->makeBooking(['status' => BookingModel::STATUS_APPROVED, 'show_slot_id' => $slot['id'], 'recipient_name' => 'Today']);
+
+        $this->assertSame(['Today'], array_column($this->queue->queueForShow((int) $show['id']), 'recipient_name'));
+    }
+
+    public function testTodaysQueuesAreListedForEveryActiveShow(): void
+    {
+        $morning = $this->makeShow(['name' => 'Morning', 'start_time' => '06:00:00']);
+        $evening = $this->makeShow(['name' => 'Evening', 'start_time' => '16:00:00']);
+        $this->makeShow(['name' => 'Retired', 'is_active' => 0]);
+
+        $slot = $this->slot($morning['id'], date('Y-m-d'));
+        $this->makeBooking(['status' => BookingModel::STATUS_APPROVED, 'show_slot_id' => $slot['id'], 'recipient_name' => 'Early bird']);
+
+        $queues = $this->queue->todaysQueuesByShow();
+
+        $this->assertSame(['Morning', 'Evening'], array_column(array_column($queues, 'show'), 'name'));
+        $this->assertSame(['Early bird'], array_column($queues[0]['queue'], 'recipient_name'));
+        $this->assertSame([], $queues[1]['queue'], 'A show with nothing booked is still listed, with an empty queue.');
+        $this->assertNotNull($evening);
+    }
+}
diff --git a/tests/database/Services/SchedulingServiceTest.php b/tests/database/Services/SchedulingServiceTest.php
new file mode 100644
index 0000000..7bc7a28
--- /dev/null
+++ b/tests/database/Services/SchedulingServiceTest.php
@@ -0,0 +1,128 @@
+<?php
+
+namespace Tests\Database\Services;
+
+use App\Models\ShowSlotModel;
+use App\Services\SchedulingService;
+use Tests\Support\TestCase\AppTestCase;
+
+/**
+ * Reserving a place on a show for a day, and giving it back.
+ *
+ * @internal
+ */
+final class SchedulingServiceTest extends AppTestCase
+{
+    private SchedulingService $scheduling;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        config('CbsRadio')->defaultSlotCapacity = 2;
+        $this->scheduling = new SchedulingService();
+    }
+
+    public function testTheFirstReservationCreatesTheDayWithTheConfiguredCapacity(): void
+    {
+        $show = $this->makeShow();
+
+        $result = $this->scheduling->reserveSlot($show['id'], '2026-12-24');
+
+        $this->assertTrue($result['success']);
+        $this->assertSame('Slot reserved.', $result['message']);
+        $this->assertSame(2, (int) $result['slot']['capacity']);
+        $this->assertSame(1, (int) $result['slot']['booked_count']);
+    }
+
+    public function testEachReservationUsesUpOnePlaceUntilTheDayIsFull(): void
+    {
+        $show = $this->makeShow();
+
+        $this->assertTrue($this->scheduling->reserveSlot($show['id'], '2026-12-24')['success']);
+        $this->assertTrue($this->scheduling->reserveSlot($show['id'], '2026-12-24')['success']);
+
+        $third = $this->scheduling->reserveSlot($show['id'], '2026-12-24');
+
+        $this->assertFalse($third['success']);
+        $this->assertSame('This show is fully booked for the selected date.', $third['message']);
+        $this->assertSame(2, (int) (new ShowSlotModel())->find($third['slot']['id'])['booked_count'], 'A refused booking uses up nothing.');
+    }
+
+    public function testAFullDayDoesNotAffectTheNextDayOrAnotherShow(): void
+    {
+        $morning = $this->makeShow();
+        $evening = $this->makeShow();
+
+        $this->scheduling->reserveSlot($morning['id'], '2026-12-24');
+        $this->scheduling->reserveSlot($morning['id'], '2026-12-24');
+
+        $this->assertTrue($this->scheduling->reserveSlot($morning['id'], '2026-12-25')['success']);
+        $this->assertTrue($this->scheduling->reserveSlot($evening['id'], '2026-12-24')['success']);
+    }
+
+    public function testADayAlreadyBookedKeepsItsCapacityWhenTheDefaultChanges(): void
+    {
+        $show = $this->makeShow();
+        $this->scheduling->reserveSlot($show['id'], '2026-12-24');
+
+        config('CbsRadio')->defaultSlotCapacity = 50;
+
+        $again = (new SchedulingService())->reserveSlot($show['id'], '2026-12-24');
+
+        $this->assertSame(2, (int) $again['slot']['capacity']);
+    }
+
+    public function testAClosedDayTakesNoBookings(): void
+    {
+        $show = $this->makeShow();
+        $slot = (new ShowSlotModel())->findOrCreateForDate($show['id'], '2026-12-24', 10);
+        (new ShowSlotModel())->update($slot['id'], ['is_open' => 0]);
+
+        $result = $this->scheduling->reserveSlot($show['id'], '2026-12-24');
+
+        $this->assertFalse($result['success']);
+        $this->assertSame('This show is fully booked for the selected date.', $result['message']);
+    }
+
+    public function testAnInactiveOrUnknownShowCannotBeBooked(): void
+    {
+        $retired = $this->makeShow(['is_active' => 0]);
+
+        foreach ([$retired['id'], 999999] as $showId) {
+            $result = $this->scheduling->reserveSlot($showId, '2026-12-24');
+
+            $this->assertFalse($result['success']);
+            $this->assertSame('This show is not available for booking.', $result['message']);
+            $this->assertNull($result['slot']);
+        }
+
+        $this->assertSame(0, $this->db->table('show_slots')->countAllResults(), 'A refused show must not leave an empty day behind.');
+    }
+
+    public function testReleasingAPlaceMakesRoomAgain(): void
+    {
+        $show = $this->makeShow();
+        $this->scheduling->reserveSlot($show['id'], '2026-12-24');
+        $full = $this->scheduling->reserveSlot($show['id'], '2026-12-24');
+
+        $this->assertFalse($this->scheduling->reserveSlot($show['id'], '2026-12-24')['success']);
+
+        $this->assertTrue($this->scheduling->releaseSlot((int) $full['slot']['id']));
+
+        $this->assertTrue($this->scheduling->reserveSlot($show['id'], '2026-12-24')['success']);
+    }
+
+    public function testShowsForADayAreTheActiveOnesThatRunThatDay(): void
+    {
+        $this->makeShow(['name' => 'Every day']);
+        $this->makeShow(['name' => 'Weekdays', 'days_of_week' => '1,2,3,4,5']);
+        $this->makeShow(['name' => 'Weekend', 'days_of_week' => '6,7']);
+        $this->makeShow(['name' => 'Retired', 'is_active' => 0]);
+
+        $names = fn (int $isoDay): array => array_column($this->scheduling->showsForDay($isoDay), 'name');
+
+        $this->assertSame(['Every day', 'Weekdays'], $names(3), 'Wednesday');
+        $this->assertSame(['Every day', 'Weekend'], $names(7), 'Sunday');
+    }
+}
diff --git a/tests/database/Settings/SettingsManagerTest.php b/tests/database/Settings/SettingsManagerTest.php
new file mode 100644
index 0000000..63ac08a
--- /dev/null
+++ b/tests/database/Settings/SettingsManagerTest.php
@@ -0,0 +1,502 @@
+<?php
+
+namespace Tests\Database\Settings;
+
+use App\Libraries\Settings\Overrides;
+use App\Libraries\Settings\SettingsManager;
+use App\Models\SettingChangeModel;
+use App\Models\SettingModel;
+use Config\CbsRadio;
+use Tests\Support\Concerns\SetsEnvironment;
+use Tests\Support\Libraries\StaffUser;
+use Tests\Support\TestCase\AppTestCase;
+
+/**
+ * Admin > Settings behind the screen: what is saved, what is refused, what is recorded, and how a saved value
+ * reaches the rest of the application. (Each individual rule is tested without a database in
+ * tests/unit/Settings/SettingsValidationTest.php.)
+ *
+ * @internal
+ */
+final class SettingsManagerTest extends AppTestCase
+{
+    use SetsEnvironment;
+
+    private SettingsManager $manager;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        $this->manager = new SettingsManager();
+    }
+
+    /**
+     * The row the screen shows for one setting.
+     *
+     * @return array<string, mixed>
+     */
+    private function item(string $group, string $key): array
+    {
+        foreach ($this->manager->forGroup($group) as $item) {
+            if ($item['key'] === $key) {
+                return $item;
+            }
+        }
+
+        $this->fail("No setting {$key} in the {$group} group.");
+    }
+
+    private function overrideCount(): int
+    {
+        return $this->db->table('settings')->countAllResults();
+    }
+
+    private function auditCount(): int
+    {
+        return $this->db->table('setting_changes')->countAllResults();
+    }
+
+    // ------------------------------------------------------------------ what the screen shows
+
+    public function testEverySettingInATabIsListedWithItsCodedValueAndNoOverride(): void
+    {
+        $items = $this->manager->forGroup('site');
+
+        $this->assertCount(4, $items);
+
+        foreach ($items as $item) {
+            $this->assertFalse($item['overridden']);
+            $this->assertSame($item['base'], $item['current'], 'With no override, what is in force is what the code ships with.');
+            $this->assertSame(str_replace('.', '_', $item['key']), $item['field']);
+        }
+    }
+
+    public function testAnOverrideShowsAsInForceAndAsOverridden(): void
+    {
+        $this->setSetting('site.heroHeadline', 'Greetings that travel.');
+
+        $item = $this->item('site', 'site.heroHeadline');
+
+        $this->assertTrue($item['overridden']);
+        $this->assertSame('Greetings that travel.', $item['current']);
+        $this->assertNotSame('Greetings that travel.', $item['base'], 'The coded value is still known, for "reset to default".');
+    }
+
+    public function testAnUnknownTabHasNothingInIt(): void
+    {
+        $this->assertSame([], $this->manager->forGroup('no-such-tab'));
+    }
+
+    // ------------------------------------------------------------------ saving
+
+    public function testSavingAChangeStoresItAndTellsHowManyChanged(): void
+    {
+        $result = $this->manager->save('site', ['site_heroHeadline' => 'Greetings that travel.', 'site_announcement' => 'Closed Friday'], [], StaffUser::id());
+
+        $this->assertSame(['success' => true, 'errors' => [], 'changed' => 2], $result);
+        $this->assertSame(
+            ['site.heroHeadline' => 'Greetings that travel.', 'site.announcement' => 'Closed Friday'],
+            (new SettingModel())->allKeyed()
+        );
+    }
+
+    public function testASavedValueTakesEffectImmediatelyEverywhere(): void
+    {
+        $this->manager->save('site', ['site_heroHeadline' => 'Greetings that travel.'], [], null);
+
+        $this->assertSame('Greetings that travel.', SettingsManager::overrides()['site.heroHeadline'], 'The cache was cleared.');
+
+        $this->resetFactories();
+
+        $this->assertSame('Greetings that travel.', config('CbsRadio')->heroHeadline);
+    }
+
+    public function testEveryChangeIsAuditedWithBeforeAfterAndWho(): void
+    {
+        $this->manager->save('site', ['site_announcement' => 'First'], [], StaffUser::id());
+        $this->manager->save('site', ['site_announcement' => 'Second'], [], StaffUser::id());
+
+        $rows = (new SettingChangeModel())->recent(5);
+
+        $this->assertCount(2, $rows);
+        $this->assertSame(['site.announcement', 'set', 'First', 'Second'], [$rows[0]['setting_key'], $rows[0]['action'], $rows[0]['old_value'], $rows[0]['new_value']]);
+        $this->assertSame(['site.announcement', 'set', '', 'First'], [$rows[1]['setting_key'], $rows[1]['action'], (string) $rows[1]['old_value'], $rows[1]['new_value']]);
+        $this->assertSame((string) StaffUser::id(), (string) $rows[0]['changed_by']);
+    }
+
+    public function testSubmittingTheValueAlreadyInForceChangesNothing(): void
+    {
+        // Otherwise the first time someone saved a tab it would quietly pin every default as an "override",
+        // and a later change to a default in the code would stop reaching the site.
+        $current = $this->item('site', 'site.heroHeadline')['current'];
+
+        $result = $this->manager->save('site', ['site_heroHeadline' => $current], [], null);
+
+        $this->assertSame(0, $result['changed']);
+        $this->assertSame(0, $this->overrideCount());
+        $this->assertSame(0, $this->auditCount());
+    }
+
+    public function testAFieldNotOnTheSubmittedFormIsLeftAlone(): void
+    {
+        $this->manager->save('site', ['site_announcement' => 'Hello'], [], null);
+
+        $this->manager->save('site', ['site_heroHeadline' => 'Changed'], [], null);
+
+        $this->assertSame('Hello', (new SettingModel())->allKeyed()['site.announcement'], 'Saving one field must not disturb another.');
+    }
+
+    public function testInputIsTidiedBeforeItIsStored(): void
+    {
+        $this->manager->save('general', ['general_defaultCurrency' => ' usd '], [], null);
+        $this->manager->save('bookings', ['moderation_flagTerms' => "scam, lottery\nscam\n  free money \n"], [], null);
+
+        $stored = (new SettingModel())->allKeyed();
+
+        $this->assertSame('USD', $stored['general.defaultCurrency']);
+        $this->assertSame("scam\nlottery\nfree money", $stored['moderation.flagTerms']);
+    }
+
+    public function testASwitchCanBeTurnedTheOtherWay(): void
+    {
+        $base = $this->item('notifications', 'notifications.emailEnabled')['base'];
+
+        $this->manager->save('notifications', ['notifications_emailEnabled' => $base ? '0' : '1'], [], null);
+
+        $this->reloadConfig();
+
+        $this->assertSame(! $base, config('Notifications')->channelsEnabled['email']);
+    }
+
+    public function testASettingInsideAnArrayReachesTheRightPlace(): void
+    {
+        $this->manager->save('templates', ['notifications_template_moderation_approved_sms' => 'Hi {sender_name}, ref {reference}: approved.'], [], null);
+
+        $this->reloadConfig();
+
+        $templates = config('Notifications')->templates;
+
+        $this->assertSame('Hi {sender_name}, ref {reference}: approved.', $templates['moderation_approved']['sms']);
+        $this->assertNotSame('Hi {sender_name}, ref {reference}: approved.', $templates['aired']['sms'], 'The other templates are untouched.');
+    }
+
+    public function testSavingATabThatDoesNotExistDoesNothing(): void
+    {
+        $this->assertSame(['success' => true, 'errors' => [], 'changed' => 0], $this->manager->save('no-such-tab', ['x' => 'y'], [], null));
+    }
+
+    // ------------------------------------------------------------------ resetting
+
+    public function testResettingRemovesTheOverrideAndAuditsIt(): void
+    {
+        $this->manager->save('site', ['site_heroHeadline' => 'Greetings that travel.'], [], StaffUser::id());
+        $base = $this->item('site', 'site.heroHeadline')['base'];
+
+        $result = $this->manager->save('site', [], ['site_heroHeadline' => '1'], StaffUser::id());
+
+        $this->assertSame(1, $result['changed']);
+        $this->assertSame(0, $this->overrideCount());
+
+        $latest = (new SettingChangeModel())->recent(1)[0];
+        $this->assertSame(['reset', 'Greetings that travel.', $base], [$latest['action'], $latest['old_value'], $latest['new_value']]);
+    }
+
+    public function testResettingSomethingNeverChangedIsIgnored(): void
+    {
+        $result = $this->manager->save('site', [], ['site_heroHeadline' => '1'], null);
+
+        $this->assertSame(0, $result['changed']);
+        $this->assertSame(0, $this->auditCount());
+    }
+
+    public function testAResetBeatsAValueSubmittedForTheSameField(): void
+    {
+        $this->manager->save('site', ['site_announcement' => 'Old'], [], null);
+
+        $this->manager->save('site', ['site_announcement' => 'Typed but also reset'], ['site_announcement' => '1'], null);
+
+        $this->assertArrayNotHasKey('site.announcement', (new SettingModel())->allKeyed());
+    }
+
+    public function testAfterAResetTheCodedValueIsBackInForce(): void
+    {
+        $base = $this->item('site', 'site.heroHeadline')['base'];
+
+        $this->manager->save('site', ['site_heroHeadline' => 'Temporary'], [], null);
+        $this->manager->save('site', [], ['site_heroHeadline' => '1'], null);
+        $this->resetFactories();
+
+        $this->assertSame($base, config('CbsRadio')->heroHeadline);
+    }
+
+    // ------------------------------------------------------------------ refusing
+
+    public function testABadValueIsRefusedWithTheSettingsNameInTheMessage(): void
+    {
+        $result = $this->manager->save('site', ['site_liveStreamUrl' => 'javascript:alert(1)'], [], null);
+
+        $this->assertFalse($result['success']);
+        $this->assertSame(['Live stream address: must be a web address starting with http:// or https://.'], $result['errors']);
+        $this->assertSame(0, $result['changed']);
+    }
+
+    public function testNothingIsSavedIfAnythingOnTheFormIsRefused(): void
+    {
+        $result = $this->manager->save('site', [
+            'site_heroHeadline'  => 'A perfectly good headline',
+            'site_liveStreamUrl' => 'not a url',
+        ], [], StaffUser::id());
+
+        $this->assertFalse($result['success']);
+        $this->assertSame(0, $this->overrideCount(), 'The good field must not be saved while the bad one is refused.');
+        $this->assertSame(0, $this->auditCount());
+    }
+
+    public function testEveryProblemIsReportedAtOnce(): void
+    {
+        $result = $this->manager->save('site', ['site_heroHeadline' => '', 'site_liveStreamUrl' => 'nope', 'site_announcement' => str_repeat('x', 161)], [], null);
+
+        $this->assertCount(3, $result['errors']);
+    }
+
+    public function testARequiredSettingCannotBeEmptied(): void
+    {
+        $result = $this->manager->save('site', ['site_heroHeadline' => ''], [], null);
+
+        $this->assertSame(['Homepage headline: cannot be empty. Use "Reset to default" instead.'], $result['errors']);
+    }
+
+    public function testAnOptionalSettingCanBeEmptiedToSwitchItOff(): void
+    {
+        $this->manager->save('site', ['site_announcement' => 'Closed Friday'], [], null);
+
+        $result = $this->manager->save('site', ['site_announcement' => ''], [], null);
+
+        $this->assertTrue($result['success']);
+        $this->assertSame(['site.announcement' => ''], (new SettingModel())->allKeyed(), 'Emptied, and still overriding the default.');
+    }
+
+    // ------------------------------------------------------------------ settings that depend on each other
+
+    public function testTheLongestVoiceNoteMustBeLongerThanTheShortest(): void
+    {
+        $result = $this->manager->save('bookings', ['uploads_voiceNoteMinSeconds' => '40', 'uploads_voiceNoteMaxSeconds' => '30'], [], null);
+
+        $this->assertSame(['Longest voice note: must be longer than the shortest.'], $result['errors']);
+        $this->assertSame(0, $this->overrideCount());
+    }
+
+    public function testTheCheckAlsoAppliesWhenOnlyOneOfTheTwoIsChanged(): void
+    {
+        // The maximum is left at its default of 30; raising only the minimum above it must still be refused.
+        $result = $this->manager->save('bookings', ['uploads_voiceNoteMinSeconds' => '35'], [], null);
+
+        $this->assertFalse($result['success']);
+
+        $this->assertTrue($this->manager->save('bookings', ['uploads_voiceNoteMinSeconds' => '10', 'uploads_voiceNoteMaxSeconds' => '60'], [], null)['success']);
+    }
+
+    public function testAMinimumEqualToTheMaximumIsRefused(): void
+    {
+        $this->assertFalse($this->manager->save('bookings', ['uploads_voiceNoteMinSeconds' => '20', 'uploads_voiceNoteMaxSeconds' => '20'], [], null)['success']);
+    }
+
+    public function testOnlinePaymentsNeedAProviderAndCredentialsBeforeTheyCanBeSwitchedOn(): void
+    {
+        $this->setEnv('momo.apiKey', null);
+        $this->setEnv('momo.apiSecret', null);
+
+        $result = $this->manager->save('payments', ['payments_mode' => 'mobile_money'], [], null);
+
+        $this->assertFalse($result['success']);
+        $this->assertContains('Mobile Money provider: choose one before switching on online payments.', $result['errors']);
+        $this->assertContains('Payment mode: online payments need momo.apiKey and momo.apiSecret in .env first.', $result['errors']);
+    }
+
+    public function testChoosingAProviderIsNotEnoughWithoutCredentials(): void
+    {
+        $this->setEnv('momo.apiKey', 'key');
+        $this->setEnv('momo.apiSecret', null);
+
+        $result = $this->manager->save('payments', ['payments_mode' => 'mobile_money', 'payments_provider' => 'mtn'], [], null);
+
+        $this->assertSame(['Payment mode: online payments need momo.apiKey and momo.apiSecret in .env first.'], $result['errors']);
+    }
+
+    public function testOnlinePaymentsCanBeSwitchedOnOnceEverythingIsInPlace(): void
+    {
+        $this->setEnv('momo.apiKey', 'key');
+        $this->setEnv('momo.apiSecret', 'secret');
+
+        $result = $this->manager->save('payments', ['payments_mode' => 'mobile_money', 'payments_provider' => 'mtn'], [], null);
+
+        $this->assertTrue($result['success'], implode(' ', $result['errors']));
+
+        $this->reloadConfig();
+
+        $this->assertSame('mobile_money', config('Payments')->mode);
+        $this->assertSame('mtn', config('Payments')->provider);
+    }
+
+    public function testGoingBackToManualPaymentsIsAlwaysAllowed(): void
+    {
+        $this->setEnv('momo.apiKey', 'key');
+        $this->setEnv('momo.apiSecret', 'secret');
+        $this->manager->save('payments', ['payments_mode' => 'mobile_money', 'payments_provider' => 'mtn'], [], null);
+
+        $this->setEnv('momo.apiKey', null);
+        $this->setEnv('momo.apiSecret', null);
+
+        $this->assertTrue($this->manager->save('payments', ['payments_mode' => 'manual'], [], null)['success'], 'Falling back must never be blocked by missing credentials.');
+    }
+
+    public function testChangingAnUnrelatedPaymentsFieldIsNotBlockedByTheModeAlreadyInForce(): void
+    {
+        $this->setEnv('momo.apiKey', 'key');
+        $this->setEnv('momo.apiSecret', 'secret');
+        $this->manager->save('payments', ['payments_mode' => 'mobile_money', 'payments_provider' => 'mtn'], [], null);
+
+        $this->setEnv('momo.apiKey', null);
+
+        $this->assertTrue($this->manager->save('payments', ['payments_merchantCode' => '654321'], [], null)['success']);
+    }
+
+    // ------------------------------------------------------------------ the change history
+
+    public function testRecentChangesAreLabelledForTheScreen(): void
+    {
+        $this->manager->save('site', ['site_heroHeadline' => 'One'], [], StaffUser::id());
+        $this->manager->save('bookings', ['content_messageMaxLength' => '300'], [], StaffUser::id());
+
+        $changes = $this->manager->recentChanges(10);
+
+        $this->assertSame(['Maximum message length (characters)', 'Homepage headline'], array_column($changes, 'label'));
+        $this->assertSame(['int', 'string'], array_column($changes, 'type'));
+        $this->assertCount(1, $this->manager->recentChanges(1));
+    }
+
+    // ------------------------------------------------------------------ credentials: reported, never shown
+
+    public function testCredentialsAreReportedAsConfiguredOrNotAndNeverRevealed(): void
+    {
+        $this->setEnv('momo.apiKey', 'super-secret-value');
+        $this->setEnv('momo.apiSecret', null);
+
+        $status = array_column($this->manager->secretStatus('payments'), 'configured', 'env');
+
+        $this->assertTrue($status['momo.apiKey']);
+        $this->assertFalse($status['momo.apiSecret']);
+        $this->assertStringNotContainsString('super-secret-value', json_encode($this->manager->secretStatus('payments')));
+    }
+
+    public function testAnUnknownTabHasNoCredentials(): void
+    {
+        $this->assertSame([], $this->manager->secretStatus('site'));
+    }
+
+    public function testBlankCredentialsCountAsMissing(): void
+    {
+        $this->setEnv('sms.apiKey', '   ');
+
+        $this->assertFalse($this->manager->envConfigured('sms.apiKey'));
+        $this->assertFalse($this->manager->envConfigured('never.set.at.all'));
+    }
+
+    // ------------------------------------------------------------------ the dashboard's configuration row
+
+    public function testHealthSaysManualPaymentsNeedStaffToConfirmEachOne(): void
+    {
+        config('Payments')->mode = 'manual';
+
+        $payments = $this->manager->health()[0];
+
+        $this->assertSame(['Payments', 'info', 'Manual — staff confirm each payment'], [$payments['label'], $payments['status'], $payments['detail']]);
+    }
+
+    public function testHealthWarnsWhenOnlinePaymentsAreOnButNotSetUp(): void
+    {
+        $this->setEnv('momo.apiKey', null);
+        $this->setEnv('momo.apiSecret', null);
+        config('Payments')->mode     = 'mobile_money';
+        config('Payments')->provider = 'mtn';
+
+        $this->assertSame('warn', $this->manager->health()[0]['status']);
+
+        $this->setEnv('momo.apiKey', 'k');
+        $this->setEnv('momo.apiSecret', 's');
+
+        $ok = $this->manager->health()[0];
+        $this->assertSame(['ok', 'Mobile Money (online)'], [$ok['status'], $ok['detail']]);
+
+        config('Payments')->provider = '';
+        $this->assertSame('warn', $this->manager->health()[0]['status'], 'No provider chosen is not ready, whatever the credentials.');
+    }
+
+    public function testHealthReportsTheTextMessageGateway(): void
+    {
+        config('Notifications')->channelsEnabled['sms'] = false;
+        $this->assertSame(['SMS', 'info', 'Off'], array_values(array_intersect_key($this->manager->health()[1], array_flip(['label', 'status', 'detail']))));
+
+        config('Notifications')->channelsEnabled['sms'] = true;
+        $this->setEnv('sms.apiKey', null);
+        $this->assertSame(['warn', 'On, but no gateway key in .env'], [$this->manager->health()[1]['status'], $this->manager->health()[1]['detail']]);
+
+        $this->setEnv('sms.apiKey', 'abc');
+        $this->assertSame(['ok', 'On'], [$this->manager->health()[1]['status'], $this->manager->health()[1]['detail']]);
+    }
+
+    public function testHealthReportsEmail(): void
+    {
+        config('Notifications')->channelsEnabled['email'] = true;
+        $this->setEnv('email.SMTPHost', null);
+        $this->assertSame(['warn', 'On, but no SMTP host in .env'], [$this->manager->health()[2]['status'], $this->manager->health()[2]['detail']]);
+
+        $this->setEnv('email.SMTPHost', 'smtp.example.test');
+        $this->assertSame('ok', $this->manager->health()[2]['status']);
+
+        config('Notifications')->channelsEnabled['email'] = false;
+        $this->assertSame('info', $this->manager->health()[2]['status']);
+    }
+
+    // ------------------------------------------------------------------ the cache
+
+    public function testOverridesAreCachedUntilFlushed(): void
+    {
+        $this->assertSame([], SettingsManager::overrides());
+
+        (new SettingModel())->setOverride('site.announcement', 'Hello', null);
+
+        $this->assertSame([], SettingsManager::overrides(), 'Still the cached answer.');
+
+        SettingsManager::flush();
+
+        $this->assertSame(['site.announcement' => 'Hello'], SettingsManager::overrides());
+    }
+
+    // ------------------------------------------------------------------ reaching the configuration
+
+    public function testSuspendingOverridesGivesTheCodedDefaults(): void
+    {
+        $this->setSetting('site.heroHeadline', 'Greetings that travel.');
+
+        Overrides::$suspended = true;
+
+        try {
+            $this->assertNotSame('Greetings that travel.', (new CbsRadio())->heroHeadline);
+        } finally {
+            Overrides::$suspended = false;
+        }
+
+        $this->assertSame('Greetings that travel.', (new CbsRadio())->heroHeadline, 'And they apply again as soon as it is switched back.');
+    }
+
+    public function testASettingStoredAsTextArrivesAsTheRightType(): void
+    {
+        $this->setSetting('content.messageMaxLength', '321');
+        $this->setSetting('moderation.flagTerms', "scam\nlottery");
+
+        $this->assertSame(321, config('CbsRadio')->messageMaxLength);
+        $this->assertSame(['scam', 'lottery'], config('CbsRadio')->moderationFlagTerms);
+    }
+}
diff --git a/tests/database/TestEnvironmentTest.php b/tests/database/TestEnvironmentTest.php
new file mode 100644
index 0000000..621c16d
--- /dev/null
+++ b/tests/database/TestEnvironmentTest.php
@@ -0,0 +1,75 @@
+<?php
+
+namespace Tests\Database;
+
+use App\Models\CategoryModel;
+use Config\Database;
+use Tests\Support\TestCase\AppTestCase;
+
+/**
+ * Guards the foundation of the suite. If one of these fails, nothing else in the suite can be trusted, so the
+ * message says what to fix.
+ *
+ * @internal
+ */
+final class TestEnvironmentTest extends AppTestCase
+{
+    public function testTheSuiteRunsAgainstMysqlWithNoTablePrefix(): void
+    {
