+<?php
+
+namespace Tests\Support\Filters;
+
+use CodeIgniter\Filters\FilterInterface;
+use CodeIgniter\HTTP\RequestInterface;
+use CodeIgniter\HTTP\ResponseInterface;
+use Tests\Support\Libraries\StaffUser;
+
+/**
+ * Stands in for the starter kit's real `auth` filter in feature tests, so the suite checks what this project
+ * does behind the login rather than depending on how the login works. It signs the request in as a real user row.
+ *
+ * (That the real filter really blocks the public is the starter kit's own concern, and is not tested here.)
+ */
+class ActAsStaff implements FilterInterface
+{
+    public function before(RequestInterface $request, $arguments = null)
+    {
+        session()->set('user_id', StaffUser::id());
+    }
+
+    public function after(RequestInterface $request, ResponseInterface $response, $arguments = null)
+    {
+    }
+}
diff --git a/tests/_support/Libraries/AudioFixtures.php b/tests/_support/Libraries/AudioFixtures.php
new file mode 100644
index 0000000..f3cff28
--- /dev/null
+++ b/tests/_support/Libraries/AudioFixtures.php
@@ -0,0 +1,111 @@
+<?php
+
+namespace Tests\Support\Libraries;
+
+use CodeIgniter\HTTP\Files\UploadedFile;
+use RuntimeException;
+
+/**
+ * The real audio files in tests/_support/Audio (made by scripts/make-test-audio.sh), handed to the code under test
+ * the way a browser would send them.
+ *
+ * A test never touches a fixture itself: every call copies it to a temporary file first, because a successful
+ * upload is *moved* into writable/ and would otherwise consume the original.
+ */
+final class AudioFixtures
+{
+    /** @var string[] temporary copies not yet moved or deleted */
+    private static array $temporary = [];
+
+    public static function path(string $name): string
+    {
+        $path = SUPPORTPATH . 'Audio/' . $name;
+
+        if (! is_file($path)) {
+            throw new RuntimeException("No audio fixture called {$name}. Run scripts/make-test-audio.sh.");
+        }
+
+        return $path;
+    }
+
+    /**
+     * A temporary copy of a fixture.
+     */
+    public static function copy(string $name): string
+    {
+        $copy = tempnam(sys_get_temp_dir(), 'cbsaudio');
+        copy(self::path($name), $copy);
+
+        return self::$temporary[] = $copy;
+    }
+
+    /**
+     * An uploaded file backed by a fixture. $clientName and $clientType are what the visitor's browser *claims*,
+     * and may differ from the real content, which is the point of several tests (a text file called x.mp3).
+     */
+    public static function upload(string $name, ?string $clientName = null, ?string $clientType = null): UploadedFile
+    {
+        $copy = self::copy($name);
+
+        return new UploadedFile($copy, $clientName ?? $name, $clientType, filesize($copy), UPLOAD_ERR_OK);
+    }
+
+    /**
+     * An upload that PHP itself rejected, such as a file over upload_max_filesize.
+     */
+    public static function failedUpload(int $error): UploadedFile
+    {
+        return new UploadedFile('', 'voice-note.webm', 'audio/webm', 0, $error);
+    }
+
+    /**
+     * Puts a fixture into $_FILES, so a request made in the same test carries it as a multipart upload.
+     */
+    public static function attachToRequest(string $field, string $name, ?string $clientName = null, ?string $clientType = null): void
+    {
+        $copy = self::copy($name);
+
+        $files = service('superglobals')->getFilesArray();
+
+        $files[$field] = [
+            'name'     => $clientName ?? $name,
+            'type'     => $clientType ?? '',
+            'tmp_name' => $copy,
+            'error'    => UPLOAD_ERR_OK,
+            'size'     => filesize($copy),
+        ];
+
+        // CodeIgniter reads uploads through its superglobals service, not the raw $_FILES.
+        service('superglobals')->setFilesArray($files);
+        $_FILES = $files;
+    }
+
+    /**
+     * Puts something that is not a normal upload into the request: PHP itself having refused the file, say.
+     */
+    public static function attachRawToRequest(string $field, array $entry): void
+    {
+        $files          = service('superglobals')->getFilesArray();
+        $files[$field]  = $entry;
+
+        service('superglobals')->setFilesArray($files);
+        $_FILES = $files;
+    }
+
+    /**
+     * Removes what a test left behind and empties $_FILES.
+     */
+    public static function cleanUp(): void
+    {
+        foreach (self::$temporary as $file) {
+            if (is_file($file)) {
+                unlink($file);
+            }
+        }
+
+        self::$temporary = [];
+        $_FILES          = [];
+
+        service('superglobals')->setFilesArray([]);
+    }
+}
diff --git a/tests/_support/Libraries/FakeHttpGateway.php b/tests/_support/Libraries/FakeHttpGateway.php
new file mode 100644
index 0000000..271536a
--- /dev/null
+++ b/tests/_support/Libraries/FakeHttpGateway.php
@@ -0,0 +1,69 @@
+<?php
+
+namespace Tests\Support\Libraries;
+
+use CodeIgniter\HTTP\Response;
+use CodeIgniter\HTTP\ResponseInterface;
+use CodeIgniter\HTTP\URI;
+use CodeIgniter\Test\Mock\MockCURLRequest;
+use Config\App;
+use Config\Services;
+use RuntimeException;
+
+/**
+ * Stands in for the HTTP client the application uses to talk to outside services (Services::curlrequest(): the
+ * SMS gateway, gift vendors). Records every request and answers with a chosen status and body, or fails the way
+ * a network error would. Nothing ever leaves the machine.
+ *
+ *     $http = FakeHttpGateway::install();                              // answers 200 with {}
+ *     $http = FakeHttpGateway::install(500);                           // the other side refuses
+ *     $http = FakeHttpGateway::install(body: '{"order_id": 77}');      // a particular answer
+ *     $http = FakeHttpGateway::install(failWith: 'Connection refused'); // cannot connect
+ */
+class FakeHttpGateway extends MockCURLRequest
+{
+    /** @var array<int, array{method: string, url: string, options: array<string, mixed>}> */
+    public array $calls = [];
+
+    // Named so that they cannot collide with properties of the framework's own HTTP classes (which has $body).
+    public int $answerStatus  = 200;
+    public string $answerBody = '{}';
+    public ?string $failWith  = null;
+
+    public static function install(int $status = 200, string $body = '{}', ?string $failWith = null): self
+    {
+        $config = config(App::class);
+        $fake   = new self($config, new URI(), new Response($config), []);
+
+        $fake->answerStatus = $status;
+        $fake->answerBody   = $body;
+        $fake->failWith     = $failWith;
+
+        Services::injectMock('curlrequest', $fake);
+
+        return $fake;
+    }
+
+    public function request($method, string $url, array $options = []): ResponseInterface
+    {
+        $this->calls[] = ['method' => strtoupper((string) $method), 'url' => $url, 'options' => $options];
+
+        if ($this->failWith !== null) {
+            throw new RuntimeException($this->failWith);
+        }
+
+        return (new Response(config(App::class)))->setStatusCode($this->answerStatus)->setBody($this->answerBody);
+    }
+
+    /**
+     * The form fields or JSON body of the most recent request.
+     *
+     * @return array<string, mixed>
+     */
+    public function lastPayload(): array
+    {
+        $options = $this->calls[array_key_last($this->calls)]['options'] ?? [];
+
+        return $options['form_params'] ?? $options['json'] ?? [];
+    }
+}
