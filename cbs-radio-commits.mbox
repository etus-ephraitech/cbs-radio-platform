+
+    /**
+     * @return array<string, array{0: string}>
+     */
+    public static function badgeFunctions(): array
+    {
+        return [
+            'booking'      => ['cbs_booking_status_badge'],
+            'payment'      => ['cbs_payment_status_badge'],
