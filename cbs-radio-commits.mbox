+<?= $this->section('scripts') ?>
+<?php if ($cbs->liveStreamUrl !== ''): ?>
+<script>
+(function () {
+    var button = document.getElementById('listenBtn'), audio = document.getElementById('liveAudio'),
+        label = document.getElementById('listenLabel'), note = document.getElementById('listenMsg');
+    if (!button || !audio) { return; }
+
+    function reset() { button.setAttribute('aria-pressed', 'false'); label.textContent = 'Listen live'; }
+    function fail() {
+        reset();
+        note.textContent = "We couldn't connect to the stream just now. Please try again in a moment.";
+    }
+
+    button.addEventListener('click', function () {
+        note.textContent = '';
+        if (audio.paused) {
+            audio.src = audio.getAttribute('data-src');
+            var started = audio.play();
+            if (started && started.catch) { started.catch(fail); }
+        } else {
+            audio.pause();
+            audio.removeAttribute('src');   // stop downloading the stream, not just mute it
+            audio.load();
+            reset();
+        }
+    });
+    audio.addEventListener('playing', function () { button.setAttribute('aria-pressed', 'true'); label.textContent = 'Stop listening'; });
+    audio.addEventListener('error', fail);
+})();
+</script>
+<?php endif; ?>
+<?= $this->endSection() ?>
