+#!/bin/sh
+#
+# Pre-commit hook: runs PSR-12 style check on staged PHP files only.
+# Blocks the commit if style check fails.
+#
+# One-time setup per clone (run from repo root):
+#   git config core.hooksPath scripts/git-hooks
+#   chmod +x scripts/git-hooks/pre-commit
+#
+# To skip in an emergency (not recommended): git commit --no-verify
+
+STAGED_PHP_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$')
+
+if [ -z "$STAGED_PHP_FILES" ]; then
+    exit 0
+fi
+
+echo "Running style check (rules in phpcs.xml) on staged files..."
+
+./vendor/bin/phpcs $STAGED_PHP_FILES
+
+if [ $? -ne 0 ]; then
+    echo ""
+    echo "Style check failed. Run 'composer cs-fix' to auto-fix, then re-stage and commit."
+    exit 1
+fi
+
+echo "Style check passed."
+exit 0
