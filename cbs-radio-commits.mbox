diff --git a/app/Libraries/VendorGiftClients/GenericRestVendorClient.php b/app/Libraries/VendorGiftClients/GenericRestVendorClient.php
new file mode 100644
index 0000000..99be2f3
--- /dev/null
+++ b/app/Libraries/VendorGiftClients/GenericRestVendorClient.php
@@ -0,0 +1,110 @@
+<?php
+
+namespace App\Libraries\VendorGiftClients;
+
+use Config\Services as CoreServices;
+
+/**
+ * A reasonable-default REST client for a vendor exposing a simple
+ * "list products" / "create order" API. This is the gift-catalog
+ * equivalent of PaymentService::chargeMobileMoney() and
+ * NotificationService::sendSms() — a real, working shape, but the exact
+ * endpoint paths and JSON field names below are assumed, not confirmed
+ * against any specific vendor's actual documentation.
+ *
+ * OPEN ITEM: once CBS/Ephraitech has a confirmed vendor, verify:
+ *   - the catalog endpoint path and its response field names (assumed:
+ *     GET {base}/products -> {"data": [{"id","name","description","price","currency","category"}]})
+ *   - the order endpoint path and its response field names (assumed:
+ *     POST {base}/orders -> {"order_id": "..."})
+ *   - the authentication method (assumed: Bearer token from
+ *     vendor.{slug}.apiKey)
+ * If the real vendor's API differs meaningfully, write a new class
+ * implementing VendorGiftClientInterface rather than bending this one.
+ */
+class GenericRestVendorClient implements VendorGiftClientInterface
+{
+    protected array $vendor;
+
+    public function __construct(array $vendor)
+    {
+        $this->vendor = $vendor;
+    }
+
+    public function fetchCatalog(): array
+    {
+        $apiKey = env('vendor.' . $this->vendor['slug'] . '.apiKey');
+
+        if (empty($this->vendor['api_base_url']) || empty($apiKey)) {
+            return [];
+        }
+
+        try {
+            $client   = CoreServices::curlrequest();
+            $response = $client->get(rtrim($this->vendor['api_base_url'], '/') . '/products', [
+                'headers' => ['Authorization' => 'Bearer ' . $apiKey, 'Accept' => 'application/json'],
+            ]);
+
+            $body = json_decode($response->getBody(), true);
+            $rows = $body['data'] ?? [];
+        } catch (\Throwable $e) {
+            return [];
+        }
+
+        $normalized = [];
+
+        foreach ($rows as $row) {
+            if (empty($row['id']) || empty($row['name']) || ! isset($row['price'])) {
+                continue;
+            }
+
+            $normalized[] = [
+                'vendor_product_ref' => (string) $row['id'],
+                'name'               => $row['name'],
+                'description'        => $row['description'] ?? null,
+                'price'              => (float) $row['price'],
+                'currency'           => $row['currency'] ?? 'UGX',
+                // Defaults to 'physical' since the original partner-gift
+                // use case (flowers/cakes/hampers) is the most likely
+                // reason to integrate a vendor catalog at all — override
+                // per-row if the vendor reports its own category.
+                'type' => $row['category'] ?? 'physical',
+            ];
+        }
+
+        return $normalized;
+    }
+
+    public function submitOrder(array $orderData): array
+    {
+        $apiKey = env('vendor.' . $this->vendor['slug'] . '.apiKey');
+
+        if (empty($this->vendor['api_base_url']) || empty($apiKey)) {
+            return ['success' => false, 'vendor_order_ref' => null, 'message' => 'Vendor is not configured.'];
+        }
+
+        try {
+            $client   = CoreServices::curlrequest();
+            $response = $client->post(rtrim($this->vendor['api_base_url'], '/') . '/orders', [
+                'headers' => ['Authorization' => 'Bearer ' . $apiKey, 'Content-Type' => 'application/json'],
+                'json'    => [
+                    'product_id'        => $orderData['vendor_product_ref'],
+                    'quantity'          => $orderData['quantity'],
+                    'recipient_name'    => $orderData['recipient_name'],
+                    'recipient_phone'   => $orderData['recipient_phone'],
+                    'delivery_details'  => $orderData['delivery_details'],
+                ],
+            ]);
+
+            $body = json_decode($response->getBody(), true);
+
+            if ($response->getStatusCode() >= 200 && $response->getStatusCode() < 300 && ! empty($body['order_id'])) {
+                return ['success' => true, 'vendor_order_ref' => (string) $body['order_id'], 'message' => 'Order placed with vendor.'];
+            }
+
+            return ['success' => false, 'vendor_order_ref' => null, 'message' => 'Vendor declined the order.'];
+        } catch (\Throwable $e) {
+            return ['success' => false, 'vendor_order_ref' => null, 'message' => 'Could not reach vendor: ' . $e->getMessage()];
+        }
+    }
+}
diff --git a/app/Libraries/VendorGiftClients/VendorGiftClientInterface.php b/app/Libraries/VendorGiftClients/VendorGiftClientInterface.php
new file mode 100644
index 0000000..ad76d93
--- /dev/null
+++ b/app/Libraries/VendorGiftClients/VendorGiftClientInterface.php
@@ -0,0 +1,44 @@
+<?php
+
+namespace App\Libraries\VendorGiftClients;
+
+/**
+ * Contract every vendor gift integration must implement. One vendor whose
+ * API shape differs meaningfully from the generic REST assumption in
+ * GenericRestVendorClient gets its own class implementing this interface
+ * — GiftVendorSyncService and GiftOrderService depend on this interface,
+ * never a concrete client, so adding a second vendor never means
+ * touching either of those.
+ */
+interface VendorGiftClientInterface
+{
+    /**
+     * Fetches the vendor's current product catalog, normalized to this
+     * shape regardless of the vendor's own field names.
+     *
+     * @return array<int, array{
+     *     vendor_product_ref: string,
+     *     name: string,
+     *     description: ?string,
+     *     price: float,
+     *     currency: string,
+     *     type: string
+     * }>
+     */
+    public function fetchCatalog(): array;
+
+    /**
+     * Places an order with the vendor once a gift order on our side has
+     * been paid.
+     *
+     * @param array{
+     *     vendor_product_ref: string,
+     *     quantity: int,
+     *     recipient_name: string,
+     *     recipient_phone: ?string,
+     *     delivery_details: ?string
+     * } $orderData
+     * @return array{success: bool, vendor_order_ref: ?string, message: string}
+     */
+    public function submitOrder(array $orderData): array;
+}
diff --git a/app/Models/GiftVendorModel.php b/app/Models/GiftVendorModel.php
new file mode 100644
index 0000000..7fbbd5b
--- /dev/null
+++ b/app/Models/GiftVendorModel.php
@@ -0,0 +1,49 @@
+<?php
+
+namespace App\Models;
+
+use App\Models\Traits\GeneratesUniqueSlugs;
+use CodeIgniter\Model;
+
+/**
+ * A third-party vendor whose gift catalog is pulled in via API and shown
+ * alongside our own local digital gifts (see gifts.source). The vendor's
+ * actual API key is never stored here — it lives in .env as
+ * vendor.{slug}.apiKey, looked up by GenericRestVendorClient using the
+ * slug from this table.
+ */
+class GiftVendorModel extends Model
+{
+    use GeneratesUniqueSlugs;
+
+    protected $table            = 'gift_vendors';
+    protected $primaryKey       = 'id';
+    protected $useAutoIncrement = true;
+    protected $returnType       = 'array';
+    protected $useSoftDeletes   = false;
+
+    protected $allowedFields = [
+        'name',
+        'slug',
+        'api_base_url',
+        'is_active',
+    ];
+
+    protected $useTimestamps = true;
+    protected $createdField  = 'created_at';
+    protected $updatedField  = 'updated_at';
+
+    protected $validationRules = [
+        'name'         => 'required|max_length[150]',
+        'slug'         => 'required|max_length[100]|is_unique[gift_vendors.slug,id,{id}]',
+        'api_base_url' => 'permit_empty|valid_url',
+        'is_active'    => 'permit_empty|in_list[0,1]',
+    ];
+    protected $validationMessages = [];
+    protected $skipValidation     = false;
+
+    public function active(): array
+    {
+        return $this->where('is_active', 1)->orderBy('name', 'ASC')->findAll();
+    }
+}
diff --git a/app/Services/GiftVendorSyncService.php b/app/Services/GiftVendorSyncService.php
new file mode 100644
index 0000000..16a4ff6
--- /dev/null
+++ b/app/Services/GiftVendorSyncService.php
@@ -0,0 +1,86 @@
+<?php
+
+namespace App\Services;
+
+use App\Libraries\VendorGiftClients\GenericRestVendorClient;
+use App\Models\GiftModel;
+use App\Models\GiftVendorModel;
+
+/**
+ * Pulls every active vendor's catalog into the gifts table, so they show
+ * up in the public catalog alongside local gifts. Run via the
+ * `php spark gifts:sync` command (schedule it with cron) — never on a
+ * user-facing request, since a vendor API can be slow or down.
+ */
+class GiftVendorSyncService
+{
+    protected GiftVendorModel $giftVendorModel;
+    protected GiftModel $giftModel;
+
+    public function __construct(?GiftVendorModel $giftVendorModel = null, ?GiftModel $giftModel = null)
+    {
+        $this->giftVendorModel = $giftVendorModel ?? new GiftVendorModel();
+        $this->giftModel       = $giftModel ?? new GiftModel();
+    }
+
+    /**
+     * @return array{synced: int, errors: string[]}
+     */
+    public function syncAll(): array
+    {
+        $vendors = $this->giftVendorModel->active();
+        $synced  = 0;
+        $errors  = [];
+
+        foreach ($vendors as $vendor) {
+            try {
+                $synced += $this->syncVendor($vendor);
+            } catch (\Throwable $e) {
+                $errors[] = $vendor['name'] . ': ' . $e->getMessage();
+            }
+        }
+
+        return ['synced' => $synced, 'errors' => $errors];
+    }
+
+    protected function syncVendor(array $vendor): int
+    {
+        // Every vendor currently uses the generic REST client. If a
+        // vendor's API needs its own implementation, branch on
+        // $vendor['slug'] here to pick a different
+        // VendorGiftClientInterface implementation.
+        $client  = new GenericRestVendorClient($vendor);
+        $catalog = $client->fetchCatalog();
+        $count   = 0;
+
+        foreach ($catalog as $item) {
+            $existing = $this->giftModel->findByVendorProduct((int) $vendor['id'], $item['vendor_product_ref']);
+
+            $data = [
+                'name'               => $item['name'],
+                'type'               => $item['type'],
+                'description'        => $item['description'],
+                'price'              => $item['price'],
+                'currency'           => $item['currency'],
+                'source'             => GiftModel::SOURCE_VENDOR,
+                'vendor_id'          => $vendor['id'],
+                'vendor_product_ref' => $item['vendor_product_ref'],
+                'synced_at'          => date('Y-m-d H:i:s'),
+            ];
+
+            if ($existing !== null) {
+                // Deliberately does NOT touch is_active — an admin may have
+                // hidden this specific vendor item, and a re-sync should
+                // never silently undo that.
+                $this->giftModel->update($existing['id'], $data);
+            } else {
+                $data['is_active'] = 1;
+                $this->giftModel->insert($data);
+            }
+
+            $count++;
+        }
+
+        return $count;
+    }
+}
