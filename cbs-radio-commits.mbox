+<?php
+
+namespace App\Cells;
+
+use CodeIgniter\View\Cells\Cell;
+
+/**
+ * The header block every admin page opens with: optional "back" link,
+ * title, optional subtitle, and optional primary action button. Keeps
+ * every admin screen's top edge identical so the flow between them feels
+ * like one product.
+ *
+ * Every property needs a default — the framework only fills properties
+ * that are initialised (see PropertiesTrait::getPublicProperties()).
+ *
+ *   <?= view_cell('App\Cells\PageHeader::render', [
+ *       'title'       => 'Categories',
+ *       'subtitle'    => 'What listeners can book.',
+ *       'actionUrl'   => site_url('admin/categories/create'),
+ *       'actionLabel' => '+ New category',
+ *   ]) ?>
+ */
+class PageHeader extends Cell
+{
+    public string $title = '';
+    public string $subtitle = '';
+    public string $backUrl = '';
+    public string $backLabel = 'Back';
+    public string $actionUrl = '';
+    public string $actionLabel = '';
+
+    public function render(): string
+    {
+        $html = '<div class="page-header d-flex justify-content-between align-items-start gap-3"><div>';
+
+        if ($this->backUrl !== '') {
+            $html .= '<p class="mb-1"><a href="' . esc($this->backUrl, 'attr') . '" class="text-muted small text-decoration-none">&larr; '
+                . esc($this->backLabel) . '</a></p>';
+        }
+
+        $html .= '<h1 class="h3 mb-1">' . esc($this->title) . '</h1>';
+
+        if ($this->subtitle !== '') {
+            $html .= '<p class="text-muted mb-0 small">' . esc($this->subtitle) . '</p>';
+        }
+
+        $html .= '</div>';
+
+        if ($this->actionUrl !== '') {
+            $html .= '<a href="' . esc($this->actionUrl, 'attr') . '" class="btn btn-cbs-primary btn-sm text-nowrap">'
+                . esc($this->actionLabel) . '</a>';
+        }
+
+        return $html . '</div>';
+    }
+}
diff --git a/app/Controllers/Admin/CategoryController.php b/app/Controllers/Admin/CategoryController.php
new file mode 100644
index 0000000..def4c12
--- /dev/null
+++ b/app/Controllers/Admin/CategoryController.php
@@ -0,0 +1,137 @@
+<?php
+
+namespace App\Controllers\Admin;
+
+use App\Models\CategoryModel;
+
+/**
+ * Admin CRUD for booking categories (Birthdays, Tributes, Milestones,
+ * etc.). Slugs are generated automatically from the name — never entered
+ * by hand — so the public booking URLs (/booking/{slug}) stay predictable.
+ */
+class CategoryController extends BaseAdminController
+{
+    protected CategoryModel $categoryModel;
+
+    public function __construct()
+    {
+        $this->categoryModel = new CategoryModel();
+    }
+
+    public function index()
+    {
+        return view('admin/categories/index', [
+            'categories' => $this->categoryModel->orderBy('name', 'ASC')->findAll(),
+        ]);
+    }
+
+    public function create()
+    {
+        return view('admin/categories/form', [
+            'category' => null,
+        ]);
+    }
+
+    public function store()
+    {
+        $rules = [
+            'name'        => 'required|max_length[100]',
+            'description' => 'permit_empty',
+        ];
+
+        if (! $this->validate($rules)) {
+            return redirect()->back()->withInput()->with('errors', $this->validator->getErrors());
+        }
+
+        $name = $this->request->getPost('name');
+
+        $id = $this->categoryModel->insert([
+            'name'        => $name,
+            'slug'        => $this->categoryModel->generateUniqueSlug($name),
+            'description' => $this->request->getPost('description'),
+            'is_active'   => $this->request->getPost('is_active') ? 1 : 0,
+        ]);
+
+        if ($id === false) {
+            return redirect()->back()->withInput()->with('errors', $this->categoryModel->errors());
+        }
+
+        return redirect()->to(site_url('admin/categories'))->with('toastr_success', 'Category created.');
+    }
+
+    public function edit(int $id)
+    {
+        $category = $this->categoryModel->find($id);
+
+        if ($category === null) {
+            return redirect()->to(site_url('admin/categories'))->with('toastr_error', 'Category not found.');
+        }
+
+        return view('admin/categories/form', ['category' => $category]);
+    }
+
+    public function update(int $id)
+    {
+        $category = $this->categoryModel->find($id);
+
+        if ($category === null) {
+            return redirect()->to(site_url('admin/categories'))->with('toastr_error', 'Category not found.');
+        }
+
+        $rules = [
+            'name'        => 'required|max_length[100]',
+            'description' => 'permit_empty',
+        ];
+
+        if (! $this->validate($rules)) {
+            return redirect()->back()->withInput()->with('errors', $this->validator->getErrors());
+        }
+
+        $name = $this->request->getPost('name');
+
+        // Only regenerate the slug if the name actually changed, so
+        // existing public links to this category don't silently break
+        // every time an admin tweaks the description.
+        $slug = $name === $category['name']
+            ? $category['slug']
+            : $this->categoryModel->generateUniqueSlug($name, $id);
+
+        $ok = $this->categoryModel->update($id, [
+            'name'        => $name,
+            'slug'        => $slug,
+            'description' => $this->request->getPost('description'),
+            'is_active'   => $this->request->getPost('is_active') ? 1 : 0,
+        ]);
+
+        if (! $ok) {
+            return redirect()->back()->withInput()->with('errors', $this->categoryModel->errors());
+        }
+
+        return redirect()->to(site_url('admin/categories'))->with('toastr_success', 'Category updated.');
+    }
+
+    /**
+     * Categories are deactivated, not deleted — existing bookings and
+     * rate tiers reference category_id, and a hard delete would orphan
+     * that history. "Delete" in the UI performs this.
+     */
+    public function deactivate(int $id)
+    {
+        $ok = $this->categoryModel->update($id, ['is_active' => 0]);
+
+        return redirect()->back()->with(
+            $ok ? 'toastr_success' : 'toastr_error',
+            $ok ? 'Category deactivated.' : 'Could not deactivate this category.'
+        );
+    }
+
+    public function activate(int $id)
+    {
+        $ok = $this->categoryModel->update($id, ['is_active' => 1]);
+
+        return redirect()->back()->with(
+            $ok ? 'toastr_success' : 'toastr_error',
+            $ok ? 'Category activated.' : 'Could not activate this category.'
+        );
+    }
+}
