+                window.setTimeout(function () { done(null); }, 9000);
+            });
+        }
+
+        function rejectPicked(text) {
+            try { el.input.value = ''; } catch (e) { /* older browsers */ }
+            fail(text);
+        }
+
+        function onPick() {
+            var file = el.input.files && el.input.files[0];
+            if (!file) { return; } // the picker was cancelled
