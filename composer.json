{
  "name": "ephraitech/cbs-radio-platform",
  "description": "Digital congratulatory & tribute platform for CBS Radio — web booking flow for on-air greetings, tributes, and milestone announcements, digital gifts, a presenter portal, and an admin panel. Built by Ephraitech Unified Solutions on the CodeIgniter 4 API starter kit.",
  "type": "project",
  "license": "proprietary",
  "homepage": "https://ephraitech.com",
  "keywords": [
    "codeigniter4",
    "cbs-radio",
    "booking",
    "broadcast",
    "ephraitech"
  ],
  "authors": [
    {
      "name": "sNOW",
      "role": "Lead Developer",
      "homepage": "https://ephraitech.com"
    }
  ],
  "support": {
    "issues": "https://github.com/ephraitech/cbs-radio-platform/issues",
    "source": "https://github.com/ephraitech/cbs-radio-platform"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "codeigniter4/framework": "^4.7"
  },
  "require-dev": {
    "fakerphp/faker": "^1.9",
    "mikey179/vfsstream": "^1.6",
    "phpunit/phpunit": "^10.5.16",
    "squizlabs/php_codesniffer": "^3.9",
    "phpstan/phpstan": "^1.11"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Config\\": "app/Config/"
    },
    "exclude-from-classmap": [
      "**/Database/Migrations/**"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\Support\\": "tests/_support"
    }
  },
   "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "scripts": {
    "post-update-cmd": [
      "CodeIgniter\\Config\\Publisher::publishConfig"
    ],
    "cs-check": "phpcs --standard=PSR12 app/",
    "cs-fix": "phpcbf --standard=PSR12 app/",
    "analyse": "phpstan analyse app/ --level=5",
    "test": "phpunit"
  }
}