{
  "name": "ephraitech/cbs-radio-platform",
  "description": "Digital congratulatory & tribute platform for CBS Radio — web booking flow for on-air greetings, tributes, and milestone announcements, digital gifts, a presenter portal, and an admin panel. Built by Ephraitech Unified Solutions on the CodeIgniter 4 API starter kit.",
  "type": "project",
  "license": "proprietary",
  "homepage": "https://ephraitech.com",
  "keywords": [
    "codeigniter4",
    "cbs-radio",
    "booking",
    "broadcast",
    "ephraitech"
  ],
  "authors": [
    {
      "name": "sNOW",
      "role": "Lead Developer",
      "homepage": "https://ephraitech.com"
    }
  ],
  "support": {
    "issues": "https://github.com/ephraitech/cbs-radio-platform/issues",
    "source": "https://github.com/ephraitech/cbs-radio-platform"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": "^8.1",
    "codeigniter4/framework": "^4.5",
    "ephraitech/ci4-error-logger": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.9",
    "phpstan/phpstan": "^2.0",
    "fakerphp/faker": "^1.23"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "exclude-from-classmap": [
      "**/Database/Migrations/**"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\Support\\": "tests/_support"
    }
  },
  "scripts": {
    "post-update-cmd": [
      "CodeIgniter\\Config\\Publisher::publishConfig"
    ],
    "cs-check": "phpcs",
    "cs-fix": "phpcbf",
    "analyse": "phpstan analyse -c phpstan.neon --memory-limit=1G",
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:database": "phpunit --testsuite database",
    "test:feature": "phpunit --testsuite feature"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true
    }
  }
}
