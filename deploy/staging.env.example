#--------------------------------------------------------------------
# CBS Radio platform — .env for the STAGING copy on cPanel
#
# Copy to the repository root as .env (never commit it) and fill in the
# blanks marked <...>. Staging is safe by default: payments are manual,
# SMS and email are off, and every page says STAGING.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

# The staging subdomain, with https and a trailing slash.
app.baseURL = 'https://<staging.yourdomain.ug>/'
# Apache's mod_rewrite (public/.htaccess) removes index.php from addresses.
app.indexPage = ''
app.forceGlobalSecureRequests = true
app.appTimezone = 'Africa/Kampala'
cookie.secure = true

# Shows a striped STAGING bar on every page and keeps search engines away.
app.environmentLabel = 'Staging'

# The new UI (admin theme, visitor flow, homepage).
ui_version = v1

#--------------------------------------------------------------------
# DATABASE — create it in cPanel > MySQL Databases. cPanel prefixes the
# database and user names with your account name, e.g. cbsacct_staging.
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = <cpaneluser>_cbs_staging
database.default.username = <cpaneluser>_cbs_stg
database.default.password = '<a long random password>'
database.default.DBDriver = MySQLi
database.default.port = 3306

#--------------------------------------------------------------------
# AUTH
#--------------------------------------------------------------------
auth.accessTokenTTL = 3600
auth.refreshTokenTTL = 2592000

#--------------------------------------------------------------------
# PAYMENTS — manual: staff confirm each payment in Admin > Payments.
# Use a test merchant code, or the real one if testers will not pay.
#--------------------------------------------------------------------
payments.mode = manual
payments.merchantCode = 000000
momo.provider =
momo.baseUrl =
momo.apiKey =
momo.apiSecret =
momo.callbackUrl = 'https://<staging.yourdomain.ug>/payments/callback'
momo.callbackToken =

#--------------------------------------------------------------------
# NOTIFICATIONS — off on staging so testers' bookings never text or
# email real people. Turn one on (with test credentials) to test it, and
# watch Admin > Notifications.
#--------------------------------------------------------------------
notifications.smsEnabled = false
notifications.emailEnabled = false
sms.provider =
sms.apiKey =
sms.username =
sms.senderId = 'CBSRADIO'

email.fromEmail = 'no-reply@<yourdomain.ug>'
email.fromName = 'CBS Radio (staging)'
email.protocol = 'smtp'
email.SMTPHost = 'mail.<yourdomain.ug>'
email.SMTPUser = 'no-reply@<yourdomain.ug>'
email.SMTPPass = '<mailbox password from cPanel > Email Accounts>'
email.SMTPPort = 587
email.SMTPCrypto = 'tls'
email.mailType = 'html'

#--------------------------------------------------------------------
# VOICE NOTES — shared hosting rarely has ffprobe; the site then trusts
# the length the browser reports (as designed). Leave as is.
#--------------------------------------------------------------------
uploads.voiceNoteMinSeconds = 5
uploads.voiceNoteMaxSeconds = 30
uploads.voiceNoteMaxSizeKB = 2048
uploads.verifyWithFfprobe = true
uploads.ffprobePath = ffprobe

#--------------------------------------------------------------------
# CONTACT (shown to visitors when something goes wrong)
#--------------------------------------------------------------------
general.contactPhone =
general.contactEmail =

cbsradio.defaultCurrency = UGX
